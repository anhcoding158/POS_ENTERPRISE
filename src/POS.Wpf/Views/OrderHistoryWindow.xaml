<Window
    x:Class="POS.Wpf.Views.OrderHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Lịch sử đơn hàng"
    Width="1280"
    Height="760"
    MinWidth="1050"
    MinHeight="650"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock
                Text="Lịch sử đơn hàng"
                Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock
                Margin="0,4,0,0"
                Text="Tra cứu giao dịch đã lưu và xem lại hóa đơn bất biến."
                Style="{StaticResource BodyTextStyle}" />
        </StackPanel>

        <Border
            Grid.Row="1"
            Margin="0,16,0,12"
            Padding="14"
            Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="Mã đơn, thu ngân hoặc sản phẩm" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="1" Text="Từ ngày" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="2" Text="Đến ngày" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="3" Text="Trạng thái" Style="{StaticResource CaptionTextStyle}" />
                <TextBlock Grid.Column="4" Text="Phương thức thanh toán" Style="{StaticResource CaptionTextStyle}" />
                <TextBox
                    Grid.Row="1"
                    Margin="0,0,8,0"
                    Padding="10,7"
                    Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    ToolTip="Tìm mã đơn, tên thu ngân, mã hoặc tên sản phẩm">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <DatePicker
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    SelectedDate="{Binding FromDate, Mode=TwoWay}"
                    Language="vi-VN"
                    ToolTip="Từ ngày (dd/MM/yyyy)" />
                <DatePicker
                    Grid.Row="1"
                    Grid.Column="2"
                    Margin="0,0,8,0"
                    SelectedDate="{Binding ToDate, Mode=TwoWay}"
                    Language="vi-VN"
                    ToolTip="Đến ngày (dd/MM/yyyy)" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="3"
                    Margin="0,0,8,0"
                    ItemsSource="{Binding StatusFilters}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}" />
                <ComboBox
                    Grid.Row="1"
                    Grid.Column="4"
                    Margin="0,0,8,0"
                    ItemsSource="{Binding PaymentMethodFilters}"
                    DisplayMemberPath="DisplayName"
                    SelectedItem="{Binding SelectedPaymentMethodFilter, Mode=TwoWay}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="5"
                    Margin="0,0,8,0"
                    Padding="18,7"
                    Command="{Binding SearchCommand}"
                    Content="Tìm kiếm"
                    Style="{StaticResource PrimaryButtonStyle}" />
                <Button
                    Grid.Row="1"
                    Grid.Column="6"
                    Padding="18,7"
                    Command="{Binding ResetFiltersCommand}"
                    Content="Xóa lọc"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.ColumnSpan="7"
                    Margin="0,8,0,0"
                    Text="Ngày được tính theo múi giờ Windows của máy."
                    Style="{StaticResource CaptionTextStyle}" />
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" MinWidth="610" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" MinWidth="430" />
            </Grid.ColumnDefinitions>

            <Border Padding="10" Style="{StaticResource CardStyle}">
                <DataGrid
                    x:Name="OrdersGrid"
                    RowHeight="34"
                    ItemsSource="{Binding Orders}"
                    SelectedItem="{Binding SelectedOrder, Mode=TwoWay}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Thời gian" Binding="{Binding CreatedAtText}" Width="130" />
                        <DataGridTemplateColumn Header="Mã đơn" Width="*" MinWidth="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding OrderCode}" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding OrderCode}" VerticalAlignment="Center" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Thu ngân" Binding="{Binding CashierName}" Width="135" />
                        <DataGridTextColumn Header="Thanh toán" Binding="{Binding PaymentText}" Width="105" />
                        <DataGridTextColumn Header="Trạng thái" Binding="{Binding StatusText}" Width="105" />
                        <DataGridTextColumn Header="Tổng tiền" Binding="{Binding TotalAmountText}" Width="118">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Background="Transparent"
                          Focusable="False" />

            <Border x:Name="DetailsPanel" Grid.Column="2" Padding="14" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Text="{Binding SelectedOrder.OrderCode, TargetNullValue=Chọn một đơn để xem chi tiết}"
                        Style="{StaticResource SectionTitleTextStyle}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding SelectedOrder.OrderCode}" />
                    <Grid Grid.Row="1" Margin="0,8,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedOrder.CashierName, StringFormat=Thu ngân: {0}}"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedOrder.CashierName}" />
                        <TextBlock Grid.Column="2" Text="{Binding SelectedOrder.PaymentText, StringFormat=Thanh toán: {0}}" />
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="3" Margin="0,3,0,0"
                                   Text="{Binding SelectedVietQrReferenceText, StringFormat=Mã tham chiếu VietQR: {0}}"
                                   Visibility="{Binding HasSelectedVietQrReference, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Border Grid.Row="2" Grid.ColumnSpan="3" Margin="0,8,0,0" Padding="10"
                                Background="{StaticResource SurfaceMutedBrush}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Tạm tính" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding SelectedSubtotalText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="Giảm giá" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Column="4" Text="{Binding SelectedDiscountAmountText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="1" Text="Tổng thanh toán" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedOriginalTotalText}" HorizontalAlignment="Right" FontWeight="SemiBold" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="Đã hoàn" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding SelectedRefundedAmountText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Khách đưa" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedCashReceivedText}" HorizontalAlignment="Right" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="Tiền thừa" Foreground="{StaticResource TextSecondaryBrush}" />
                                <TextBlock Grid.Row="2" Grid.Column="4" Text="{Binding SelectedChangeAmountText}" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="3" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Border Padding="8" Background="{StaticResource GoldSoftBrush}"
                                    Visibility="{Binding HasSelectedOrderDiscount, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel><TextBlock Text="Giảm giá toàn đơn" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedOrderDiscountText}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                            <Border Grid.Column="2" Padding="8" Background="{StaticResource SurfaceMutedBrush}"
                                    Visibility="{Binding HasSelectedOrderNotes, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <StackPanel><TextBlock Text="Ghi chú đơn hàng" FontWeight="SemiBold" />
                                    <TextBlock Margin="0,3,0,0" Text="{Binding SelectedOrderNotes}" TextWrapping="Wrap" /></StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                    <Border Grid.Row="2" Margin="0,0,0,8" Padding="8" Background="{StaticResource SurfaceMutedBrush}">
                        <Border.Style>
                            <Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers><DataTrigger Binding="{Binding HasSelectedReturns}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel><TextBlock Text="Lịch sử trả hàng / hoàn tiền" FontWeight="SemiBold" />
                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto">
                                <TextBlock Margin="0,3,0,0" Text="{Binding SelectedReturnsText}" TextWrapping="Wrap" />
                            </ScrollViewer></StackPanel>
                    </Border>
                    <DataGrid
                        x:Name="OrderLinesGrid"
                        Grid.Row="3"
                        ItemsSource="{Binding SelectedOrderLines}"
                        AutoGenerateColumns="False"
                        IsReadOnly="True" RowHeight="42" MinHeight="150">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="*" />
                            <DataGridTextColumn Header="SL" Binding="{Binding Quantity}" Width="45" />
                            <DataGridTextColumn Header="Đơn giá" Binding="{Binding FinalUnitPriceText}" Width="100" />
                            <DataGridTextColumn Header="Thành tiền" Binding="{Binding NetAmountText}" Width="105" />
                            <DataGridTemplateColumn Header="Trả hàng / ghi chú" Width="1.35*">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="Trả hàng / ghi chú"
                                        ToolTip="Hiển thị trả hàng, modifier, ghi chú và giảm dòng nếu đã được lưu." /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Margin="4,2" Text="{Binding LineDetailsText, Mode=OneWay}"
                                                   TextWrapping="Wrap" ToolTip="{Binding LineDetailsText}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel
                        x:Name="OrderActionsPanel"
                        Grid.Row="4"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <Button
                            Margin="0,0,8,0"
                            Padding="16,9"
                            Command="{Binding OpenReturnCommand}"
                            ToolTip="{Binding ReturnAvailabilityMessage}"
                            Content="Trả hàng / hoàn tiền"
                            Style="{StaticResource SecondaryButtonStyle}" />
                        <Button
                            Padding="16,9"
                            Command="{Binding OpenReceiptCommand}"
                            Content="Xem / in bản sao"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding StatusMessage}" />
                <TextBlock
                    Foreground="{StaticResource DangerBrush}"
                    Text="{Binding ErrorMessage}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,16,0"
                    VerticalAlignment="Center"
                    Text="{Binding TotalCount, Mode=OneWay, StringFormat=Tổng số đơn: {0:N0}}" />
                <Button
                    Margin="0,0,8,0"
                    Command="{Binding PreviousPageCommand}"
                    Content="Trang trước"
                    Style="{StaticResource SecondaryButtonStyle}" />
                <TextBlock
                    Margin="8,0"
                    VerticalAlignment="Center">
                    <Run Text="{Binding CurrentPage, Mode=OneWay}" />
                    <Run Text="/" />
                    <Run Text="{Binding TotalPages, Mode=OneWay}" />
                </TextBlock>
                <Button
                    Margin="8,0,0,0"
                    Command="{Binding NextPageCommand}"
                    Content="Trang sau"
                    Style="{StaticResource SecondaryButtonStyle}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
