<Window x:Class="POS.Wpf.Views.SupplierEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}"
        Width="640"
        Height="760"
        MinWidth="560"
        MinHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="SupplierEditorWindow"
        AutomationProperties.Name="Chỉnh sửa nhà cung cấp">
    <Grid Margin="26,24,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitleTextStyle}" FontSize="25" />
            <TextBlock Text="Cập nhật thông tin liên hệ và pháp lý của nhà cung cấp." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="18">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="Thông tin cơ bản" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <TextBlock Text="Mã nhà cung cấp *" Style="{StaticResource DetailLabelStyle}" />
                    <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.AutomationId="SupplierCodeField" AutomationProperties.Name="Mã nhà cung cấp" Style="{StaticResource SearchTextBoxStyle}" />
                    <TextBlock Text="Tên nhà cung cấp *" Style="{StaticResource DetailLabelStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.AutomationId="SupplierNameField" AutomationProperties.Name="Tên nhà cung cấp" Style="{StaticResource SearchTextBoxStyle}" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Mã số thuế" Style="{StaticResource DetailLabelStyle}" /><TextBox Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.AutomationId="SupplierTaxCodeField" AutomationProperties.Name="Mã số thuế" Style="{StaticResource SearchTextBoxStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Người liên hệ" Style="{StaticResource DetailLabelStyle}" /><TextBox Text="{Binding ContactName, UpdateSourceTrigger=PropertyChanged}" MaxLength="150" AutomationProperties.AutomationId="SupplierContactField" AutomationProperties.Name="Người liên hệ" Style="{StaticResource SearchTextBoxStyle}" /></StackPanel>
                    </Grid>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="Số điện thoại" Style="{StaticResource DetailLabelStyle}" /><TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" MaxLength="30" AutomationProperties.AutomationId="SupplierPhoneField" AutomationProperties.Name="Số điện thoại" Style="{StaticResource SearchTextBoxStyle}" /></StackPanel>
                        <StackPanel Grid.Column="2"><TextBlock Text="Email" Style="{StaticResource DetailLabelStyle}" /><TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" MaxLength="254" AutomationProperties.AutomationId="SupplierEmailField" AutomationProperties.Name="Email" Style="{StaticResource SearchTextBoxStyle}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="Địa chỉ" Style="{StaticResource DetailLabelStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" MaxLength="500" AutomationProperties.AutomationId="SupplierAddressField" AutomationProperties.Name="Địa chỉ" Style="{StaticResource SearchTextBoxStyle}" />
                    <TextBlock Text="Ghi chú" Style="{StaticResource DetailLabelStyle}" Margin="0,14,0,5" />
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" MaxLength="1000" Height="86" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SupplierNotesField" AutomationProperties.Name="Ghi chú" Style="{StaticResource SearchTextBoxStyle}" />
                    <Border Visibility="{Binding HasValidationMessage, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,14,0,0">
                        <TextBlock Text="{Binding ValidationMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" AutomationProperties.AutomationId="SupplierInlineError" AutomationProperties.Name="Lỗi biểu mẫu" />
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" AutomationProperties.AutomationId="SupplierCancelButton" AutomationProperties.Name="Hủy chỉnh sửa" />
                <Button Content="Lưu" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" AutomationProperties.AutomationId="SupplierSaveButton" AutomationProperties.Name="Lưu nhà cung cấp" IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
