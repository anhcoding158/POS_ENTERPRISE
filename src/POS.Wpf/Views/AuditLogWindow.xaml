<Window x:Class="POS.Wpf.Views.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhật ký hoạt động" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="AuditLogWindow">
    <Window.Resources>
        <Style x:Key="AuditLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AuthLabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="AuditValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AuditComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="AuditFilterTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="AuditLoadingVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsLoadingState}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AuditEmptyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDatabaseEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                <DataTrigger Binding="{Binding IsFilteredNoResult}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AuditDatabaseEmptyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsDatabaseEmpty}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AuditFilteredEmptyVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsFilteredNoResult}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AuditErrorVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AuditNoSelectionVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding IsNoSelection}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="AuditDetailsVisibilityStyle" TargetType="FrameworkElement">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding HasDetails}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Nhật ký hoạt động" Style="{StaticResource PageTitleTextStyle}" FontSize="27" />
                <TextBlock Text="Theo dõi các thay đổi quan trọng và hoạt động quản trị trong hệ thống."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" Margin="0,9,0,0" />
            </StackPanel>
            <Button Content="↻  Làm mới" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="AuditRefreshButton" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,16,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1.15*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                    <TextBlock Text="Từ ngày" Style="{StaticResource AuditLabelStyle}" />
                    <DatePicker SelectedDate="{Binding FromDate}" SelectedDateFormat="Short" Language="vi-VN" MinWidth="180"
                                AutomationProperties.AutomationId="AuditFromDate" HorizontalAlignment="Stretch" TabIndex="0" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,12">
                    <TextBlock Text="Đến ngày" Style="{StaticResource AuditLabelStyle}" />
                    <DatePicker SelectedDate="{Binding ToDate}" SelectedDateFormat="Short" Language="vi-VN" MinWidth="180"
                                AutomationProperties.AutomationId="AuditToDate" HorizontalAlignment="Stretch" TabIndex="1" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,12">
                    <TextBlock Text="Nghiệp vụ" Style="{StaticResource AuditLabelStyle}" />
                    <TextBox Text="{Binding BusinessAreaFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AuditFilterTextBoxStyle}"
                             ToolTip="Lọc theo nghiệp vụ" AutomationProperties.AutomationId="AuditBusinessAreaFilter" TabIndex="2" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Hành động" Style="{StaticResource AuditLabelStyle}" />
                    <ComboBox ItemsSource="{Binding ActionOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAction}"
                              Style="{StaticResource AuditComboBoxStyle}" AutomationProperties.AutomationId="AuditActionFilter" TabIndex="3" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Người thực hiện" Style="{StaticResource AuditLabelStyle}" />
                    <TextBox Text="{Binding ActorFilter, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource AuditFilterTextBoxStyle}"
                             ToolTip="Lọc theo người thực hiện" AutomationProperties.AutomationId="AuditActorFilter" TabIndex="4" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                 <Button Content="Tìm kiếm" Command="{Binding SearchCommand}" IsDefault="True"
                         Margin="0,0,10,0"
                         Style="{StaticResource PrimaryButtonStyle}"
                         AutomationProperties.AutomationId="AuditSearchButton" TabIndex="5" />
                  <Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                         AutomationProperties.AutomationId="AuditClearFiltersButton" TabIndex="6" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,14">
                        <TextBlock Text="Hoạt động gần đây" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <Grid Grid.Row="1">
                    <DataGrid ItemsSource="{Binding Audits}"
                              SelectedItem="{Binding SelectedAudit, Mode=TwoWay}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutomationProperties.AutomationId="AuditList" AutoGenerateColumns="False"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding LocalTimeText}" Width="145" MinWidth="135" />
                            <DataGridTemplateColumn Header="Người thực hiện" Width="1.1*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Actor}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Actor}" Margin="4,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Hoạt động" Width="1.55*" MinWidth="170">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,2" ToolTip="{Binding ActionText}">
                                            <TextBlock Text="{Binding ActionText}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding BusinessArea}" TextTrimming="CharacterEllipsis" Style="{StaticResource SecondaryTextStyle}" FontSize="11" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Đối tượng" Width="1.1*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Target}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Target}" Margin="4,0" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Kết quả" Width="95" MinWidth="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10" Padding="8,3" HorizontalAlignment="Left" ToolTip="{Binding ResultText}">
                                            <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="Failed"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                            <TextBlock Text="{Binding ResultText}" FontSize="11" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Máy/Quầy" Binding="{Binding TerminalId}" Width="105" MinWidth="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Style="{StaticResource AuditLoadingVisibilityStyle}" Background="{StaticResource SurfaceBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="180" Height="4" />
                            <TextBlock Text="Đang tải nhật ký hoạt động..." Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <Border Style="{StaticResource AuditEmptyVisibilityStyle}" Background="{StaticResource SurfaceBrush}" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="⌕" FontSize="30" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                            <TextBlock Style="{StaticResource AuditDatabaseEmptyVisibilityStyle}" Text="Chưa có nhật ký hoạt động" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource AuditFilteredEmptyVisibilityStyle}" Text="Không có hoạt động phù hợp với bộ lọc" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,8,0,0" />
                            <TextBlock Text="Thử thay đổi bộ lọc hoặc làm mới để kiểm tra lại." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource AuditErrorVisibilityStyle}" Background="{StaticResource SurfaceBrush}" Padding="20">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360">
                            <TextBlock Text="Không thể tải nhật ký hoạt động" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,14" />
                            <Button Content="Thử lại" Command="{Binding RetryCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Center" AutomationProperties.AutomationId="AuditRetryButton" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                        <Button Content="‹" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Width="38" AutomationProperties.AutomationId="AuditPreviousPage" />
                        <Button Content="›" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Width="38" Margin="8,0,0,0" AutomationProperties.AutomationId="AuditNextPage" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <Grid>
                    <Border Style="{StaticResource AuditNoSelectionVisibilityStyle}" Padding="18">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="⌕" Foreground="{StaticResource TextMutedBrush}" FontSize="28" HorizontalAlignment="Center" />
                            <TextBlock Text="Chọn một hoạt động để xem chi tiết." TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Style="{StaticResource AuditDetailsVisibilityStyle}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel DataContext="{Binding Details}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock Text="Chi tiết hoạt động" Style="{StaticResource SectionTitleTextStyle}" />
                                <Border Grid.Column="1" CornerRadius="11" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="Failed"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style>
                                    <StackPanel Orientation="Horizontal"><TextBlock x:Name="AuditDetailResultIcon" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold" Margin="0,0,5,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Text" Value="✓" /><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="Failed"><Setter Property="Text" Value="✕" /><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ResultText}" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}" /><Style.Triggers><DataTrigger Binding="{Binding Result}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding ActionText}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,18,0,0" ToolTip="{Binding ActionText}" />
                            <TextBlock Text="{Binding BusinessArea}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding Target}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" ToolTip="{Binding Target}" />

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Người thực hiện" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding Actor}" Style="{StaticResource AuditValueStyle}" TextWrapping="Wrap" ToolTip="{Binding Actor}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Thời gian" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding LocalTimeText}" Style="{StaticResource AuditValueStyle}" /><TextBlock Text="{Binding OccurredAtUtc, StringFormat='UTC: {0:dd/MM/yyyy HH:mm:ss}'}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" /></StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,10,0"><TextBlock Text="Máy/Quầy" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding TerminalId}" Style="{StaticResource AuditValueStyle}" TextWrapping="Wrap" ToolTip="{Binding TerminalId}" /></StackPanel>
                                <StackPanel Grid.Column="1"><TextBlock Text="Loại đối tượng" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding TargetType}" Style="{StaticResource AuditValueStyle}" TextWrapping="Wrap" ToolTip="{Binding TargetType}" /></StackPanel>
                            </Grid>

                            <TextBlock Text="Tóm tắt thay đổi" Margin="0,18,0,6">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AuditLabelStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding RequestedCountText}" Value="—" /><Condition Binding="{Binding ChangedCountText}" Value="—" /><Condition Binding="{Binding NoOpCountText}" Value="—" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Grid>
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding RequestedCountText}" Value="—" /><Condition Binding="{Binding ChangedCountText}" Value="—" /><Condition Binding="{Binding NoOpCountText}" Value="—" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Collapsed" /></MultiDataTrigger></Style.Triggers></Style></Grid.Style>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0"><TextBlock Text="Yêu cầu" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding RequestedCountText}" Style="{StaticResource AuditValueStyle}" /></StackPanel>
                                <StackPanel Grid.Column="1" Margin="0,0,8,0"><TextBlock Text="Đã đổi" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding ChangedCountText}" Style="{StaticResource AuditValueStyle}" /></StackPanel>
                                <StackPanel Grid.Column="2"><TextBlock Text="Không đổi" Style="{StaticResource AuditLabelStyle}" /><TextBlock Text="{Binding NoOpCountText}" Style="{StaticResource AuditValueStyle}" /></StackPanel>
                            </Grid>
                            <TextBlock Text="Thay đổi" Margin="0,18,0,6">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource AuditLabelStyle}"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <ItemsControl ItemsSource="{Binding Changes}">
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <TextBlock Text="{Binding FieldKey}" FontWeight="SemiBold" TextWrapping="Wrap" ToolTip="{Binding FieldKey}" />
                                        <Grid Grid.Row="1" Margin="0,5,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="1*" /></Grid.ColumnDefinitions>
                                            <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="6" Padding="8,5" Margin="0,0,6,0"><TextBlock Text="{Binding BeforeValue, TargetNullValue=—}" TextWrapping="Wrap" ToolTip="{Binding BeforeValue}" /></Border>
                                            <TextBlock Grid.Column="1" Text="→" Foreground="{StaticResource TextMutedBrush}" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                            <Border Grid.Column="2" Background="{StaticResource AccentSoftBrush}" CornerRadius="6" Padding="8,5"><TextBlock Text="{Binding AfterValue, TargetNullValue=—}" TextWrapping="Wrap" ToolTip="{Binding AfterValue}" /></Border>
                                        </Grid>
                                    </Grid>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Sự kiện này không có trường dữ liệu thay đổi." TextWrapping="Wrap" Margin="0,0,0,0">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Changes.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <Expander Header="Chi tiết kỹ thuật" IsExpanded="False" Margin="0,18,0,0">
                                <StackPanel Margin="4,8,4,0"><TextBlock Text="{Binding OperationId, StringFormat='Correlation/Operation ID: {0}'}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" /><TextBlock Text="{Binding TechnicalTarget, StringFormat='Target kỹ thuật: {0}'}" TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Visibility="{Binding HasTechnicalTarget, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
