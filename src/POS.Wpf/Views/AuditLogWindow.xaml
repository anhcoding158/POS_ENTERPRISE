<Window x:Class="POS.Wpf.Views.AuditLogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nhật ký hoạt động" Width="1180" Height="720" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="AuditLogWindow">
    <Window.Resources>
        <Style x:Key="AuditLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AuthLabelStyle}">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,5" />
        </Style>
        <Style x:Key="AuditValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="AuditComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Nhật ký hoạt động" Style="{StaticResource PageTitleTextStyle}" FontSize="27" />
                <TextBlock Text="Theo dõi các thay đổi quan trọng và hoạt động quản trị trong hệ thống."
                           Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" />
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}"
                           TextWrapping="Wrap" Margin="0,9,0,0" />
            </StackPanel>
            <Button Content="↻  Làm mới" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}"
                    AutomationProperties.AutomationId="AuditRefreshButton" />
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,20,0,16">
            <WrapPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Từ ngày" Style="{StaticResource AuditLabelStyle}" />
                    <DatePicker SelectedDate="{Binding FromDate}" Width="140"
                                AutomationProperties.AutomationId="AuditFromDate" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Đến ngày" Style="{StaticResource AuditLabelStyle}" />
                    <DatePicker SelectedDate="{Binding ToDate}" Width="140"
                                AutomationProperties.AutomationId="AuditToDate" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Người thực hiện" Style="{StaticResource AuditLabelStyle}" />
                    <TextBox Text="{Binding ActorFilter, UpdateSourceTrigger=PropertyChanged}" Width="160"
                             AutomationProperties.AutomationId="AuditActorFilter" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nghiệp vụ" Style="{StaticResource AuditLabelStyle}" />
                    <TextBox Text="{Binding BusinessAreaFilter, UpdateSourceTrigger=PropertyChanged}" Width="170"
                             AutomationProperties.AutomationId="AuditBusinessAreaFilter" />
                </StackPanel>
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Hành động" Style="{StaticResource AuditLabelStyle}" />
                    <ComboBox ItemsSource="{Binding ActionOptions}" DisplayMemberPath="DisplayName"
                              SelectedItem="{Binding SelectedAction}" Width="180"
                              Style="{StaticResource AuditComboBoxStyle}"
                              AutomationProperties.AutomationId="AuditActionFilter" />
                </StackPanel>
                <Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}"
                        VerticalAlignment="Bottom" Margin="0,0,0,1"
                        Style="{StaticResource SecondaryButtonStyle}"
                        AutomationProperties.AutomationId="AuditClearFiltersButton" />
            </WrapPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.65*" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="16,14">
                        <TextBlock Text="Hoạt động gần đây" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding PageText}" Style="{StaticResource SecondaryTextStyle}"
                                   HorizontalAlignment="Right" />
                    </Grid>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Audits}"
                              SelectedItem="{Binding SelectedAudit, Mode=TwoWay}"
                              Style="{StaticResource ModernDataGridStyle}"
                              AutomationProperties.AutomationId="AuditList" AutoGenerateColumns="False"
                              EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thời gian" Binding="{Binding LocalTimeText}" Width="145" MinWidth="135" />
                            <DataGridTextColumn Header="Người thực hiện" Binding="{Binding Actor}" Width="1.2*" MinWidth="120" />
                            <DataGridTextColumn Header="Hành động" Binding="{Binding ActionText}" Width="1.25*" MinWidth="130" />
                            <DataGridTextColumn Header="Đối tượng" Binding="{Binding Target}" Width="1.1*" MinWidth="110" />
                            <DataGridTextColumn Header="Nghiệp vụ" Binding="{Binding BusinessArea}" Width="1*" MinWidth="100" />
                            <DataGridTextColumn Header="Kết quả" Binding="{Binding Result}" Width="90" MinWidth="80" />
                            <DataGridTextColumn Header="Máy/Quầy" Binding="{Binding TerminalId}" Width="105" MinWidth="95" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
                        <Button Content="‹" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Width="38" AutomationProperties.AutomationId="AuditPreviousPage" />
                        <Button Content="›" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}"
                                Width="38" Margin="8,0,0,0" AutomationProperties.AutomationId="AuditNextPage" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel DataContext="{Binding Details}">
                        <TextBlock Text="Chi tiết hoạt động" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding LocalTimeText, StringFormat='Giờ địa phương: {0}'}"
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding OccurredAtUtc, StringFormat='UTC: {0:dd/MM/yyyy HH:mm:ss}'}"
                                   Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0" />
                        <TextBlock Text="Người thực hiện" Style="{StaticResource AuditLabelStyle}" Margin="0,16,0,0" />
                        <TextBlock Text="{Binding Actor}" Style="{StaticResource AuditValueStyle}" />
                        <TextBlock Text="Hành động" Style="{StaticResource AuditLabelStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding ActionText}" Style="{StaticResource AuditValueStyle}" />
                        <TextBlock Text="Đối tượng" Style="{StaticResource AuditLabelStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding Target}" Style="{StaticResource AuditValueStyle}" TextWrapping="Wrap" />
                        <TextBlock Text="Loại đối tượng" Style="{StaticResource AuditLabelStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding TargetType}" Style="{StaticResource AuditValueStyle}" />
                        <TextBlock Text="Máy/Quầy" Style="{StaticResource AuditLabelStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding TerminalId}" Style="{StaticResource AuditValueStyle}" />
                        <TextBlock Text="Thay đổi an toàn" Style="{StaticResource SectionTitleTextStyle}" Margin="0,20,0,8" />
                        <DataGrid ItemsSource="{Binding Changes}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                  CanUserAddRows="False" IsReadOnly="True" Height="160">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Trường thay đổi" Binding="{Binding FieldKey}" Width="*" />
                                <DataGridTextColumn Header="Trước" Binding="{Binding BeforeValue}" Width="*" />
                                <DataGridTextColumn Header="Sau" Binding="{Binding AfterValue}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="Không có dữ liệu thay đổi chi tiết cho sự kiện này."
                                   TextWrapping="Wrap" Margin="0,10,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Changes.Count}" Value="0">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
