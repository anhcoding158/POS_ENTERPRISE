<Window
    x:Class="POS.Wpf.Views.ForcedPasswordChangeWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Đổi mật khẩu bắt buộc"
    Width="560"
    Height="590"
    MinWidth="500"
    MinHeight="520"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    Background="{StaticResource AppBackgroundBrush}"
    AutomationProperties.AutomationId="ForcedPasswordChangeWindow">
    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Đổi mật khẩu bắt buộc" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="Tài khoản tạm thời chưa được phép mở Shell. Hãy đặt mật khẩu mới để tiếp tục." TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,24" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Mật khẩu mới *" Style="{StaticResource AuthLabelStyle}" />
                <PasswordBox x:Name="NewPasswordInput" AutomationProperties.AutomationId="ForcedPasswordChangeNewPassword" Style="{StaticResource AuthPasswordBoxStyle}" PasswordChanged="OnNewPasswordChanged" />
                <TextBlock Text="Xác nhận mật khẩu *" Style="{StaticResource AuthLabelStyle}" Margin="0,18,0,7" />
                <PasswordBox x:Name="ConfirmPasswordInput" AutomationProperties.AutomationId="ForcedPasswordChangeConfirmPassword" Style="{StaticResource AuthPasswordBoxStyle}" PasswordChanged="OnConfirmPasswordChanged" />
                <Border Margin="0,22,0,0" Padding="14" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                    <StackPanel>
                        <TextBlock Text="YÊU CẦU MẬT KHẨU" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,0,0,9" />
                        <TextBlock Text="● Ít nhất 10 ký tự" Tag="{Binding HasMinimumLength}" Style="{StaticResource PasswordRequirementStyle}" />
                        <TextBlock Text="● Có chữ hoa, chữ thường và chữ số" Tag="{Binding HasUppercase}" Style="{StaticResource PasswordRequirementStyle}" />
                        <TextBlock Text="● Có ký tự đặc biệt, không có khoảng trắng" Tag="{Binding HasSpecialCharacter}" Style="{StaticResource PasswordRequirementStyle}" />
                        <TextBlock Text="● Hai mật khẩu trùng nhau" Tag="{Binding PasswordConfirmationMatches}" Style="{StaticResource PasswordRequirementStyle}" />
                    </StackPanel>
                </Border>
                <TextBlock Text="{Binding StatusMessage}" AutomationProperties.AutomationId="ForcedPasswordChangeValidation" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="2,16,0,0" />
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Thoát" AutomationProperties.AutomationId="ForcedPasswordChangeCancelButton" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" />
            <Button Content="Đổi mật khẩu" AutomationProperties.AutomationId="ForcedPasswordChangeSaveButton" Command="{Binding ChangePasswordCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="150" Margin="10,0,0,0" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
