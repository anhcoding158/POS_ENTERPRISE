<Window x:Class="POS.Wpf.Views.BulkProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thao tác nhiều sản phẩm" Width="920" Height="680"
        MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Thao tác nhiều sản phẩm" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock Text="Xem trước toàn bộ thay đổi rồi mới xác nhận lưu." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0"/>
        </StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Thao tác" Style="{StaticResource ShellCaptionTextStyle}"/><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" DisplayMemberPath="DisplayName" Height="40" Padding="10,4"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0"><TextBlock Text="Thông tin cần nhập" Style="{StaticResource ShellCaptionTextStyle}"/><TextBlock Text="{Binding OperationDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/><StackPanel Orientation="Horizontal" Margin="0,10,0,0"><TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="38" Margin="0,0,8,0" ToolTip="Giá bán"/><TextBox Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="38" ToolTip="Giá vốn"/><TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" Width="120" Height="38" Margin="8,0,0,0" ToolTip="Tồn tối thiểu"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Width="180" Height="38" Margin="8,0,0,0" ToolTip="Danh mục"/></StackPanel></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Phạm vi" Style="{StaticResource ShellCaptionTextStyle}"/><TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal"><TextBlock Text="Xem trước thay đổi" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="14,3,0,0"/></StackPanel>
            <DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" Style="{StaticResource ModernDataGridStyle}" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Mã" Binding="{Binding ProductCode}" Width="110"/><DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding ProductName}" Width="2*"/><DataGridTextColumn Header="Trước" Binding="{Binding BeforeValue}" Width="1.2*"/><DataGridTextColumn Header="Sau" Binding="{Binding AfterValue}" Width="1.2*"/><DataGridTextColumn Header="Kết quả" Binding="{Binding ResultText}" Width="1.4*"/></DataGrid.Columns></DataGrid>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Hủy" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="82"/><Button Content="Kiểm tra" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Margin="8,0,0,0"/><Button Content="Xác nhận lưu" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="125" Margin="8,0,0,0"/><Button Content="Đóng" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="82" Margin="8,0,0,0"/></StackPanel></Grid>
    </Grid>
</Window>
