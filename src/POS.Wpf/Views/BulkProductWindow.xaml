<Window x:Class="POS.Wpf.Views.BulkProductWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Thao tác hàng loạt" Width="920" Height="680"
        MinWidth="720" MinHeight="520" WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel><DockPanel><TextBlock Text="Thao tác hàng loạt" Style="{StaticResource PageTitleTextStyle}"/><TextBlock Text="{Binding SelectionText}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Bottom" Margin="18,0,0,4"/></DockPanel><TextBlock Text="Kiểm tra thông tin hiện tại, nhập thay đổi và xem trước khi lưu." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0"/></StackPanel>
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16" Margin="0,18,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions>
                <StackPanel><TextBlock Text="Thao tác" Style="{StaticResource CaptionTextStyle}"/><ComboBox ItemsSource="{Binding Operations}" SelectedItem="{Binding SelectedOperation}" DisplayMemberPath="DisplayName" Height="40" Padding="10,4"/></StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0"><TextBlock Text="Thông tin cần nhập" Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="{Binding OperationDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,8,0,0"/>
                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Visibility="{Binding IsPriceOperation, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Giá bán mới (đ)"/><TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,4,8,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Visibility="{Binding IsPriceOperation, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Giá vốn mới (đ)"/><TextBox Text="{Binding CostPriceText, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Visibility="{Binding IsCategoryOperation, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Danh mục đích"/><ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" DisplayMemberPath="Name" Height="38" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Visibility="{Binding IsStatusOperation, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Trạng thái bán mới"/><ComboBox x:Name="StatusOperationComboBox" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" DisplayMemberPath="DisplayName" Height="38" Margin="0,4,0,0"/></StackPanel>
                        <StackPanel Visibility="{Binding IsMinimumStockOperation, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Ngưỡng cảnh báo tồn mới"/><TextBox Text="{Binding MinimumStockText, UpdateSourceTrigger=PropertyChanged}" Height="38" Margin="0,4,0,0"/><TextBlock Text="Chỉ đổi ngưỡng cảnh báo, không đổi tồn thực tế." TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Phạm vi" Style="{StaticResource CaptionTextStyle}"/><TextBlock Text="{Binding SelectionText}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,8,0,0"/></StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding PreviewHeading}" Style="{StaticResource SectionTitleTextStyle}"/><TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" Margin="14,3,0,0"/></StackPanel><DataGrid Grid.Row="1" ItemsSource="{Binding PreviewRows}" Style="{StaticResource ModernDataGridStyle}" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"><DataGrid.Columns><DataGridTextColumn Header="Sản phẩm" Binding="{Binding ProductName}" Width="2*"/><DataGridTextColumn Header="Mã" Binding="{Binding ProductCode}" Width="120"/><DataGridTextColumn Header="Hiện tại" Binding="{Binding BeforeValue}" Width="2*"/><DataGridTextColumn Header="Đề xuất" Binding="{Binding AfterValue}" Width="2*"/><DataGridTextColumn Header="Trạng thái" Binding="{Binding ResultText}" Width="1.5*"/></DataGrid.Columns></DataGrid></Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Hủy tác vụ" Command="{Binding CancelCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92"/><Button Content="Xem trước thay đổi" Command="{Binding PreviewCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="140" Margin="8,0,0,0"/><Button Content="Xác nhận lưu" Command="{Binding ConfirmCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="125" Margin="8,0,0,0"/><Button Content="Đóng cửa sổ" Command="{Binding CloseCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="105" Margin="8,0,0,0"/></StackPanel></Grid>
    </Grid>
</Window>
