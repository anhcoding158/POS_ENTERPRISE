<Window
    x:Class="POS.Wpf.Views.ShellWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="clr-namespace:POS.Wpf.ViewModels"
    Title="POS Enterprise"
    Width="1366"
    Height="768"
    MinWidth="1024"
    MinHeight="650"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    SizeToContent="Manual"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="12"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- =================================================
             LOCAL TYPOGRAPHY & ALIGNMENT STYLES
             ================================================= -->

        <Style
            x:Key="ShellCaptionTextStyle"
            TargetType="{x:Type TextBlock}"
            BasedOn="{StaticResource CaptionTextStyle}">

            <Setter
                Property="FontSize"
                Value="11.5" />
        </Style>

        <!-- Đã sửa: HorizontalAlignment="Stretch" để TextAlignment hoạt động đúng trên toàn cột -->
        <Style
            x:Key="CenteredTableTextStyle"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />

            <Setter
                Property="FontSize"
                Value="12.5" />

            <Setter
                Property="TextAlignment"
                Value="Center" />

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <Setter
                Property="TextTrimming"
                Value="CharacterEllipsis" />
        </Style>

        <Style
            x:Key="CenteredTableHeaderTextStyle"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />

            <Setter
                Property="FontSize"
                Value="11.5" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="TextAlignment"
                Value="Center" />

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />
        </Style>

        <!-- Thêm Style Căn Phải (cho Cột Giá Bán) -->
        <Style
            x:Key="RightAlignedTableTextStyle"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />

            <Setter
                Property="FontSize"
                Value="12.5" />

            <Setter
                Property="TextAlignment"
                Value="Right" />

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <!-- Khoảng cách để không dính sát lề phải -->
            <Setter 
                Property="Margin" 
                Value="0,0,25,0" />
        </Style>

        <Style
            x:Key="RightAlignedTableHeaderTextStyle"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />

            <Setter
                Property="FontSize"
                Value="11.5" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="TextAlignment"
                Value="Right" />

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <Setter 
                Property="Margin" 
                Value="0,0,25,0" />
        </Style>

        <!-- Thêm Style Căn Trái (Cho cột Tiêu đề Sản Phẩm) -->
        <Style
            x:Key="LeftAlignedTableHeaderTextStyle"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />

            <Setter
                Property="FontSize"
                Value="11.5" />

            <Setter
                Property="FontWeight"
                Value="SemiBold" />

            <Setter
                Property="TextAlignment"
                Value="Left" />

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <!-- Margin khớp với phần đệm của icon bên dưới -->
            <Setter 
                Property="Margin" 
                Value="15,0,0,0" />
        </Style>

        <Style
            x:Key="LeftAlignedTableTextStyle"
            TargetType="{x:Type TextBlock}">

            <Setter
                Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />

            <Setter
                Property="FontSize"
                Value="12.5" />

            <Setter
                Property="TextAlignment"
                Value="Left" />

            <Setter
                Property="HorizontalAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalAlignment"
                Value="Center" />

            <Setter
                Property="TextTrimming"
                Value="CharacterEllipsis" />
        </Style>

        <!-- =================================================
             INVENTORY ACTION BUTTON
             ================================================= -->

        <Style
            x:Key="InventoryActionButtonStyle"
            TargetType="{x:Type Button}"
            BasedOn="{StaticResource SecondaryButtonStyle}">

            <Setter
                Property="Background"
                Value="{StaticResource GoldSoftBrush}" />

            <Setter
                Property="Foreground"
                Value="#8C611D" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource GoldBorderBrush}" />

            <Setter
                Property="MinWidth"
                Value="142" />

            <Setter
                Property="FontSize"
                Value="13" />
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- =================================================
             SIDEBAR
             ================================================= -->

        <Border
            Grid.Column="0"
            Background="{StaticResource SidebarBrush}">

            <Grid>

                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Margin" Value="12,18,12,16" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                                <Setter Property="Margin" Value="4,14,4,14" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand -->

                <StackPanel
                    HorizontalAlignment="Center"
                    Visibility="{Binding IsSidebarExpanded,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Grid
                        Width="72"
                        Height="72">

                        <Ellipse
                            Margin="4"
                            Stroke="{StaticResource GoldBrush}"
                            StrokeThickness="1.5" />

                        <Border
                            Width="47"
                            Height="47"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource GoldHoverBrush}"
                            BorderThickness="1.2"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>

                        <TextBlock
                            Text="P"
                            FontFamily="Georgia"
                            FontSize="30"
                            Foreground="{StaticResource GoldGradientBrush}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock
                        Text="P O S   E N T E R P R I S E"
                        Foreground="{StaticResource GoldHoverBrush}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,0" />

                    <TextBlock
                        Text="R E S T A U R A N T   S O L U T I O N S"
                        Foreground="{StaticResource SidebarMutedBrush}"
                        FontSize="8.5"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,0" />

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0">

                        <Border
                            Width="40"
                            Height="1"
                            Background="#705E47"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="◆"
                            Foreground="{StaticResource GoldBrush}"
                            FontSize="9"
                            Margin="7,0" />

                        <Border
                            Width="40"
                            Height="1"
                            Background="#705E47"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation -->

                <ScrollViewer
                    Grid.Row="1"
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled"
                    Margin="0,16,0,12"
                    AutomationProperties.AutomationId="ShellNavigationScrollRegion">

                    <ScrollViewer.Resources>
                        <Style TargetType="{x:Type ScrollBar}">
                            <Setter Property="Width" Value="5" />
                            <Setter Property="Opacity" Value="0.45" />
                        </Style>
                    </ScrollViewer.Resources>

                    <StackPanel>

                        <StackPanel
                            x:Name="TaskNavigationPanel"
                            AutomationProperties.AutomationId="ShellTaskNavigation">
                            <Button
                                Command="{Binding NavigateToOverviewCommand}"
                                AutomationProperties.AutomationId="ShellOverviewNavigationButton">
                                <Button.Style>
                                    <Style TargetType="{x:Type Button}" BasedOn="{StaticResource NavigationButtonStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsOverviewRouteActive}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" />
                                    <TextBlock
                                        Text="Tổng quan"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="CompactSalesNavigationButton"
                                Click="OnOpenSalesClick"
                                IsEnabled="{Binding CanUseCheckout}"
                                Style="{StaticResource NavigationButtonStyle}"
                                AutomationProperties.AutomationId="ShellSalesNavigationButton"
                                ToolTip="Mở quầy bán hàng">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8A1;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" />
                                    <TextBlock
                                        Text="Bán hàng"
                                        VerticalAlignment="Center"
                                        Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </StackPanel>
                            </Button>

                            <Expander
                                x:Name="ShellInventoryGroup"
                                IsExpanded="{Binding IsInventoryExpanded, Mode=TwoWay}"
                                Style="{StaticResource ShellNavigationGroupStyle}"
                                AutomationProperties.AutomationId="ShellInventoryGroup">
                                <Expander.Header>
                                    <Grid ToolTip="Hàng hóa">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Hàng hóa"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Button
                                        x:Name="ShellProductsNavigationButton"
                                        Command="{Binding NavigateToProductsCommand}"
                                        ToolTip="Sản phẩm &amp; tồn kho"
                                        AutomationProperties.AutomationId="ShellProductsNavigationButton">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ShellNavigationChildButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsProductsRouteActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="Sản phẩm &amp; tồn kho"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ShellCategoriesNavigationButton"
                                        Command="{Binding OpenCategoryManagementCommand}"
                                        IsEnabled="{Binding CanManageCategories}"
                                        Visibility="{Binding CanManageCategories, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        ToolTip="Danh mục sản phẩm"
                                        AutomationProperties.AutomationId="ShellCategoriesNavigationButton">
                                        <Button.Style>
                                            <Style TargetType="{x:Type Button}" BasedOn="{StaticResource ShellNavigationChildButtonStyle}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCategoriesRouteActive}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource SidebarSelectedBrush}" />
                                                        <Setter Property="Foreground" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="Danh mục sản phẩm"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="ShellInventoryHistoryNavigationButton"
                                        Command="{Binding ViewInventoryHistoryCommand}"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        ToolTip="Xem lịch sử biến động tồn kho"
                                        AutomationProperties.AutomationId="ShellInventoryHistoryNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE81C;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock
                                                Text="Lịch sử kho"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander
                                IsExpanded="{Binding IsOrdersExpanded, Mode=TwoWay}"
                                Style="{StaticResource ShellNavigationGroupStyle}"
                                AutomationProperties.AutomationId="ShellOrdersGroup">
                                <Expander.Header>
                                    <Grid ToolTip="Đơn hàng">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="Đơn hàng"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Button
                                        x:Name="CompactOrderHistoryNavigationButton"
                                        Command="{Binding OpenOrderHistoryCommand}"
                                        IsEnabled="{Binding CanViewOrderHistory}"
                                        Visibility="{Binding CanViewOrderHistory, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        ToolTip="Lịch sử đơn hàng"
                                        AutomationProperties.AutomationId="ShellOrderHistoryNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Lịch sử đơn hàng" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander
                                IsExpanded="{Binding IsQrExpanded, Mode=TwoWay}"
                                Visibility="{Binding CanViewVietQr, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ShellNavigationGroupStyle}"
                                AutomationProperties.AutomationId="ShellQrGroup">
                                <Expander.Header>
                                    <Grid ToolTip="Thanh toán QR">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="QR" FontWeight="Bold" Width="32" />
                                        <TextBlock Grid.Column="1" Text="Thanh toán QR" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel x:Name="VietQrNavigationPanel" />
                            </Expander>

                            <Expander
                                IsExpanded="{Binding IsManagementExpanded, Mode=TwoWay}"
                                Visibility="{Binding CanManageStoreSetup, Converter={StaticResource BooleanToVisibilityConverter}}"
                                Style="{StaticResource ShellNavigationGroupStyle}"
                                AutomationProperties.AutomationId="ShellManagementGroup">
                                <Expander.Header>
                                    <Grid ToolTip="Quản lý cửa hàng">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" />
                                        <TextBlock Grid.Column="1" Text="Quản lý cửa hàng" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Button
                                        x:Name="CompactEmployeeManagementNavigationButton"
                                        Click="OnOpenEmployeeManagementClick"
                                        IsEnabled="{Binding CanViewEmployees}"
                                        Visibility="{Binding CanViewEmployees, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        ToolTip="Nhân viên &amp; tài khoản"
                                        AutomationProperties.AutomationId="EmployeeManagementNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Nhân viên &amp; tài khoản" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="CompactStoreSettingsNavigationButton"
                                        Click="OnOpenStoreSettingsClick"
                                        IsEnabled="{Binding CanManageStoreSetup}"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        AutomationProperties.AutomationId="StoreSettingsNavigationButton"
                                        ToolTip="Cài đặt thông tin cửa hàng và máy in">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Cài đặt cửa hàng" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="RolePermissionManagementNavigationButton"
                                        Click="OnOpenRolePermissionManagementClick"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        ToolTip="Vai trò và quyền hạn"
                                        AutomationProperties.AutomationId="RolePermissionManagementNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE8D4;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Vai trò &amp; quyền hạn" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>

                            <Expander
                                IsExpanded="{Binding IsDataExpanded, Mode=TwoWay}"
                                Style="{StaticResource ShellNavigationGroupStyle}"
                                AutomationProperties.AutomationId="ShellDataSupportGroup">
                                <Expander.Header>
                                    <Grid ToolTip="Dữ liệu &amp; hỗ trợ">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="&#xE8D2;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" />
                                        <TextBlock Grid.Column="1" Text="Dữ liệu &amp; hỗ trợ" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Expander.Header>
                                <StackPanel>
                                    <Button Click="OnOpenManualBackupClick" Style="{StaticResource ShellNavigationChildButtonStyle}" ToolTip="Sao lưu dữ liệu" AutomationProperties.AutomationId="ShellBackupNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE74E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Sao lưu dữ liệu" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="CompactRestoreDataNavigationButton"
                                        Click="OnOpenRestoreWizardClick"
                                        IsEnabled="{Binding CanRestoreData}"
                                        Visibility="{Binding CanRestoreData, Converter={StaticResource BooleanToVisibilityConverter}}"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        ToolTip="Khôi phục dữ liệu"
                                        AutomationProperties.AutomationId="RestoreDataNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Khôi phục dữ liệu" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="AuditLogNavigationButton" Click="OnOpenAuditLogClick" Style="{StaticResource ShellNavigationChildButtonStyle}" AutomationProperties.AutomationId="AuditLogNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Nhật ký hoạt động" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="StorageStatusNavigationButton"
                                        Click="OnOpenStorageStatusClick"
                                        Style="{StaticResource ShellNavigationChildButtonStyle}"
                                        ToolTip="Dung lượng"
                                        AutomationProperties.AutomationId="StorageStatusNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xEDA2;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Dung lượng" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Click="OnOpenSupportBundleClick" Style="{StaticResource ShellNavigationChildButtonStyle}" ToolTip="Gói hỗ trợ" AutomationProperties.AutomationId="ShellSupportNavigationButton">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="&#xE897;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                            <TextBlock Text="Gói hỗ trợ" VerticalAlignment="Center" Visibility="{Binding IsSidebarExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </StackPanel>

                        <StackPanel
                            x:Name="LegacyNavigationPanel"
                            Visibility="Collapsed">

                        <Grid Margin="7,0,0,10">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="MENU CHÍNH"
                                Foreground="{StaticResource SidebarMutedBrush}"
                                FontSize="11"
                                FontWeight="SemiBold" />

                            <Border
                                Grid.Column="1"
                                Height="1"
                                Margin="10,0,0,0"
                                Background="#4A423D"
                                VerticalAlignment="Center" />
                        </Grid>

                        <Button
                            Style="{StaticResource NavigationButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="&#xE80F;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text="Tổng quan"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Style="{StaticResource SelectedNavigationButtonStyle}">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="&#xE719;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text="Sản phẩm và kho"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            Command="{Binding OpenCategoryManagementCommand}"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Quản lý danh mục sản phẩm">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="&#xE8EC;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text="Danh mục"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="SalesNavigationButton"
                            Click="OnOpenSalesClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Mở quầy bán hàng">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="&#xE8A1;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text="Bán hàng"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="OrderHistoryNavigationButton"
                            Command="{Binding OpenOrderHistoryCommand}"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Tra cứu lịch sử đơn hàng">

                            <StackPanel Orientation="Horizontal">

                                <TextBlock
                                    Text="&#xE9D2;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    Text=""
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="SupportBundleNavigationButton"
                            Click="OnOpenSupportBundleClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Tạo gói chẩn đoán an toàn để hỗ trợ xử lý sự cố">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="&#xE946;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="Gói hỗ trợ"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="ManualBackupNavigationButton"
                            Click="OnOpenManualBackupClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Sao lưu dữ liệu SQLite đã verify">

                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="&#xE8D2;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    Text="Sao lưu dữ liệu"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="RestoreDataNavigationButton"
                            AutomationProperties.AutomationId="RestoreDataNavigationButton"
                            Click="OnOpenRestoreWizardClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Khôi phục dữ liệu từ backup đã kiểm tra">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets"
                                           FontSize="17" Width="32" VerticalAlignment="Center" />
                                <TextBlock Text="Khôi phục dữ liệu" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="StoreSettingsNavigationButton"
                            AutomationProperties.AutomationId="LegacyStoreSettingsNavigationButton"
                            Click="OnOpenStoreSettingsClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Cài đặt cửa hàng và thiết bị">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" VerticalAlignment="Center" />
                                <TextBlock Text="Cài đặt cửa hàng" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="EmployeeManagementNavigationButton"
                            AutomationProperties.AutomationId="LegacyEmployeeManagementNavigationButton"
                            Click="OnOpenEmployeeManagementClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Quản lý nhân viên và tài khoản">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="17" Width="32" VerticalAlignment="Center" />
                                <TextBlock Text="Nhân viên và tài khoản" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button
                            x:Name="LegacyStorageStatusNavigationButton"
                            AutomationProperties.AutomationId="LegacyStorageStatusNavigationButton"
                            Click="OnOpenStorageStatusClick"
                            Style="{StaticResource NavigationButtonStyle}"
                            ToolTip="Xem trạng thái dung lượng database và ổ đĩa">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock
                                    Text="&#xEDA2;"
                                    FontFamily="Segoe MDL2 Assets"
                                    FontSize="17"
                                    Width="32"
                                    VerticalAlignment="Center" />
                                <StackPanel>
                                    <TextBlock Text="Dung lượng" />
                                    <TextBlock
                                        Text="{Binding StatusText}"
                                        FontSize="10"
                                        Opacity="0.78"
                                        TextTrimming="CharacterEllipsis"
                                        MaxWidth="145" />
                                </StackPanel>
                            </StackPanel>
                        </Button>

                        </StackPanel>

                        <Border
                            x:Name="AutomaticBackupStatusSurface"
                            Margin="7,10,7,0"
                            Padding="12,9"
                            Background="{StaticResource SidebarSurfaceBrush}"
                            CornerRadius="8"
                            Visibility="{Binding DataContext.IsSidebarExpanded,
                                RelativeSource={RelativeSource AncestorType={x:Type Window}},
                                Converter={StaticResource BooleanToVisibilityConverter}}"
                            ToolTip="{Binding DetailText}">
                            <StackPanel>
                                <TextBlock
                                    Text="{Binding StatusText}"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Margin="0,3,0,0"
                                    Text="{Binding DetailText}"
                                    FontSize="10"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="180" />
                            </StackPanel>
                        </Border>

                        <!-- Quote -->

                        <Border
                            Margin="7,34,7,0"
                            Padding="15"
                            Background="{StaticResource SidebarSurfaceBrush}"
                            BorderBrush="#6A4C27"
                            BorderThickness="1"
                            CornerRadius="12"
                            Visibility="{Binding IsSidebarExpanded,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                            <StackPanel>

                                <TextBlock
                                    Text="◆"
                                    Foreground="{StaticResource GoldBrush}"
                                    FontSize="10"
                                    HorizontalAlignment="Center" />

                                <TextBlock
                                    Text="“Chất lượng tạo nên thương hiệu, dịch vụ làm nên khác biệt.”"
                                    FontFamily="Georgia"
                                    FontSize="12"
                                    FontStyle="Italic"
                                    Foreground="#E5D3B5"
                                    TextWrapping="Wrap"
                                    TextAlignment="Center"
                                    LineHeight="20"
                                    Margin="0,10,0,10" />

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                                    <Border
                                        Width="26"
                                        Height="1"
                                        Background="#785C34"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Text="✦"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="9"
                                        Margin="7,0" />

                                    <Border
                                        Width="26"
                                        Height="1"
                                        Background="#785C34"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- Sidebar footer -->

                <StackPanel
                    x:Name="ShellStatusFooter"
                    Grid.Row="2"
                    HorizontalAlignment="Center">

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Center">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="{StaticResource SuccessBrush}"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="SQLite đã kết nối"
                            Foreground="{StaticResource SidebarMutedBrush}"
                            FontSize="10.5"
                            Visibility="{Binding IsSidebarExpanded,
                                Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </StackPanel>

                    <TextBlock
                        Text="© 2026 POS Enterprise"
                        Foreground="#A0958C"
                        FontSize="10"
                        HorizontalAlignment="Center"
                        Margin="0,9,0,0"
                        Visibility="{Binding IsSidebarExpanded,
                            Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <TextBlock
                        Text="Phiên bản 2.0.0"
                        Foreground="#8A8078"
                        FontSize="10"
                        HorizontalAlignment="Center"
                        Margin="0,3,0,0"
                        Visibility="{Binding IsSidebarExpanded,
                            Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- =================================================
             MAIN WORKSPACE
             ================================================= -->

        <Grid
            Grid.Column="1"
            Margin="24,18,24,20">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->

            <Grid Grid.Row="0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>

                    <TextBlock
                        Text="Sản phẩm và tồn kho"
                        Style="{StaticResource PageTitleTextStyle}" />

                    <TextBlock
                        Text="Quản lý danh mục, giá bán và toàn bộ biến động kho."
                        Style="{StaticResource SecondaryTextStyle}"
                        FontSize="13.5"
                        Margin="0,5,0,0" />

                    <StackPanel
                        Orientation="Horizontal"
                        Margin="0,10,0,0">

                        <Border
                            Width="105"
                            Height="1"
                            Background="{StaticResource GoldBorderBrush}"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="◆"
                            Foreground="{StaticResource GoldBrush}"
                            FontSize="9"
                            Margin="7,0" />

                        <Border
                            Width="105"
                            Height="1"
                            Background="{StaticResource GoldBorderBrush}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>

                <!-- Administrator card -->

                <Border
                    Grid.Column="1"
                    Padding="10,8,14,8"
                    Background="{StaticResource SurfaceBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Visibility="{Binding IsSidebarExpanded,
                        Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Border.Effect>

                        <DropShadowEffect
                            Color="#463026"
                            BlurRadius="12"
                            ShadowDepth="2"
                            Opacity="0.08" />
                    </Border.Effect>

                    <StackPanel Orientation="Horizontal">

                        <Border
                            Width="38"
                            Height="38"
                            Background="{StaticResource AccentGradientBrush}"
                            CornerRadius="19">

                            <TextBlock
                                Text="A"
                                FontFamily="Georgia"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Margin="11,0,14,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="Quản trị viên"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="12.5"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding LastUpdatedText}"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="10.5"
                                Margin="0,2,0,0" />
                        </StackPanel>

                        <TextBlock
                            Text="&#xE70D;"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- =================================================
                 KPI CARDS
                 ================================================= -->

            <UniformGrid
                x:Name="InventorySummaryCards"
                Grid.Row="1"
                Margin="0,18,0,16">

                <UniformGrid.Style>
                    <Style TargetType="{x:Type UniformGrid}">
                        <Setter Property="Columns" Value="4" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSidebarCompact}" Value="True">
                                <Setter Property="Columns" Value="2" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </UniformGrid.Style>

                <!-- Total products -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0"
                    Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="43"
                            Height="43"
                            Background="{StaticResource GoldSoftBrush}"
                            BorderBrush="{StaticResource GoldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22">

                            <TextBlock
                                Text="&#xE719;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource GoldBrush}"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="TỔNG SẢN PHẨM"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding TotalProductsText}"
                                Style="{StaticResource CardValueTextStyle}"
                                Margin="0,4,0,0" />

                            <TextBlock
                                Text="Toàn bộ kết quả tìm kiếm"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Active products -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="4,0,6,0"
                    Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="43"
                            Height="43"
                            Background="{StaticResource GoldSoftBrush}"
                            BorderBrush="{StaticResource GoldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22">

                            <TextBlock
                                Text="&#xE73E;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource GoldBrush}"
                                FontSize="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="ĐANG BÁN TRÊN TRANG"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding ActiveProductsOnPageText}"
                                Style="{StaticResource CardValueTextStyle}"
                                Margin="0,4,0,0" />

                            <TextBlock
                                Text="Sản phẩm đang hoạt động"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Low-stock products -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="6,0,4,0"
                    Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="43"
                            Height="43"
                            Background="{StaticResource WarningSoftBrush}"
                            BorderBrush="{StaticResource GoldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22">

                            <TextBlock
                                Text="!"
                                Foreground="{StaticResource WarningBrush}"
                                FontSize="20"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="SẮP HẾT TRÊN TRANG"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding LowStockProductsOnPageText}"
                                Style="{StaticResource CardValueTextStyle}"
                                Margin="0,4,0,0" />

                            <TextBlock
                                Text="Cần kiểm tra nhập hàng"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Inventory value -->

                <Border
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0"
                    Padding="17">

                    <Grid>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="43"
                            Height="43"
                            Background="{StaticResource GoldSoftBrush}"
                            BorderBrush="{StaticResource GoldBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="22">

                            <TextBlock
                                Text="₫"
                                Foreground="{StaticResource GoldBrush}"
                                FontSize="18"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <StackPanel
                            Grid.Column="1"
                            Margin="13,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="GIÁ TRỊ VỐN TRÊN TRANG"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding InventoryValueOnPageText}"
                                FontFamily="Georgia"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                Margin="0,5,0,0" />

                            <TextBlock
                                Text="Tồn dương × giá vốn"
                                Style="{StaticResource ShellCaptionTextStyle}"
                                Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>
                </Border>
            </UniformGrid>

            <!-- =================================================
                 PRODUCT WORKSPACE
                 ================================================= -->

            <Border
                Grid.Row="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                ClipToBounds="True">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- =================================================
                         ROW 0: PRODUCT TITLE AND ACTIONS
                         ================================================= -->

                    <Grid
                        Grid.Row="0"
                        Margin="20,14,20,12">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">

                            <Border
                                Width="42"
                                Height="42"
                                Background="{StaticResource GoldSoftBrush}"
                                BorderBrush="{StaticResource GoldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="21">

                                <TextBlock
                                    Text="&#xE719;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="{StaticResource GoldBrush}"
                                    FontSize="18"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="Danh mục sản phẩm"
                                    Style="{StaticResource SectionTitleTextStyle}" />

                                <TextBlock
                                    Text="Quản lý thông tin, giá bán và trạng thái hoạt động."
                                    Style="{StaticResource ShellCaptionTextStyle}"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal">

                            <Button
                                Command="{Binding AddProductCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                MinWidth="138">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock
                                        Text="&#xE710;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="13"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Text="Thêm sản phẩm"
                                        VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>

                            <Button
                                x:Name="ImportExportButton"
                                Click="OnImportExportClick"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="112"
                                Margin="9,0,0,0"
                                ToolTip="Nhập sản phẩm, xuất dữ liệu hoặc tải mẫu">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE898;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Nhập / Xuất" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button.ContextMenu>
                                    <ContextMenu
                                        Placement="Bottom"
                                        StaysOpen="False"
                                        DataContext="{Binding PlacementTarget.DataContext,
                                            RelativeSource={RelativeSource Self}}">
                                        <MenuItem Header="Nhập CSV/Excel"
                                                  Command="{Binding ImportProductsCommand}"
                                                  ToolTip="Đọc thử, kiểm tra rồi nhập sản phẩm" />
                                        <MenuItem Header="Xuất file"
                                                  Command="{Binding ExportProductsCommand}"
                                                  ToolTip="Xuất dữ liệu theo phạm vi và quyền hiện tại" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>

                        </StackPanel>
                    </Grid>

                    <!-- =================================================
                         ROW 1: INVENTORY OPERATION RAIL
                         ================================================= -->

                    <Border
                        Grid.Row="1"
                        Height="64"
                        Margin="20,0,20,12"
                        Padding="12,8"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="38"
                                Height="38"
                                Background="{StaticResource GoldSoftBrush}"
                                BorderBrush="{StaticResource GoldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="11">

                                <TextBlock
                                    Text="±"
                                    FontFamily="Georgia"
                                    Foreground="{StaticResource GoldBrush}"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="{Binding SelectedProductHint}"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    TextTrimming="CharacterEllipsis" />

                                <WrapPanel
                                    Margin="0,4,0,0"
                                    Visibility="{Binding ShowSingleProductContext,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <Border
                                        Padding="7,2"
                                        Margin="0,0,7,0"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock
                                                Text="Mã: "
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="10.5" />

                                            <TextBlock
                                                Text="{Binding SelectedProductCodeText}"
                                                Foreground="{StaticResource GoldBrush}"
                                                FontSize="10.5"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="7,2"
                                        Margin="0,0,7,0"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock
                                                Text="Tồn: "
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="10.5" />

                                            <TextBlock
                                                Text="{Binding SelectedProductStockText}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                FontSize="10.5"
                                                FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        Padding="7,2"
                                        Margin="0,0,7,0"
                                        Background="{StaticResource WarningSoftBrush}"
                                        BorderBrush="{StaticResource GoldBorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <TextBlock
                                            Text="{Binding SelectedProductStockStateText}"
                                            Foreground="{StaticResource WarningBrush}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold" />
                                    </Border>

                                    <Border
                                        Padding="7,2"
                                        Margin="0,0,7,0"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <TextBlock
                                            Text="{Binding SelectedProductPolicyText}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold" />
                                    </Border>

                                    <Border
                                        Padding="7,2"
                                        Margin="0,0,7,0"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <TextBlock
                                            Text="{Binding SelectedProduct.StatusText}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold" />
                                    </Border>

                                    <Border
                                        Padding="7,2"
                                        Margin="0"
                                        Background="{StaticResource SurfaceBrush}"
                                        BorderBrush="{StaticResource BorderStrongBrush}"
                                        BorderThickness="1"
                                        CornerRadius="7">

                                        <TextBlock
                                            Text="{Binding SelectedProduct.CategoryName}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="10.5"
                                            FontWeight="SemiBold"
                                            MaxWidth="150"
                                            TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding ShowSingleProductContext,
                                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Button
                                        Command="{Binding EditProductCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="70"
                                        Padding="10,0"
                                        Content="Sửa"
                                        ToolTip="Sửa sản phẩm đang chọn" />
                                    <Button
                                        x:Name="ToggleProductActiveButton"
                                        Content="{Binding ToggleProductButtonText}"
                                        Click="OnToggleProductActiveClick"
                                        IsEnabled="{Binding CanModifySelectedProduct}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="104"
                                        Padding="10,0"
                                        Margin="8,0,0,0"
                                        ToolTip="Đổi trạng thái bán của sản phẩm đang chọn" />
                                    <Button
                                        x:Name="MoreProductActionsButton"
                                        Click="OnMoreProductActionsClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="132"
                                        Padding="10,0"
                                        Margin="8,0,0,0"
                                        ToolTip="Điều chỉnh tồn, lưu trữ hoặc khôi phục sản phẩm">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Kho &amp; lưu trữ" VerticalAlignment="Center" />
                                            <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Margin="7,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <Button.ContextMenu>
                                            <ContextMenu
                                                Placement="Bottom"
                                                StaysOpen="False"
                                                DataContext="{Binding PlacementTarget.DataContext,
                                                    RelativeSource={RelativeSource Self}}">
                                                <MenuItem
                                                    x:Name="AdjustInventoryMenuItem"
                                                    Header="Điều chỉnh kho"
                                                    Command="{Binding AdjustInventoryCommand}"
                                                    ToolTip="{Binding InventoryActionHint}"
                                                    ToolTipService.ShowOnDisabled="True" />
                                                <Separator />
                                                <MenuItem
                                                    x:Name="ToggleProductArchiveMenuItem"
                                                    Header="{Binding ToggleProductArchiveButtonText}"
                                                    Click="OnToggleProductArchiveClick"
                                                    IsEnabled="{Binding HasSelectedProduct}" />
                                            </ContextMenu>
                                        </Button.ContextMenu>
                                    </Button>
                                    <Button
                                        x:Name="ClearSelectedProductButton"
                                        Content="× Bỏ chọn"
                                        Command="{Binding ClearSelectedProductCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="112"
                                        Margin="8,0,0,0"
                                        Padding="10,0"
                                        ToolTip="Bỏ chọn sản phẩm đang chọn"
                                        AutomationProperties.Name="Bỏ chọn sản phẩm đang chọn"
                                        ToolTipService.ShowOnDisabled="True" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsBulkSelectionMode,
                                                Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <TextBlock
                                        x:Name="BulkSelectionContextText"
                                        Text="{Binding SelectedProductHint}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        VerticalAlignment="Center"
                                        Margin="12,0,10,0" />
                                    <Button
                                        x:Name="BulkOperationButton"
                                        Command="{Binding ApplyBulkOperationCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="34"
                                        MinWidth="142"
                                        Padding="10,0"
                                        Content="Thao tác hàng loạt"
                                        ToolTip="Xem trước và áp dụng thay đổi cho các sản phẩm đã chọn"
                                        AutomationProperties.Name="Thao tác hàng loạt cho sản phẩm đã chọn" />
                                    <Button
                                        x:Name="ExitBulkSelectionButton"
                                        Command="{Binding ToggleBulkSelectionCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="34"
                                        MinWidth="128"
                                        Padding="10,0"
                                        Margin="8,0,0,0"
                                        Content="Thoát chọn nhiều"
                                        ToolTip="Bỏ chế độ chọn nhiều; không thay đổi dữ liệu"
                                        AutomationProperties.Name="Thoát chế độ chọn nhiều" />
                                </StackPanel>
                            </StackPanel>

                        </Grid>
                    </Border>

                    <!-- =================================================
                         ROW 2: SEARCH TOOLBAR
                         ================================================= -->

                    <Border
                        Grid.Row="2"
                        Padding="20,11"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,1">

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                Width="380"
                                MinWidth="320"
                                MaxWidth="400"
                                Margin="0,0,12,0"
                                HorizontalAlignment="Left">

                                <TextBox
                                    x:Name="SearchBox"
                                    Text="{Binding SearchTerm,
                                        UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource SearchBoxWithIconStyle}"
                                    FontSize="13" />

                                <TextBlock
                                    Text="&#xE721;"
                                    FontFamily="Segoe MDL2 Assets"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="14"
                                    Margin="15,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False" />

                                <TextBlock
                                    Text="Tìm theo mã, tên hoặc barcode..."
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="12.5"
                                    Margin="42,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">

                                    <TextBlock.Style>

                                        <Style
                                            TargetType="{x:Type TextBlock}">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                            <Style.Triggers>

                                                <MultiDataTrigger>

                                                    <MultiDataTrigger.Conditions>

                                                        <Condition
                                                            Binding="{Binding Text.Length,
                                                                ElementName=SearchBox}"
                                                            Value="0" />

                                                        <Condition
                                                            Binding="{Binding IsKeyboardFocusWithin,
                                                                ElementName=SearchBox}"
                                                            Value="False" />
                                                    </MultiDataTrigger.Conditions>

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <StackPanel
                                Grid.Column="1"
                                Orientation="Horizontal">

                                <Button
                                    Command="{Binding SearchCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    MinWidth="100"
                                    IsDefault="True">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
                                            Text="&#xE721;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Text="Tìm kiếm"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="FilterButton"
                                    Click="OnFilterButtonClick"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="94"
                                    Margin="9,0,0,0">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
                                            Text="&#xE71C;"
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="12"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Text="Bộ lọc"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Content="Tải lại"
                                    Command="{Binding RefreshCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="88"
                                    Margin="9,0,0,0" />

                                <Button
                                    Command="{Binding ToggleBulkSelectionCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    MinWidth="108"
                                    Margin="9,0,0,0"
                                    Content="{Binding BulkSelectionModeText}"
                                    Visibility="{Binding IsBulkSelectionMode,
                                        Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                    ToolTip="Chọn nhiều sản phẩm trên trang để cập nhật cùng lúc"
                                    AutomationProperties.Name="Chọn nhiều sản phẩm" />
                            </StackPanel>

                            <WrapPanel
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                Visibility="{Binding HasProductFilters,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Button
                                    Command="{Binding ResetProductStatusFilterCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30"
                                    MinWidth="0"
                                    Padding="10,0"
                                    Margin="0,0,8,0"
                                    Visibility="{Binding HasProductStatusFilter,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
                                            Text="{Binding ProductStatusFilterText}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Text=" ×"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    Command="{Binding ResetStockFilterCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Height="30"
                                    MinWidth="0"
                                    Padding="10,0"
                                    Visibility="{Binding HasStockFilter,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <StackPanel Orientation="Horizontal">

                                        <TextBlock
                                            Text="{Binding StockFilterText}"
                                            VerticalAlignment="Center" />

                                        <TextBlock
                                            Text=" ×"
                                            Margin="5,0,0,0"
                                            VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Popup
                        x:Name="ProductFilterPopup"
                        Grid.Row="2"
                        PlacementTarget="{Binding ElementName=FilterButton}"
                        Placement="Bottom"
                        HorizontalOffset="-206"
                        VerticalOffset="5"
                        StaysOpen="False"
                        AllowsTransparency="True"
                        DataContext="{Binding PlacementTarget.DataContext,
                            RelativeSource={RelativeSource Self}}">

                        <Border
                            Width="300"
                            Padding="16"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderStrongBrush}"
                            BorderThickness="1"
                            CornerRadius="10">

                            <StackPanel>

                                <TextBlock
                                    Text="TRẠNG THÁI"
                                    Style="{StaticResource ShellCaptionTextStyle}"
                                    FontWeight="SemiBold" />

                                <ComboBox
                                    ItemsSource="{Binding ProductStatusFilters}"
                                    SelectedItem="{Binding SelectedProductStatusFilter,
                                        Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    Height="40"
                                    Margin="0,6,0,14"
                                    ToolTip="Lọc sản phẩm theo trạng thái bán"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    Padding="11,6"
                                    FontSize="13"
                                    VerticalContentAlignment="Center" />

                                <TextBlock
                                    Text="TỒN KHO"
                                    Style="{StaticResource ShellCaptionTextStyle}"
                                    FontWeight="SemiBold" />

                                <ComboBox
                                    ItemsSource="{Binding StockFilterOptions}"
                                    SelectedItem="{Binding SelectedStockFilter,
                                        Mode=TwoWay}"
                                    DisplayMemberPath="DisplayName"
                                    Height="40"
                                    Margin="0,6,0,14"
                                    ToolTip="Lọc sản phẩm theo tình trạng tồn kho"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderStrongBrush}"
                                    BorderThickness="1"
                                    Padding="11,6"
                                    FontSize="13"
                                    VerticalContentAlignment="Center" />

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">

                                    <Button
                                        Content="Xóa bộ lọc"
                                        Command="{Binding ResetProductFiltersCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="104" />

                                    <Button
                                        Content="Đóng"
                                        Click="OnCloseProductFilterClick"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        MinWidth="70"
                                        Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- =================================================
                         ROW 3: PRODUCT DATA TABLE
                         ================================================= -->

                    <Grid Grid.Row="3">

                        <DataGrid
                            x:Name="ProductInventoryGrid"
                            ItemsSource="{Binding Products}"
                            SelectedItem="{Binding SelectedProduct,
                                Mode=TwoWay}"
                            Style="{StaticResource ModernDataGridStyle}"
                            GridLinesVisibility="All"
                            VerticalGridLinesBrush="{StaticResource BorderBrush}"
                            EnableRowVirtualization="True"
                            EnableColumnVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.CanContentScroll="True"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.IsDeferredScrollingEnabled="True">

                            <DataGrid.Columns>

                                <DataGridTemplateColumn Header="CHỌN" Width="68">
                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsThreeState="True"
                                                IsChecked="{Binding DataContext.BulkPageSelectionState,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                                                    Mode=OneWay}"
                                                Click="OnBulkPageSelectionClick"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                ToolTip="Chọn hoặc bỏ chọn tất cả sản phẩm trên trang hiện tại"
                                                AutomationProperties.Name="Chọn tất cả sản phẩm trên trang hiện tại" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                IsChecked="{Binding IsBulkSelected, Mode=TwoWay}"
                                                Visibility="{Binding DataContext.IsBulkSelectionMode,
                                                    RelativeSource={RelativeSource AncestorType={x:Type DataGrid}},
                                                    Converter={StaticResource BooleanToVisibilityConverter}}"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="Chọn sản phẩm" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- SẢN PHẨM: Đã cập nhật HeaderTemplate và CellTemplate Margin để căn trái mượt mà -->
                                <DataGridTemplateColumn
                                    Width="2.6*"
                                    MinWidth="260">

                                    <DataGridTemplateColumn.HeaderTemplate>
                                        <DataTemplate>
                                            <Border
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,1,0">

                                                <TextBlock Text="SẢN PHẨM" Style="{StaticResource LeftAlignedTableHeaderTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Grid Margin="15,0,0,0">
                                                <!-- Thêm Margin để không sát lề -->

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <Border
                                                    Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Background="{StaticResource GoldSoftBrush}"
                                                    BorderBrush="{StaticResource GoldBorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="9">

                                                    <TextBlock
                                                        Text="&#xE719;"
                                                        FontFamily="Segoe MDL2 Assets"
                                                        Foreground="{StaticResource GoldBrush}"
                                                        FontSize="14"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center" />
                                                </Border>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    Margin="9,0,0,0"
                                                    VerticalAlignment="Center">

                                                    <TextBlock
                                                        Text="{Binding Name}"
                                                        Foreground="{StaticResource TextPrimaryBrush}"
                                                        FontSize="13.5"
                                                        FontWeight="SemiBold"
                                                        TextTrimming="CharacterEllipsis" />

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        Margin="0,3,0,0">

                                                        <TextBlock
                                                            Text="{Binding Code}"
                                                            Foreground="{StaticResource GoldBrush}"
                                                            FontSize="10.5"
                                                            FontWeight="SemiBold" />

                                                        <TextBlock
                                                            Text="  •  "
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            FontSize="10.5" />

                                                        <TextBlock
                                                            Text="{Binding UnitName}"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            FontSize="10.5" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- CATEGORY -->

                                <DataGridTextColumn
                                    Binding="{Binding CategoryName}"
                                    Width="1.4*"
                                    MinWidth="135">

                                    <DataGridTextColumn.HeaderTemplate>

                                        <DataTemplate>

                                            <Border
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,1,0">

                                                <TextBlock
                                                    Text="DANH MỤC"
                                                    Style="{StaticResource LeftAlignedTableHeaderTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>

                                    <DataGridTextColumn.ElementStyle>

                                        <Style
                                            TargetType="{x:Type TextBlock}"
                                            BasedOn="{StaticResource LeftAlignedTableTextStyle}">

                                            <Setter
                                                Property="FontSize"
                                                Value="12.5" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- SALE PRICE: Đổi sang RightAligned (Căn phải chuẩn tiền tệ) -->

                                <DataGridTextColumn
                                    Binding="{Binding SalePriceText}"
                                    Width="1*"
                                    MinWidth="125">

                                    <DataGridTextColumn.HeaderTemplate>

                                        <DataTemplate>

                                            <Border
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,1,0">

                                                <TextBlock
                                                    Text="GIÁ BÁN"
                                                    Style="{StaticResource RightAlignedTableHeaderTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTextColumn.HeaderTemplate>

                                    <DataGridTextColumn.ElementStyle>

                                        <Style
                                            TargetType="{x:Type TextBlock}"
                                            BasedOn="{StaticResource RightAlignedTableTextStyle}">

                                            <Setter
                                                Property="FontFamily"
                                                Value="Georgia" />

                                            <Setter
                                                Property="FontSize"
                                                Value="12.5" />

                                            <Setter
                                                Property="FontWeight"
                                                Value="SemiBold" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>

                                <!-- STOCK -->

                                <DataGridTemplateColumn
                                    Width="1.15*"
                                    MinWidth="150">

                                    <DataGridTemplateColumn.HeaderTemplate>

                                        <DataTemplate>

                                            <Border
                                                BorderBrush="{StaticResource BorderBrush}"
                                                BorderThickness="0,0,1,0">

                                                <TextBlock
                                                    Text="TỒN KHO"
                                                    Style="{StaticResource CenteredTableHeaderTextStyle}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <StackPanel
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center">

                                                <TextBlock
                                                    Text="{Binding StockDisplay}"
                                                    Foreground="{StaticResource TextPrimaryBrush}"
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    HorizontalAlignment="Center"
                                                    TextAlignment="Center" />

                                                <Border
                                                    Height="24"
                                                    MinWidth="62"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="8,0"
                                                    CornerRadius="7"
                                                    Margin="0,4,0,0">

                                                    <Border.Style>

                                                        <Style
                                                            TargetType="{x:Type Border}">

                                                            <Setter
                                                                Property="Background"
                                                                Value="{StaticResource SuccessSoftBrush}" />

                                                            <Style.Triggers>

                                                                <DataTrigger
                                                                    Binding="{Binding TrackInventory}"
                                                                    Value="False">

                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="{StaticResource SurfaceMutedBrush}" />
                                                                </DataTrigger>

                                                                <DataTrigger
                                                                    Binding="{Binding IsLowStock}"
                                                                    Value="True">

                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="{StaticResource WarningSoftBrush}" />
                                                                </DataTrigger>

                                                                <DataTrigger
                                                                    Binding="{Binding IsOutOfStock}"
                                                                    Value="True">

                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="{StaticResource DangerSoftBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock
                                                        Text="{Binding StockStateText}"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center">

                                                        <TextBlock.Style>

                                                            <Style
                                                                TargetType="{x:Type TextBlock}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource SuccessBrush}" />

                                                                <Style.Triggers>

                                                                    <DataTrigger
                                                                        Binding="{Binding TrackInventory}"
                                                                        Value="False">

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource TextSecondaryBrush}" />
                                                                    </DataTrigger>

                                                                    <DataTrigger
                                                                        Binding="{Binding IsLowStock}"
                                                                        Value="True">

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource WarningBrush}" />
                                                                    </DataTrigger>

                                                                    <DataTrigger
                                                                        Binding="{Binding IsOutOfStock}"
                                                                        Value="True">

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource DangerBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>

                                <!-- STATUS -->

                                <DataGridTemplateColumn
                                    Width="1*"
                                    MinWidth="140">

                                    <DataGridTemplateColumn.HeaderTemplate>

                                        <DataTemplate>

                                            <TextBlock
                                                Text="TRẠNG THÁI"
                                                Style="{StaticResource CenteredTableHeaderTextStyle}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.HeaderTemplate>

                                    <DataGridTemplateColumn.CellTemplate>

                                        <DataTemplate>

                                            <Grid>

                                                <Border
                                                    Height="28"
                                                    MinWidth="82"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Padding="11,0"
                                                    CornerRadius="8">

                                                    <Border.Style>

                                                        <Style
                                                            TargetType="{x:Type Border}">

                                                            <Setter
                                                                Property="Background"
                                                                Value="{StaticResource SurfaceMutedBrush}" />

                                                            <Setter
                                                                Property="BorderBrush"
                                                                Value="{StaticResource BorderBrush}" />

                                                            <Setter
                                                                Property="BorderThickness"
                                                                Value="1" />

                                                            <Style.Triggers>

                                                                <DataTrigger
                                                                    Binding="{Binding IsActive}"
                                                                    Value="True">

                                                                    <Setter
                                                                        Property="Background"
                                                                        Value="{StaticResource SuccessSoftBrush}" />

                                                                    <Setter
                                                                        Property="BorderBrush"
                                                                        Value="#C8E5D2" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <TextBlock
                                                        Text="{Binding StatusText}"
                                                        FontSize="10.5"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Center"
                                                        VerticalAlignment="Center"
                                                        TextAlignment="Center">

                                                        <TextBlock.Style>

                                                            <Style
                                                                TargetType="{x:Type TextBlock}">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource TextSecondaryBrush}" />

                                                                <Style.Triggers>

                                                                    <DataTrigger
                                                                        Binding="{Binding IsActive}"
                                                                        Value="True">

                                                                        <Setter
                                                                            Property="Foreground"
                                                                            Value="{StaticResource SuccessBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <!-- Empty state -->

                        <Border Background="{StaticResource SurfaceBrush}">

                            <Border.Style>

                                <Style
                                    TargetType="{x:Type Border}">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition
                                                    Binding="{Binding Products.Count}"
                                                    Value="0" />

                                                <Condition
                                                    Binding="{Binding IsLoading}"
                                                    Value="False" />
                                            </MultiDataTrigger.Conditions>

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Border
                                    Width="62"
                                    Height="62"
                                    Background="{StaticResource GoldSoftBrush}"
                                    BorderBrush="{StaticResource GoldBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="20">

                                    <TextBlock
                                        Text="&#xE719;"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="26"
                                        Foreground="{StaticResource GoldBrush}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <TextBlock
                                    Text="Chưa có sản phẩm phù hợp"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    HorizontalAlignment="Center"
                                    Margin="0,14,0,0" />

                                <TextBlock
                                    Text="Thử thay đổi từ khóa hoặc tạo sản phẩm mới."
                                    Style="{StaticResource SecondaryTextStyle}"
                                    FontSize="12.5"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Loading overlay -->

                        <Border
                            Background="#D9FFFEFB"
                            Visibility="{Binding IsLoading,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                            <StackPanel
                                Width="255"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <ProgressBar
                                    Height="5"
                                    IsIndeterminate="True"
                                    Foreground="{StaticResource AccentBrush}" />

                                <TextBlock
                                    Text="Đang tải dữ liệu sản phẩm..."
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="12.5"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- =================================================
                         ROW 4: FOOTER AND PAGINATION
                         ================================================= -->

                    <Grid
                        Grid.Row="4"
                        Margin="20,11">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Text="{Binding StatusMessage}"
                            Style="{StaticResource ShellCaptionTextStyle}"
                            VerticalAlignment="Center" />

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal">

                            <Button
                                Content="Trước"
                                Command="{Binding PreviousPageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="78" />

                            <Border
                                Height="42"
                                Padding="15,0"
                                Margin="9,0"
                                Background="{StaticResource AccentBrush}"
                                CornerRadius="8">

                                <TextBlock
                                    Text="{Binding PageText}"
                                    Foreground="White"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Center" />
                            </Border>

                            <Button
                                Content="Sau"
                                Command="{Binding NextPageCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                MinWidth="78" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
