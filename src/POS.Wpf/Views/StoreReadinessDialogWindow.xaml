<Window x:Class="POS.Wpf.Views.StoreReadinessDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cửa hàng chưa sẵn sàng" Width="520" SizeToContent="Height" MinWidth="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        AutomationProperties.AutomationId="StoreReadinessDialogWindow">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Cửa hàng chưa sẵn sàng" Style="{StaticResource PageTitleTextStyle}" FontSize="23"/>
        <TextBlock Grid.Row="1" Text="Bạn cần hoàn tất một số thiết lập trước khi mở quầy bán hàng." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,8,0,16"/>
        <StackPanel Grid.Row="2">
            <ItemsControl ItemsSource="{Binding Issues}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,8">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource DangerBrush}" Margin="0,0,10,0" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="StoreReadinessCloseButton" Content="Đóng" IsCancel="True" Click="OnCloseClick" AutomationProperties.AutomationId="StoreReadinessCloseButton" Style="{StaticResource SecondaryButtonStyle}"/>
                <Button x:Name="StoreReadinessOpenSettingsButton" Content="Mở cài đặt cửa hàng" Click="OnOpenSettingsClick" AutomationProperties.AutomationId="StoreReadinessOpenSettingsButton" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
