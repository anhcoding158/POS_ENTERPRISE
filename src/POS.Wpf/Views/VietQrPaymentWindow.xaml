<Window
    x:Class="POS.Wpf.Views.VietQrPaymentWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="vi-VN"
    Title="POS Enterprise - Thanh toán VietQR"
    Width="1010"
    Height="690"
    MinWidth="920"
    MinHeight="630"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="12"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True"
    PreviewKeyDown="OnPreviewKeyDown"
    Closing="OnWindowClosing">

    <Window.Resources>

        <Style
            x:Key="VietQrSectionLabelStyle"
            TargetType="{x:Type TextBlock}">

            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />

            <Setter
                Property="Foreground"
                Value="{StaticResource GoldBrush}" />
        </Style>

        <Style
            x:Key="VietQrCardStyle"
            TargetType="{x:Type Border}">

            <Setter
                Property="Background"
                Value="{StaticResource SurfaceBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource BorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style
            x:Key="VietQrStepNumberStyle"
            TargetType="{x:Type Border}">

            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#F5E9CF" />
            <Setter Property="BorderBrush" Value="#D6AE59" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="15" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
    </Window.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="86" />
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border
            Grid.Row="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="#745630"
            BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border
                        Width="50"
                        Height="50"
                        Background="#302923"
                        BorderBrush="{StaticResource GoldBrush}"
                        BorderThickness="1"
                        CornerRadius="15">

                        <TextBlock
                            Text="QR"
                            Foreground="{StaticResource GoldHoverBrush}"
                            FontFamily="Georgia"
                            FontSize="16"
                            FontWeight="Bold"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Border>

                    <StackPanel
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="THANH TOÁN VIETQR"
                            Foreground="{StaticResource GoldHoverBrush}"
                            FontFamily="Georgia"
                            FontSize="22"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Quét trên màn hình hoặc in phiếu QR cho khách"
                            Foreground="{StaticResource SidebarMutedBrush}"
                            FontSize="10.5"
                            Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border
                    Grid.Column="1"
                    Padding="12,8"
                    Background="#3B1719"
                    BorderBrush="#7A3035"
                    BorderThickness="1"
                    CornerRadius="10"
                    VerticalAlignment="Center">

                    <StackPanel Orientation="Horizontal">

                        <Ellipse
                            Width="7"
                            Height="7"
                            Fill="#F0B34F"
                            Margin="0,0,7,0"
                            VerticalAlignment="Center" />

                        <TextBlock
                            Text="CHỜ NHẬN TIỀN"
                            Foreground="#FFE2A8"
                            FontSize="10.5"
                            FontWeight="Bold"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Nội dung -->

        <Grid
            Grid.Row="1"
            Margin="18">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="390" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- QR -->

            <Border
                Grid.Column="0"
                Style="{StaticResource VietQrCardStyle}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                Padding="20">

                <Border.Effect>
                    <DropShadowEffect
                        Color="#4B3327"
                        BlurRadius="16"
                        ShadowDepth="2"
                        Direction="270"
                        Opacity="0.09" />
                </Border.Effect>

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="QUÉT MÃ ĐỂ CHUYỂN KHOẢN"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontSize="12"
                            FontWeight="Bold"
                            HorizontalAlignment="Center" />

                        <TextBlock
                            Text="Mã đã chứa đúng số tiền và nội dung của giao dịch này"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="10"
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Margin="15,5,15,0" />
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Width="292"
                        Height="292"
                        Margin="0,12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="#D7CCBD"
                        BorderThickness="1"
                        CornerRadius="14"
                        Padding="14">

                        <Border.Effect>
                            <DropShadowEffect
                                Color="#594434"
                                BlurRadius="15"
                                ShadowDepth="2"
                                Direction="270"
                                Opacity="0.12" />
                        </Border.Effect>

                        <Image
                            x:Name="QrImage"
                            Stretch="Uniform"
                            RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>

                    <Border
                        Grid.Row="2"
                        Padding="14,11"
                        Background="#3A1719"
                        BorderBrush="#7A3035"
                        BorderThickness="1"
                        CornerRadius="12">

                        <StackPanel>

                            <TextBlock
                                Text="SỐ TIỀN CẦN THANH TOÁN"
                                Foreground="#D8BBB9"
                                FontSize="10"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Center" />

                            <TextBlock
                                x:Name="AmountText"
                                Text="0 ₫"
                                Foreground="#FFE2A8"
                                FontFamily="Georgia"
                                FontSize="27"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Thông tin thanh toán -->

            <Border
                Grid.Column="2"
                Style="{StaticResource VietQrCardStyle}"
                BorderBrush="{StaticResource BorderStrongBrush}"
                Padding="20">

                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="THÔNG TIN THANH TOÁN"
                            Style="{StaticResource VietQrSectionLabelStyle}" />

                        <TextBlock
                            Text="Khách quét mã và kiểm tra đúng người nhận"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontFamily="Georgia"
                            FontSize="19"
                            FontWeight="SemiBold"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>

                    <Border
                        Grid.Row="1"
                        Style="{StaticResource VietQrCardStyle}"
                        Margin="0,16,0,0"
                        Background="{StaticResource SurfaceMutedBrush}"
                        Padding="15">

                        <StackPanel>

                            <TextBlock
                                Text="NỘI DUNG CHUYỂN KHOẢN"
                                Foreground="{StaticResource TextMutedBrush}"
                                FontSize="9.5"
                                FontWeight="Bold" />

                            <TextBlock
                                x:Name="TransferContentText"
                                Text="—"
                                Foreground="{StaticResource AccentBrush}"
                                FontFamily="Consolas"
                                FontSize="14"
                                FontWeight="Bold"
                                TextWrapping="Wrap"
                                Margin="0,6,0,0" />

                            <TextBlock
                                x:Name="PaymentReferenceText"
                                Text="—"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="9.5"
                                Margin="0,5,0,0" />

                            <Border
                                x:Name="RecipientDetailsPanel"
                                Visibility="Collapsed"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock
                                            Text="NGÂN HÀNG"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="9.5"
                                            FontWeight="Bold" />

                                        <TextBlock
                                            x:Name="BankNameText"
                                            Text="—"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock
                                            Text="CHỦ TÀI KHOẢN"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="9.5"
                                            FontWeight="Bold" />

                                        <TextBlock
                                            x:Name="AccountNameText"
                                            Text="—"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="RecipientInformationMessagePanel"
                                Visibility="Collapsed"
                                Margin="0,12,0,0"
                                Padding="12"
                                Background="#FFF8E8"
                                BorderBrush="#E3C681"
                                BorderThickness="1"
                                CornerRadius="10">

                                <TextBlock
                                    x:Name="RecipientInformationMessageText"
                                    Text="Thông tin người nhận chưa khả dụng."
                                    Foreground="#8A672D"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border
                        Grid.Row="2"
                        Margin="0,12,0,0"
                        Padding="14"
                        Background="#FFF8E8"
                        BorderBrush="#E3C681"
                        BorderThickness="1"
                        CornerRadius="12">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Text="&#xE749;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="#A6751D"
                                FontSize="19"
                                Margin="0,1,11,0" />

                            <StackPanel Grid.Column="1">

                                <TextBlock
                                    Text="Khách không quét được màn hình?"
                                    Foreground="#72521D"
                                    FontSize="11.5"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    Text="Bấm IN PHIẾU QR để in mã, số tiền và nội dung chuyển khoản. Phiếu in chưa xác nhận khách đã thanh toán."
                                    Foreground="#8A672D"
                                    FontSize="10"
                                    TextWrapping="Wrap"
                                    LineHeight="16"
                                    Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel
                        Grid.Row="3"
                        Margin="0,14,0,0">

                        <TextBlock
                            Text="XÁC NHẬN GIAO DỊCH"
                            Style="{StaticResource VietQrSectionLabelStyle}" />

                        <Grid Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Style="{StaticResource VietQrStepNumberStyle}">

                                <TextBlock
                                    Text="1"
                                    Foreground="#8D651E"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="11,0,0,0">

                                <TextBlock
                                    Text="Khách quét QR trên màn hình hoặc trên phiếu in."
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Text="Ứng dụng ngân hàng phải hiện đúng người nhận và đúng số tiền."
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="9.5"
                                    TextWrapping="Wrap"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <Grid Margin="0,10,0,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Style="{StaticResource VietQrStepNumberStyle}">

                                <TextBlock
                                    Text="2"
                                    Foreground="#8D651E"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                            </Border>

                            <StackPanel
                                Grid.Column="1"
                                Margin="11,0,0,0">

                                <TextBlock
                                    Text="Thu ngân kiểm tra tiền thực tế đã vào tài khoản."
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Text="Không xác nhận chỉ dựa vào ảnh chụp hoặc màn hình của khách."
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="9.5"
                                    TextWrapping="Wrap"
                                    Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <Border
                        Grid.Row="4"
                        Margin="0,14,0,0"
                        Padding="14,12"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">

                        <CheckBox
                            x:Name="ConfirmationCheckBox"
                            Checked="OnConfirmationChanged"
                            Unchecked="OnConfirmationChanged"
                            VerticalContentAlignment="Center">

                            <TextBlock
                                Text="Tôi đã kiểm tra tài khoản cửa hàng và xác nhận đã nhận đủ tiền."
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap"
                                Margin="7,0,0,0" />
                        </CheckBox>
                    </Border>
                </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Footer -->

        <Border
            Grid.Row="2"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="0,1,0,0">

            <Grid Margin="20,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    VerticalAlignment="Center"
                    Margin="0,0,16,0">

                    <TextBlock
                        x:Name="StatusText"
                        Text="Đang chờ thu ngân kiểm tra giao dịch."
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="10.5"
                        TextWrapping="Wrap" />

                    <TextBlock
                        Text="Esc: hủy • Ctrl+P: in phiếu QR • Ctrl+Enter: xác nhận"
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="9.5"
                        Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Button
                        x:Name="PrintSlipButton"
                        Content="IN PHIẾU QR"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="48"
                        MinWidth="150"
                        Padding="18,0"
                        Click="OnPrintSlipClick"
                        Margin="0,0,10,0" />

                    <Button
                        Content="HỦY"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Height="48"
                        MinWidth="100"
                        Padding="18,0"
                        Click="OnCancelClick"
                        Margin="0,0,10,0" />

                    <Button
                        x:Name="ConfirmButton"
                        Height="48"
                        MinWidth="220"
                        Padding="20,0"
                        Content="XÁC NHẬN ĐÃ NHẬN TIỀN"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Click="OnConfirmClick"
                        IsEnabled="False" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>