<Window
    x:Class="POS.Wpf.Views.ProductImportWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nhập sản phẩm từ CSV / Excel"
    Width="1240"
    Height="820"
    MinWidth="980"
    MinHeight="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ImportCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="18" />
        </Style>

        <Style x:Key="ImportLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="ImportComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="ImportDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NHẬP SẢN PHẨM" Foreground="{StaticResource GoldBrush}" FontFamily="Georgia" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="CSV / Excel secure preview" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Georgia" FontSize="26" FontWeight="Bold" Margin="0,3,0,0" />
                <TextBlock Text="Đọc thử, mapping, kiểm tra toàn bộ dữ liệu rồi mới xác nhận transaction." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding ChooseFileCommand}" Content="Chọn tệp" Style="{StaticResource PrimaryButtonStyle}" MinWidth="120" />
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <Border Style="{StaticResource ImportCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="12">
                            <TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldBrush}" FontSize="19" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="13,0,20,0" VerticalAlignment="Center">
                            <TextBlock Text="Tệp nguồn" Style="{StaticResource ImportLabelStyle}" />
                            <TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,7,0,0">
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" />
                            </Border>
                            <ProgressBar Height="3" Margin="0,6,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Width="220">
                            <TextBlock Text="WORKSHEET" Style="{StaticResource ImportLabelStyle}" />
                            <ComboBox ItemsSource="{Binding WorksheetNames}" SelectedItem="{Binding SelectedWorksheetName, Mode=TwoWay}" Style="{StaticResource ImportComboStyle}" Margin="0,5,0,0" IsEnabled="{Binding HasMultipleWorksheets}" ToolTip="Tệp nhiều worksheet phải chọn rõ worksheet cần nhập." />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ImportCardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="1 · MAPPING CỘT" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                                <TextBlock Text="Kiểm tra cột gốc, chọn trường đích trong schema 11 trường và bấm đọc thử lại sau khi chỉnh." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Command="{Binding PreviewCommand}" Content="Đọc thử &amp; kiểm tra" Style="{StaticResource SecondaryButtonStyle}" MinWidth="148" IsDefault="True" />
                        </DockPanel>

                        <ItemsControl ItemsSource="{Binding Headers}" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.3*" />
                                                <ColumnDefinition Width="1.5*" />
                                                <ColumnDefinition Width="1.3*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding OriginalName}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ImportComboStyle}" Margin="12,0" />
                                            <TextBlock Grid.Column="2" Text="{Binding SampleValue}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SampleValue}" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ImportCardStyle}">
                    <StackPanel>
                        <TextBlock Text="2 · KIỂM TRA VÀ XEM TRƯỚC" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="{Binding SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,3,0,0" />
                        <TextBlock Text="{Binding PreviewLimitText}" Foreground="{StaticResource GoldBrush}" FontSize="11" Margin="0,3,0,10" />
                        <DataGrid ItemsSource="{Binding PreviewRows}" Style="{StaticResource ImportDataGridStyle}" Height="260" EnableRowVirtualization="True" EnableColumnVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dòng" Binding="{Binding SourceRowNumber}" Width="58" />
                                <DataGridTextColumn Header="ProductCode" Binding="{Binding ProductCode}" Width="110" />
                                <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode}" Width="120" />
                                <DataGridTextColumn Header="Tên" Binding="{Binding Name}" Width="170" />
                                <DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="120" />
                                <DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitName}" Width="85" />
                                <DataGridTextColumn Header="Giá bán" Binding="{Binding SalePrice}" Width="95" />
                                <DataGridTextColumn Header="Giá vốn" Binding="{Binding CostPrice}" Width="95" />
                                <DataGridTextColumn Header="Tồn đầu" Binding="{Binding InitialStock}" Width="85" />
                                <DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding MinimumStock}" Width="105" />
                                <DataGridTextColumn Header="Trạng thái" Binding="{Binding IsActive}" Width="100" />
                                <DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ImportCardStyle}" Visibility="{Binding HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="LỖI VÀ CẢNH BÁO THEO DÒNG" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="Bold" />
                        <TextBlock Text="{Binding IssueLimitText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,8" />
                        <DataGrid ItemsSource="{Binding Issues}" Style="{StaticResource ImportDataGridStyle}" Height="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Dòng" Binding="{Binding SourceRow}" Width="70" />
                                <DataGridTextColumn Header="Trường" Binding="{Binding Field}" Width="150" />
                                <DataGridTextColumn Header="Mức" Binding="{Binding Severity}" Width="90" />
                                <DataGridTextColumn Header="Lý do" Binding="{Binding Message}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ImportCardStyle}">
                    <StackPanel>
                        <TextBlock Text="3 · CHÍNH SÁCH TRÙNG VÀ XÁC NHẬN" Foreground="{StaticResource TextPrimaryBrush}" FontSize="16" FontWeight="Bold" />
                        <TextBlock Text="Không có lựa chọn ghi đè âm thầm. Chính sách được gửi nguyên vẹn vào service transaction." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ComboBox ItemsSource="{Binding DuplicatePolicies}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ImportComboStyle}" />
                            <TextBlock Grid.Column="1" Text="{Binding PolicyExplanation}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="Wrap" />
                        </Grid>
                        <TextBlock Text="Chỉ có thể xác nhận khi toàn bộ dữ liệu hợp lệ, mapping đủ trường bắt buộc, quyền hợp lệ và preview chưa bị thay đổi." Foreground="{StaticResource GoldBrush}" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ImportCardStyle}" Visibility="{Binding HasImportResult, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource SuccessSoftBrush}">
                    <StackPanel>
                        <TextBlock Text="KẾT QUẢ TRANSACTION" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="{Binding ResultText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding CancelCommand}" Content="Hủy thao tác" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" />
                <Button Command="{Binding ImportAnotherFileCommand}" Content="Nhập tệp khác" Style="{StaticResource SecondaryButtonStyle}" MinWidth="110" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Command="{Binding BackCommand}" Content="Quay lại" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" />
                <Button Command="{Binding ContinueCommand}" Content="Tiếp tục xác nhận" Style="{StaticResource SecondaryButtonStyle}" MinWidth="145" Margin="8,0,0,0" />
                <Button Command="{Binding ConfirmImportCommand}" Content="Xác nhận nhập" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130" Margin="8,0,0,0" />
                <Button Command="{Binding CloseCommand}" Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" MinWidth="78" Margin="8,0,0,0" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
