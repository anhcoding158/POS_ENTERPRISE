<Window
    x:Class="POS.Wpf.Views.ProductImportWizardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nhập sản phẩm từ Excel/CSV"
    Width="1180"
    Height="760"
    MinWidth="960"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="ImportCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="Padding" Value="18" />
        </Style>
        <Style x:Key="SelectStagePanelStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ReviewStagePanelStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="1"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ResultStagePanelStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding CurrentStep}" Value="3"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ImportLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="ImportComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="ImportDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="34" />
            <Setter Property="ColumnHeaderHeight" Value="38" />
        </Style>
        <Style x:Key="CompactPreviewStyle" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding ShowCompactPreview}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="IssueDetailStyle" TargetType="DataGrid" BasedOn="{StaticResource ImportDataGridStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers><DataTrigger Binding="{Binding ShowIssueDetails}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ResultIconStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding ResultIsFailure}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="ResultIconTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding ResultIsFailure}" Value="True"><Setter Property="Foreground" Value="{StaticResource DangerBrush}" /></DataTrigger></Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="NHẬP SẢN PHẨM" Foreground="{StaticResource GoldBrush}" FontFamily="Georgia" FontSize="13" FontWeight="SemiBold" />
                <TextBlock Text="Nhập sản phẩm từ Excel/CSV" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Georgia" FontSize="25" FontWeight="Bold" Margin="0,3,0,0" />
                <TextBlock Text="Thêm nhiều sản phẩm từ file có sẵn. Bạn được kiểm tra danh sách trước khi nhập." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="20,0,0,2">
                <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="12" Padding="10,5"><TextBlock Text="1  Chọn file" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" /></Border>
                <TextBlock Text="›" Foreground="{StaticResource TextMutedBrush}" FontSize="18" Margin="7,0" VerticalAlignment="Center" />
                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Padding="10,5"><TextBlock Text="2  Kiểm tra và nhập" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" /></Border>
                <TextBlock Text="›" Foreground="{StaticResource TextMutedBrush}" FontSize="18" Margin="7,0" VerticalAlignment="Center" />
                <Border Background="{StaticResource SurfaceMutedBrush}" CornerRadius="12" Padding="10,5"><TextBlock Text="3  Kết quả" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" FontWeight="SemiBold" /></Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid Style="{StaticResource SelectStagePanelStyle}">
                <StackPanel>
                    <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource SurfaceBrush}">
                        <StackPanel HorizontalAlignment="Center" MaxWidth="620">
                            <Border Width="64" Height="64" Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center"><TextBlock Text="&#xE7C3;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldBrush}" FontSize="28" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock Text="Chọn file danh sách sản phẩm" Foreground="{StaticResource TextPrimaryBrush}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            <TextBlock Text="Bạn có thể dùng file Excel (.xlsx) hoặc CSV. Hệ thống sẽ đọc thử và kiểm tra trước khi lưu." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" />
                            <TextBlock Text="{Binding ImportLimitsHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextAlignment="Center" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource InfoSoftBrush}" Visibility="{Binding HasFile, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource AccentBrush}" FontSize="22" VerticalAlignment="Top" Margin="0,1,12,0" />
                            <StackPanel Grid.Column="1"><TextBlock Text="{Binding FileName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0" /><Border Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{StaticResource DangerSoftBrush}" BorderBrush="{StaticResource DangerBrush}" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,8,0,0"><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" /></Border><ProgressBar Height="3" Margin="0,8,0,0" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel>
                            <StackPanel Grid.Column="2" Width="230" Margin="20,0,0,0" Visibility="{Binding HasMultipleWorksheets, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Bạn muốn lấy sản phẩm ở trang tính nào?" Style="{StaticResource ImportLabelStyle}" TextWrapping="Wrap" /><ComboBox ItemsSource="{Binding WorksheetNames}" SelectedItem="{Binding SelectedWorksheetName, Mode=TwoWay}" Style="{StaticResource ImportComboStyle}" Margin="0,5,0,0" ToolTip="Chọn trang tính chứa danh sách sản phẩm." /></StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock Text="Sau khi chọn file, phần mềm sẽ tự đọc và kiểm tra. Bạn vẫn có thể đổi file ở bước tiếp theo." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" Visibility="{Binding HasFile, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </StackPanel>
            </Grid>

            <Grid Style="{StaticResource ReviewStagePanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource SurfaceBrush}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><Border Width="46" Height="46" Background="{StaticResource AccentSoftBrush}" CornerRadius="14"><TextBlock Text="✓" Foreground="{StaticResource AccentBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1" Margin="14,0,0,0"><TextBlock Text="{Binding InspectionConclusion}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" /><TextBlock Text="{Binding InspectionDetail}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" /><TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource GoldBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Grid></Border>

                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource InfoSoftBrush}"><DockPanel><Button DockPanel.Dock="Right" Command="{Binding ToggleMappingCommand}" Content="Xem/chỉnh cách ghép cột" Style="{StaticResource SecondaryButtonStyle}" MinWidth="170" /><StackPanel Margin="0,0,14,0"><TextBlock Text="Cách đọc cột" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding MappingStatusText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,0" /></StackPanel></DockPanel></Border>
                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource SurfaceBrush}" Visibility="{Binding ShowMappingSection, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Cách ghép cột" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Chỉ cần chỉnh những cột phần mềm chưa nhận ra." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><Button DockPanel.Dock="Right" Command="{Binding ToggleMappingCommand}" Content="Thu gọn" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" /></DockPanel><Grid Margin="0,14,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions><TextBlock Text="Tên cột trong file" Style="{StaticResource ImportLabelStyle}" /><TextBlock Grid.Column="1" Text="Cột này chứa thông tin gì?" Style="{StaticResource ImportLabelStyle}" Margin="12,0" /><TextBlock Grid.Column="2" Text="Ví dụ trong file" Style="{StaticResource ImportLabelStyle}" /></Grid><ItemsControl ItemsSource="{Binding Headers}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,7"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.1*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.1*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding OriginalName}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" /><ComboBox Grid.Column="1" ItemsSource="{Binding FieldOptions}" SelectedItem="{Binding SelectedField, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ImportComboStyle}" Margin="12,0" /><TextBlock Grid.Column="2" Text="{Binding SampleValue}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding SampleValue}" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource SurfaceBrush}"><StackPanel><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Xem trước danh sách" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" /><TextBlock Text="{Binding PreviewLimitText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,3,0,0" /></StackPanel><Button DockPanel.Dock="Right" Command="{Binding ToggleFullPreviewCommand}" Content="Xem đầy đủ thông tin" Style="{StaticResource SecondaryButtonStyle}" MinWidth="160" Visibility="{Binding ShowFullPreviewAction, Converter={StaticResource BooleanToVisibilityConverter}}" /></DockPanel><TextBlock Text="Không có dòng sản phẩm để xem." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,14,0,0" Visibility="{Binding NoPreviewRows, Converter={StaticResource BooleanToVisibilityConverter}}" /><Grid Style="{StaticResource CompactPreviewStyle}" Margin="0,12,0,0" Visibility="{Binding HasPreviewRows, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid ItemsSource="{Binding PreviewRows}" Style="{StaticResource ImportDataGridStyle}" Height="220" EnableRowVirtualization="True" EnableColumnVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Dòng" Binding="{Binding SourceRowNumber}" Width="58" /><DataGridTextColumn Header="Mã sản phẩm" Binding="{Binding ProductCode}" Width="145" /><DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="2*" /><DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="1.2*" /><DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitName}" Width="100" /><DataGridTextColumn Header="Giá bán" Binding="{Binding SalePrice}" Width="105" /><DataGridTextColumn Header="Tồn đầu" Binding="{Binding InitialStock}" Width="100" /></DataGrid.Columns></DataGrid></Grid><DataGrid ItemsSource="{Binding PreviewRows}" Style="{StaticResource ImportDataGridStyle}" Height="220" Margin="0,12,0,0" EnableRowVirtualization="True" EnableColumnVirtualization="True" Visibility="{Binding ShowFullPreview, Converter={StaticResource BooleanToVisibilityConverter}}"><DataGrid.Columns><DataGridTextColumn Header="Dòng" Binding="{Binding SourceRowNumber}" Width="58" /><DataGridTextColumn Header="Mã sản phẩm" Binding="{Binding ProductCode}" Width="145" /><DataGridTextColumn Header="Mã vạch" Binding="{Binding Barcode}" Width="125" /><DataGridTextColumn Header="Tên sản phẩm" Binding="{Binding Name}" Width="180" /><DataGridTextColumn Header="Danh mục" Binding="{Binding CategoryName}" Width="130" /><DataGridTextColumn Header="Đơn vị" Binding="{Binding UnitName}" Width="100" /><DataGridTextColumn Header="Giá bán" Binding="{Binding SalePrice}" Width="105" /><DataGridTextColumn Header="Giá vốn" Binding="{Binding CostPrice}" Width="105" /><DataGridTextColumn Header="Tồn đầu" Binding="{Binding InitialStock}" Width="100" /><DataGridTextColumn Header="Tồn tối thiểu" Binding="{Binding MinimumStock}" Width="110" /><DataGridTextColumn Header="Trạng thái" Binding="{Binding IsActive}" Width="105" /><DataGridTextColumn Header="Ghi chú" Binding="{Binding Notes}" Width="180" /></DataGrid.Columns></DataGrid></StackPanel></Border>

                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding HasIssues, Converter={StaticResource BooleanToVisibilityConverter}}"><StackPanel><DockPanel><TextBlock Text="Điều cần xử lý" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" /><Button DockPanel.Dock="Right" Command="{Binding ToggleIssueDetailsCommand}" Content="Xem chi tiết theo dòng" Style="{StaticResource SecondaryButtonStyle}" MinWidth="160" /></DockPanel><TextBlock Text="{Binding IssueLimitText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,9" /><ItemsControl ItemsSource="{Binding IssueGroups}"><ItemsControl.ItemTemplate><DataTemplate><Border Background="{StaticResource SurfaceBrush}" CornerRadius="7" Padding="10,8" Margin="0,0,0,6"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><TextBlock Text="{Binding Count, StringFormat={}{0:N0}}" Foreground="{StaticResource WarningBrush}" FontSize="15" FontWeight="Bold" Margin="0,0,10,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" /><TextBlock Text="{Binding Summary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0" /></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="{Binding GuidanceText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /><DataGrid ItemsSource="{Binding Issues}" Style="{StaticResource IssueDetailStyle}" Height="170" Margin="0,10,0,0"><DataGrid.Columns><DataGridTextColumn Header="Dòng" Binding="{Binding SourceRow}" Width="70" /><DataGridTextColumn Header="Trường" Binding="{Binding Field}" Width="150" /><DataGridTextColumn Header="Mức độ" Binding="{Binding Severity}" Width="90" /><DataGridTextColumn Header="Cách xử lý" Binding="{Binding Message}" Width="*" /></DataGrid.Columns></DataGrid></StackPanel></Border>

                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource InfoSoftBrush}"><StackPanel><TextBlock Text="Nếu sản phẩm đã tồn tại" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="Bold" /><TextBlock Text="Bạn chọn cách xử lý trước khi bấm nhập. Tồn hiện tại của sản phẩm sẽ không bị thay đổi." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,3,0,10" /><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ComboBox ItemsSource="{Binding DuplicatePolicies}" SelectedItem="{Binding SelectedPolicy, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource ImportComboStyle}" /><TextBlock Grid.Column="1" Text="{Binding PolicyExplanation}" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="14,0,0,0" /></Grid><TextBlock Text="{Binding ConfirmationText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,11,0,0" /></StackPanel></Border>
                        <Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource WarningSoftBrush}" Visibility="{Binding ShowBlockingHint, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="{Binding BlockingHintText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" TextWrapping="Wrap" /></Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Grid Style="{StaticResource ResultStagePanelStyle}"><Border Style="{StaticResource ImportCardStyle}" Background="{StaticResource SurfaceBrush}" VerticalAlignment="Top"><StackPanel HorizontalAlignment="Center" MaxWidth="680"><Border Width="66" Height="66" CornerRadius="33" Style="{StaticResource ResultIconStyle}" HorizontalAlignment="Center"><TextBlock Text="{Binding ResultIconText}" Style="{StaticResource ResultIconTextStyle}" FontSize="34" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding ResultHeadline}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="23" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,15,0,0" /><TextBlock Text="{Binding ResultText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" /><TextBlock Text="{Binding ResultNextStep}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" /></StackPanel></Border></Grid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel Orientation="Horizontal"><Button Command="{Binding CancelCommand}" Content="Hủy" Style="{StaticResource SecondaryButtonStyle}" MinWidth="84" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding ImportAnotherFileCommand}" Content="Đổi file" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" Margin="8,0,0,0" Visibility="{Binding ShowChangeFileAction, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><Button Command="{Binding ChooseFileCommand}" Content="Chọn file Excel/CSV" Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" IsDefault="True" Visibility="{Binding ShowChooseFileAction, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding PreviewCommand}" Content="Kiểm tra lại" Style="{StaticResource PrimaryButtonStyle}" MinWidth="125" IsDefault="True" Visibility="{Binding ShowCheckAction, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding ConfirmImportCommand}" Content="Nhập sản phẩm" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" IsDefault="True" Visibility="{Binding ShowImportAction, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Chỉ ghi dữ liệu sau khi bạn bấm nút này." /><Button Command="{Binding ViewProductsCommand}" Content="Xem danh sách sản phẩm" Style="{StaticResource PrimaryButtonStyle}" MinWidth="185" Visibility="{Binding ShowViewProductsAction, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding ImportAnotherFileCommand}" Content="Nhập file khác" Style="{StaticResource PrimaryButtonStyle}" MinWidth="135" Visibility="{Binding ShowResultRetryAction, Converter={StaticResource BooleanToVisibilityConverter}}" /><Button Command="{Binding CloseCommand}" Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" MinWidth="82" Margin="8,0,0,0" Visibility="{Binding HasImportResult, Converter={StaticResource BooleanToVisibilityConverter}}" /></StackPanel></Grid>
    </Grid>
</Window>
