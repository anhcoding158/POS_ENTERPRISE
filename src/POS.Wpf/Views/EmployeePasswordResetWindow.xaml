<Window x:Class="POS.Wpf.Views.EmployeePasswordResetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cấp lại mật khẩu tạm thời" Width="460" SizeToContent="Height"
        MinWidth="420" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        AutomationProperties.AutomationId="EmployeePasswordResetWindow">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Cấp lại mật khẩu tạm thời" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock Grid.Row="1" Text="Mật khẩu mới chỉ dùng một lần; nhân viên sẽ phải đổi ngay sau khi đăng nhập." TextWrapping="Wrap" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,18"/>
        <TextBlock Grid.Row="2" Text="Mật khẩu tạm thời" Style="{StaticResource AuthLabelStyle}" Margin="0,0,0,5"/>
        <PasswordBox Grid.Row="3" x:Name="TemporaryPasswordInput" Style="{StaticResource AuthPasswordBoxStyle}" AutomationProperties.AutomationId="EmployeeResetTemporaryPassword" PasswordChanged="OnPasswordChanged"/>
        <TextBlock Grid.Row="4" Text="Xác nhận mật khẩu" Style="{StaticResource AuthLabelStyle}" Margin="0,14,0,5"/>
        <PasswordBox Grid.Row="5" x:Name="ConfirmPasswordInput" Style="{StaticResource AuthPasswordBoxStyle}" AutomationProperties.AutomationId="EmployeeResetConfirmPassword" PasswordChanged="OnPasswordChanged"/>
        <TextBlock Grid.Row="6" x:Name="ValidationText" Visibility="Collapsed" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,10,0,0"/>
        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Hủy" AutomationProperties.AutomationId="EmployeeResetCancelButton" Click="OnCancelClick" Style="{StaticResource SecondaryButtonStyle}"/>
            <Button Content="Cấp lại mật khẩu" AutomationProperties.AutomationId="EmployeeResetConfirmButton" Click="OnConfirmClick" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
