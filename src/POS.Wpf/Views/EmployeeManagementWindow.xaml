<Window x:Class="POS.Wpf.Views.EmployeeManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:domain="clr-namespace:POS.Domain.Enums;assembly=POS.Domain"
        Title="Nhân viên và tài khoản" Width="1180" Height="720" MinWidth="1000" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="EmployeeManagementWindow">
    <Window.Resources>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="10,4"/>
            <Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextElement.FontSize" Value="11"/><Setter Property="TextElement.FontWeight" Value="SemiBold"/><Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        </Style>
        <Style x:Key="StatusChipStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/><Style.Triggers><DataTrigger Binding="{Binding EmployeeStatus}" Value="{x:Static domain:EmployeeStatus.Inactive}"><Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource TextSecondaryBrush}"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="AccountChipStyle" TargetType="Border" BasedOn="{StaticResource ChipStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding AccountStatus}" Value="{x:Static domain:AccountStatus.Active}"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding AccountStatus}" Value="{x:Static domain:AccountStatus.Locked}"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding AccountStatus}" Value="{x:Static domain:AccountStatus.Disabled}"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                <DataTrigger Binding="{Binding AccountStatus}" Value="{x:Static domain:AccountStatus.ForcePasswordChange}"><Setter Property="Background" Value="{StaticResource WarningSoftBrush}"/><Setter Property="BorderBrush" Value="{StaticResource GoldBorderBrush}"/><Setter Property="TextElement.Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailVisibilityStyle" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDetailContent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="NoSelectionVisibilityStyle" TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasDetail}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="LoadingVisibilityStyle" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsLoadingState}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ReadOnlyPanelStyle" TargetType="Grid"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><Style x:Key="ReadOnlyInfoCardStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Visible"/><Setter Property="Padding" Value="16"/><Setter Property="Margin" Value="0,0,0,12"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><Style x:Key="ReadOnlyActionStripStyle" TargetType="Border"><Setter Property="Visibility" Value="Visible"/><Setter Property="Background" Value="{StaticResource SurfaceMutedBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/><Setter Property="Padding" Value="12"/><Setter Property="Margin" Value="0,0,0,12"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="EditPanelStyle" TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style><Style x:Key="CreateOnlyVisibilityStyle" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsCreateMode}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style><Style x:Key="SelectedOnlyVisibilityStyle" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding IsCreateMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style><Style x:Key="TrueEmptyOnlyVisibilityStyle" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrueEmployeeDatabaseEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style><Style x:Key="FilteredEmptyOnlyVisibilityStyle" TargetType="FrameworkElement"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsFilteredNoResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style><Style x:Key="EditFooterVisibilityStyle" TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
        <Style x:Key="ModernComboBoxStyle" TargetType="ComboBox"><Setter Property="Height" Value="42"/><Setter Property="Padding" Value="12,0"/><Setter Property="Background" Value="{StaticResource SurfaceBrush}"/><Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="DetailLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource AuthLabelStyle}"><Setter Property="Margin" Value="0,0,0,5"/></Style>
        <Style x:Key="DetailValueStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextStyle}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style x:Key="ModernTabItemStyle" TargetType="TabItem"><Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="14,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Border x:Name="TabBorder" BorderBrush="Transparent" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter Property="Foreground" Value="{StaticResource AccentBrush}"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabBorder" Property="Background" Value="{StaticResource AccentSoftBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    </Window.Resources>
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel><TextBlock Text="Nhân viên và tài khoản" Style="{StaticResource PageTitleTextStyle}" FontSize="27"/><TextBlock Text="Quản lý hồ sơ, tài khoản đăng nhập, vai trò và bảo mật." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0"/><Border Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}" AutomationProperties.AutomationId="EmployeeDirtyState" Background="{StaticResource InfoSoftBrush}" CornerRadius="8" Padding="10,5" Margin="0,10,0,0"><TextBlock Text="{Binding StatusMessage}" AutomationProperties.AutomationId="EmployeeValidationSummary" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/></Border></StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Content="↻  Làm mới" AutomationProperties.AutomationId="EmployeeRefreshButton" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="112"/><Button Content="＋  Thêm nhân viên" AutomationProperties.AutomationId="EmployeeAddButton" Command="{Binding NewEmployeeCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="166" Margin="10,0,0,0"/></StackPanel>
        </Grid>
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,20,0,16">
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,7,0"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource GoldSoftBrush}"><TextBlock Text="♙" FontSize="23" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Tổng nhân viên" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Text="{Binding TotalEmployees, StringFormat={}{0:N0}}" Style="{StaticResource CardValueTextStyle}" Margin="0,1,0,0"/></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="7,0"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource SuccessSoftBrush}"><TextBlock Text="✓" FontSize="22" Foreground="{StaticResource SuccessBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Đang làm việc" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Text="{Binding ActiveEmployees, StringFormat={}{0:N0}}" Style="{StaticResource CardValueTextStyle}" Margin="0,1,0,0"/></StackPanel></StackPanel></Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="7,0,0,0"><StackPanel Orientation="Horizontal"><Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource WarningSoftBrush}"><TextBlock Text="!" FontSize="22" FontWeight="Bold" Foreground="{StaticResource WarningBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0" VerticalAlignment="Center"><TextBlock Text="Tài khoản cần chú ý" Style="{StaticResource SecondaryTextStyle}"/><TextBlock Text="{Binding AccountsNeedingAttention, StringFormat={}{0:N0}}" Style="{StaticResource CardValueTextStyle}" Margin="0,1,0,0"/></StackPanel></StackPanel></Border>
        </UniformGrid>
        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Padding="12" Margin="0,0,0,16"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"><WrapPanel VerticalAlignment="Center"><Grid Width="400" Height="42" Margin="0,0,10,0"><TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBoxWithIconStyle}" AutomationProperties.AutomationId="EmployeeSearchBox"><TextBox.InputBindings><KeyBinding Key="Enter" Command="{Binding SearchCommand}"/></TextBox.InputBindings></TextBox><TextBlock Text="⌕" FontSize="22" Foreground="{StaticResource TextMutedBrush}" Margin="13,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/><TextBlock Text="Tìm theo mã, họ tên, số điện thoại hoặc tên đăng nhập" Foreground="{StaticResource TextMutedBrush}" Margin="42,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding SearchTerm}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid><ComboBox ItemsSource="{Binding EmployeeFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedEmployeeFilter}" AutomationProperties.AutomationId="EmployeeStatusFilter" Style="{StaticResource ModernComboBoxStyle}" Width="180" Margin="0,0,10,0" SelectionChanged="OnFilterChanged"/><ComboBox ItemsSource="{Binding AccountFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAccountFilter}" AutomationProperties.AutomationId="EmployeeAccountFilter" Style="{StaticResource ModernComboBoxStyle}" Width="180" Margin="0,0,10,0" SelectionChanged="OnFilterChanged"/><ComboBox x:Name="EmployeeRoleFilterComboBox" ItemsSource="{Binding RoleFilterOptions}" SelectedItem="{Binding SelectedRoleFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeRoleFilter" Style="{StaticResource ModernComboBoxStyle}" Width="170" Margin="0,0,10,0" SelectionChanged="OnFilterChanged" /><Button AutomationProperties.AutomationId="EmployeeClearFilterButton" Style="{StaticResource SecondaryButtonStyle}" MinWidth="122"><Button.Content><StackPanel Orientation="Horizontal"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="{StaticResource TextSecondaryBrush}" StrokeThickness="1.5" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Xóa bộ lọc"/></StackPanel></Button.Content><Button.Command><Binding Path="ClearFiltersCommand"/></Button.Command></Button></WrapPanel></ScrollViewer></Border>
        <Grid Grid.Row="3"><Grid.ColumnDefinitions><ColumnDefinition Width="1.72*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid Margin="18,15,18,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Grid.Column="0" Text="Danh sách nhân viên" Style="{StaticResource SectionTitleTextStyle}"/></Grid><Grid Grid.Row="1"><DataGrid ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee, Mode=TwoWay}" SelectionChanged="OnSelectionChanged" Style="{StaticResource ModernDataGridStyle}" AutomationProperties.AutomationId="EmployeeList" AlternationCount="2" RowHeight="54" MinRowHeight="54" ColumnHeaderHeight="44"><DataGrid.Columns><DataGridTemplateColumn Header="Mã nhân viên" Width="125" MinWidth="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding EmployeeCode}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EmployeeCode}" VerticalAlignment="Center"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Họ tên" Width="2*" MinWidth="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource AccentSoftBrush}"><TextBlock Text="{Binding Initials}" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding FullName}" Margin="9,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Trạng thái" Width="116" MinWidth="108"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource StatusChipStyle}"><TextBlock Text="{Binding EmployeeStatusText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTemplateColumn Header="Tài khoản" Width="142" MinWidth="130"><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Style="{StaticResource AccountChipStyle}"><TextBlock Text="{Binding AccountStatusText}"/></Border></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="120" MinWidth="100"/><DataGridTextColumn Header="Đăng nhập gần nhất" Binding="{Binding LastLoginText}" Width="146" MinWidth="138"/><DataGridTextColumn Header="Đăng nhập sai" Binding="{Binding FailedLoginText}" Width="92" MinWidth="84"/></DataGrid.Columns></DataGrid><Grid Style="{StaticResource LoadingVisibilityStyle}" Background="{StaticResource SurfaceBrush}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="180" Height="4"/><TextBlock Text="Đang tải danh sách nhân viên..." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Grid><Border Margin="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Padding="12"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource CardStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsTrueEmployeeDatabaseEmpty}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger><DataTrigger Binding="{Binding IsFilteredNoResult}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><Grid MinHeight="180"><StackPanel Style="{StaticResource TrueEmptyOnlyVisibilityStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"><TextBlock Text="⌕" FontSize="30" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Chưa có nhân viên nào" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0"/><TextBlock Text="Thêm nhân viên đầu tiên để bắt đầu quản lý hồ sơ và tài khoản." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Margin="0,8,0,14"/><Button Content="Thêm nhân viên" AutomationProperties.AutomationId="EmployeeEmptyAddButton" Command="{Binding NewEmployeeCommand}" HorizontalAlignment="Center" Style="{StaticResource PrimaryButtonStyle}"/></StackPanel><StackPanel Style="{StaticResource FilteredEmptyOnlyVisibilityStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"><TextBlock Text="⌕" FontSize="30" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center"/><TextBlock Text="Không tìm thấy nhân viên phù hợp" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,0" TextAlignment="Center"/><TextBlock Text="Thử thay đổi từ khóa hoặc xóa bộ lọc." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" Margin="0,0,0,14"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button AutomationProperties.AutomationId="EmployeeFilteredEmptyClearButton" Style="{StaticResource PrimaryButtonStyle}" Command="{Binding ClearFiltersCommand}"><Button.Content><StackPanel Orientation="Horizontal"><Path Data="M 2,2 L 10,10 M 10,2 L 2,10" Stroke="White" StrokeThickness="1.5" Width="12" Height="12" Margin="0,0,7,0"/><TextBlock Text="Xóa bộ lọc"/></StackPanel></Button.Content></Button><Button Content="Thêm nhân viên" AutomationProperties.AutomationId="EmployeeFilteredEmptyAddButton" Command="{Binding NewEmployeeCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></StackPanel></Grid></ScrollViewer></Border></Grid><Grid Grid.Row="2" Margin="18,10,18,14"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Số dòng:" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/><ComboBox ItemsSource="{Binding PageSizeOptions}" SelectedItem="{Binding SelectedPageSize}" Style="{StaticResource ModernComboBoxStyle}" Width="78" Height="34" Margin="7,0,12,0" AutomationProperties.AutomationId="EmployeePageSize"/><TextBlock Text="{Binding PageNumberText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="«" AutomationProperties.AutomationId="EmployeeFirstPageButton" Command="{Binding FirstPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="34" Padding="0"/><Button Content="‹" AutomationProperties.AutomationId="EmployeePreviousPageButton" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="34" Padding="0" Margin="6,0,0,0"/><Button Content="›" AutomationProperties.AutomationId="EmployeeNextPageButton" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="34" Padding="0" Margin="6,0,0,0"/><Button Content="»" AutomationProperties.AutomationId="EmployeeLastPageButton" Command="{Binding LastPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="34" Padding="0" Margin="6,0,0,0"/></StackPanel></Grid></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="0"><Grid><Border Style="{StaticResource NoSelectionVisibilityStyle}" Padding="26"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="58" Height="58" CornerRadius="29" Background="{StaticResource SurfaceMutedBrush}"><TextBlock Text="♙" FontSize="29" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="Chọn một nhân viên" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,5"/><TextBlock Text="Thông tin hồ sơ và tài khoản sẽ hiển thị tại đây." TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource SecondaryTextStyle}" MaxWidth="260"/></StackPanel></Border><Grid Style="{StaticResource LoadingVisibilityStyle}" Background="{StaticResource SurfaceBrush}"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><ProgressBar IsIndeterminate="True" Width="150" Height="4"/><TextBlock Text="Đang tải thông tin..." Style="{StaticResource SecondaryTextStyle}" Margin="0,12,0,0"/></StackPanel></Grid><Grid Style="{StaticResource DetailVisibilityStyle}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid Margin="18,18,18,0">
                <Grid Style="{StaticResource CreateOnlyVisibilityStyle}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="Thêm nhân viên" FontSize="19" FontWeight="SemiBold"/>
                        <TextBlock Text="Nhập thông tin hồ sơ trước. Tài khoản đăng nhập có thể tạo ở bước tiếp theo." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" MaxWidth="300" Margin="0,4,0,0"/>
                    </StackPanel>
                    <Button Grid.Column="1" x:Name="EmployeeCreateCloseButton" Content="×" AutomationProperties.AutomationId="EmployeeCreateCloseButton" Click="OnCreateCloseClick" Style="{StaticResource SecondaryButtonStyle}" Width="34" Height="34" Padding="0" VerticalAlignment="Top"/>
                </Grid>
                <Grid Style="{StaticResource SelectedOnlyVisibilityStyle}">
                    <Border x:Name="EmployeeIdentityHeader" AutomationProperties.AutomationId="EmployeeIdentityHeader" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="0"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="{StaticResource AccentBrush}" VerticalAlignment="Top">
                                <TextBlock Text="{Binding SelectedInitials}" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel x:Name="EmployeeIdentityTextBlock" Grid.Column="1" Margin="12,1,14,0" VerticalAlignment="Center" MinWidth="0">
                                <TextBlock Text="{Binding FullName}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullName}"/>
                                <TextBlock Text="{Binding EmployeeCode}" Style="{StaticResource SecondaryTextStyle}" Margin="0,3,0,0" TextWrapping="Wrap" ToolTip="{Binding EmployeeCode}"/>
                                <TextBlock Text="{Binding UsernameText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding UsernameText}"/>
                            </StackPanel>
                            <Border x:Name="EmployeeIdentityStatusCard" Grid.Column="2" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8">
                                <StackPanel>
                                    <TextBlock Text="Nhân viên" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold"/>
                                    <Border Style="{StaticResource StatusChipStyle}" Margin="0,4,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding EmployeeStatusText}" TextWrapping="Wrap"/>
                                    </Border>
                                    <TextBlock Text="Tài khoản" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" Margin="0,8,0,0"/>
                                    <Border Style="{StaticResource AccountChipStyle}" Margin="0,4,0,0" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding AccountStatusText}" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
                <TabControl Grid.Row="1" Margin="14,14,14,14" BorderThickness="0" Background="Transparent" SelectedIndex="{Binding SelectedDetailTabIndex, Mode=TwoWay}" ItemContainerStyle="{StaticResource ModernTabItemStyle}">
                                        <TabItem Header="Hồ sơ" AutomationProperties.AutomationId="EmployeeProfileTab"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="4,14,4,4"><StackPanel>
    <Border x:Name="EmployeeProfileInformationCard" AutomationProperties.AutomationId="EmployeeProfileInformationCard" Style="{StaticResource ReadOnlyInfoCardStyle}">
        <StackPanel>
            <TextBlock Text="Thông tin hồ sơ" FontSize="15" FontWeight="SemiBold"/>
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="126"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Họ tên" Style="{StaticResource DetailLabelStyle}" Margin="0,0,12,12"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FullName}" Style="{StaticResource DetailValueStyle}" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="1" Text="Số điện thoại" Style="{StaticResource DetailLabelStyle}" Margin="0,0,12,12"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PhoneDisplayText}" Style="{StaticResource DetailValueStyle}" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="2" Text="Email" Style="{StaticResource DetailLabelStyle}" Margin="0,0,12,12"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding EmailDisplayText}" Style="{StaticResource DetailValueStyle}" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="3" Text="Mã nhân viên" Style="{StaticResource DetailLabelStyle}" Margin="0,0,12,12"/>
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EmployeeCode}" Style="{StaticResource DetailValueStyle}" TextTrimming="CharacterEllipsis" ToolTip="{Binding EmployeeCode}" Margin="0,0,0,12"/>
                <TextBlock Grid.Row="4" Text="Trạng thái làm việc" Style="{StaticResource DetailLabelStyle}" Margin="0,0,12,0"/>
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding EmployeeStatusText}" Style="{StaticResource DetailValueStyle}"/>
            </Grid>
        </StackPanel>
    </Border>
    <Border x:Name="EmployeeProfileActionStrip" AutomationProperties.AutomationId="EmployeeProfileActionStrip" Style="{StaticResource ReadOnlyActionStripStyle}">
        <WrapPanel HorizontalAlignment="Right">
            <Button Content="✎  Chỉnh sửa hồ sơ" AutomationProperties.AutomationId="EmployeeEditButton" Command="{Binding EditProfileCommand}" Style="{StaticResource SecondaryButtonStyle}"/>
