    <Grid Style="{StaticResource EditPanelStyle}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="{Binding EditorTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/><TextBlock Text="Hồ sơ nhân viên" Grid.Row="1" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/><TextBlock Text="Mã nhân viên *" Grid.Row="2" Style="{StaticResource DetailLabelStyle}"/><TextBox Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeCodeField" Style="{StaticResource SearchTextBoxStyle}" Grid.Row="3" MaxLength="30"/><TextBlock Text="Họ tên *" Grid.Row="4" Style="{StaticResource DetailLabelStyle}" Margin="0,13,0,5"/><TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeFullNameField" Style="{StaticResource SearchTextBoxStyle}" Grid.Row="5" MaxLength="150"/><TextBlock Text="Số điện thoại" Grid.Row="6" Style="{StaticResource DetailLabelStyle}" Margin="0,13,0,5"/><TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeePhoneField" Style="{StaticResource SearchTextBoxStyle}" Grid.Row="7" MaxLength="30"/><TextBlock Text="Email" Grid.Row="8" Style="{StaticResource DetailLabelStyle}" Margin="0,13,0,5"/><TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeEmailField" Style="{StaticResource SearchTextBoxStyle}" Grid.Row="9" MaxLength="254"/><Border Grid.Row="10" Style="{StaticResource CreateOnlyVisibilityStyle}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Marg