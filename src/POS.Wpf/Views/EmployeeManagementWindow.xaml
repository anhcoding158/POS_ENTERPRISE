<Window
    x:Class="POS.Wpf.Views.EmployeeManagementWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Nhân viên và tài khoản"
    Width="1320"
    Height="780"
    MinWidth="1050"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    AutomationProperties.AutomationId="EmployeeManagementWindow">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Nhân viên và tài khoản" Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock Text="Quản lý hồ sơ nhân viên, tài khoản đăng nhập, vai trò và trạng thái bảo mật." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Làm mới" AutomationProperties.AutomationId="EmployeeRefreshButton" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="95" />
                <Button Content="Thêm nhân viên" AutomationProperties.AutomationId="EmployeeAddButton" Command="{Binding NewEmployeeCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="140" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="12" Margin="0,18,0,14">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="190" /><ColumnDefinition Width="190" /><ColumnDefinition Width="180" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeSearchBox" Style="{StaticResource SearchTextBoxStyle}" Height="38" VerticalContentAlignment="Center" ToolTip="Mã, tên, số điện thoại hoặc tên đăng nhập" />
                <ComboBox Grid.Column="1" ItemsSource="{Binding EmployeeFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedEmployeeFilter}" AutomationProperties.AutomationId="EmployeeStatusFilter" Margin="10,0,0,0" />
                <ComboBox Grid.Column="2" ItemsSource="{Binding AccountFilters}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedAccountFilter}" AutomationProperties.AutomationId="EmployeeAccountFilter" Margin="10,0,0,0" />
                <ComboBox Grid.Column="3" ItemsSource="{Binding RoleOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedRoleFilter}" AutomationProperties.AutomationId="EmployeeRoleFilter" Margin="10,0,0,0" />
                <Button Grid.Column="4" Content="Tìm kiếm" AutomationProperties.AutomationId="EmployeeSearchButton" Command="{Binding SearchCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="100" Margin="10,0,0,0" />
            </Grid>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="430" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Danh sách nhân viên" Style="{StaticResource SectionTitleTextStyle}" Margin="18,16,18,12" />
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Employees}" SelectedItem="{Binding SelectedEmployee}" SelectionChanged="OnSelectionChanged" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" AutomationProperties.AutomationId="EmployeeList" Margin="10,0,10,0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Mã" Binding="{Binding EmployeeCode}" Width="90" />
                            <DataGridTextColumn Header="Họ tên" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="Nhân viên" Binding="{Binding EmployeeStatusText}" Width="112" />
                            <DataGridTextColumn Header="Tài khoản" Binding="{Binding AccountStatusText}" Width="125" />
                            <DataGridTextColumn Header="Vai trò" Binding="{Binding RoleText}" Width="105" />
                            <DataGridTextColumn Header="Đăng nhập cuối" Binding="{Binding LastLoginText}" Width="130" />
                            <DataGridTextColumn Header="Sai" Binding="{Binding FailedLoginAttempts}" Width="45" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <Grid Grid.Row="2" Margin="18,10,18,14">
                        <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="‹" AutomationProperties.AutomationId="EmployeePreviousPageButton" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="36" />
                            <Button Content="›" AutomationProperties.AutomationId="EmployeeNextPageButton" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="36" Margin="6,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="{Binding EditorTitle}" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock Text="{Binding DirtyStateText}" AutomationProperties.AutomationId="EmployeeDirtyState" TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding StatusMessage}" AutomationProperties.AutomationId="EmployeeValidationSummary" TextWrapping="Wrap" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,12" />
                        <TextBlock Text="Mã nhân viên *" Style="{StaticResource AuthLabelStyle}" />
                        <TextBox Text="{Binding EmployeeCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeCodeField" MaxLength="30" />
                        <TextBlock Text="Họ tên *" Style="{StaticResource AuthLabelStyle}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeFullNameField" MaxLength="150" />
                        <TextBlock Text="Số điện thoại" Style="{StaticResource AuthLabelStyle}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeePhoneField" MaxLength="30" />
                        <TextBlock Text="Email" Style="{StaticResource AuthLabelStyle}" Margin="0,12,0,4" />
                        <TextBox Text="{Binding EmailAddress, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeEmailField" MaxLength="254" />
                        <Button Content="Lưu hồ sơ" AutomationProperties.AutomationId="EmployeeSaveButton" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,16,0,0" />
                        <Separator Margin="0,18,0,14" />
                        <TextBlock Text="TÀI KHOẢN VÀ BẢO MẬT" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                        <CheckBox Content="Tạo tài khoản ngay" IsChecked="{Binding CreateAccount}" AutomationProperties.AutomationId="EmployeeCreateAccountCheckBox" Margin="0,10,0,0" />
                        <TextBlock Text="Tên đăng nhập" Style="{StaticResource AuthLabelStyle}" Margin="0,10,0,4" />
                        <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeUsernameField" MaxLength="50" IsEnabled="{Binding ShowAccountEditor}" />
                        <TextBlock Text="Vai trò" Style="{StaticResource AuthLabelStyle}" Margin="0,10,0,4" />
                        <ComboBox ItemsSource="{Binding RoleOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedRole}" AutomationProperties.AutomationId="EmployeeRoleEditor" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <PasswordBox x:Name="AccountPasswordInput" AutomationProperties.AutomationId="EmployeeTemporaryPassword" Width="210" ToolTip="Mật khẩu tạm thời" PasswordChanged="OnAccountPasswordChanged" />
                            <Button Content="Tạo tài khoản" AutomationProperties.AutomationId="EmployeeCreateAccountButton" Command="{Binding CreateAccountCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <PasswordBox x:Name="ResetPasswordInput" AutomationProperties.AutomationId="EmployeeResetPasswordField" Width="210" ToolTip="Mật khẩu tạm thời mới" PasswordChanged="OnResetPasswordChanged" />
                            <Button Content="Đặt lại mật khẩu" AutomationProperties.AutomationId="EmployeeResetPasswordButton" Command="{Binding ResetPasswordCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="{Binding ToggleLockText}" AutomationProperties.AutomationId="EmployeeLockToggleButton" Click="OnToggleLockClick" Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="{Binding ToggleActiveText}" AutomationProperties.AutomationId="EmployeeActiveToggleButton" Click="OnToggleActiveClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                        </StackPanel>
                        <Button Content="Cập nhật vai trò" AutomationProperties.AutomationId="EmployeeChangeRoleButton" Command="{Binding ChangeRoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding EmployeeStatusText}" Margin="0,18,0,0" />
                        <TextBlock Text="{Binding AccountStatusText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding LastLoginText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding FailedLoginText}" Margin="0,4,0,0" />
                        <TextBlock Text="{Binding EffectivePermissionsText}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
