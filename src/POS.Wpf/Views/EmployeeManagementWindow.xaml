n="0,10,0,0"><Button Content="{Binding ToggleLockText}" AutomationProperties.AutomationId="EmployeeLockToggleButton" Click="OnToggleLockClick" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="{Binding ToggleActiveText}" AutomationProperties.AutomationId="EmployeeActiveToggleButton" Click="OnToggleActiveClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></StackPanel><StackPanel Visibility="{Binding ShowAccountEditor, Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,12,0,0"><Border Style="{StaticResource CardStyle}" Padding="14"><StackPanel><TextBlock Text="Tạo tài khoản" FontWeight="SemiBold" FontSize="14"/><TextBlock Text="Mật khẩu tạm thời sẽ buộc đổi ở lần đăng nhập đầu tiên." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,5,0,13"/><TextBlock Text="Tên đăng nhập" Style="{StaticResource DetailLabelStyle}"/><TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="EmployeeUsernameField" Style="{StaticResource SearchTextBoxStyle}"/><TextBlock Text="Vai trò" Style="{StaticResource DetailLabelStyle}" Margin="0,13,0,5"/><ComboBox ItemsSource="{Binding RoleOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedRole}" AutomationProperties.AutomationId="EmployeeRoleEditor" Style="{StaticResource ModernComboBoxStyle}"/><TextBlock Text="Mật khẩu tạm thời" Style="{StaticResource DetailLabelStyle}" Margin="0,13,0,5"/><PasswordBox x:Name="AccountPasswordInput" Style="{StaticResource AuthPasswordBoxStyle}" AutomationProperties.AutomationId="EmployeeTemporaryPassword" PasswordChanged="OnAccountPasswordChanged"/><StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button Content="Hủy" Command="{Binding CancelEditCommand}" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Tạo tài khoản" AutomationProperties.AutomationId="EmployeeCreateAccountButton" Command="{Binding CreateAccountCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></StackPanel><StackPanel Visibility="{Binding HasSelection, Converter={StaticResource BooleanToVisibilityConverter}}"><TextBlock Text="Nhân viên này chưa có tài khoản đăng nhập." TextWrapping="Wrap" Margin="0,12,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource SecondaryTextStyle}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasAccount}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock><Button Content="Tạo tài khoản" AutomationProperties.AutomationId="EmployeeBeginCreateAccountButton" HorizontalAlignment="Left" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}"><Setter Property="Visibility" Value="Collapsed"/><Setter Property="Command" Value="{Binding BeginCreateAccountCommand}"/><Style.Triggers><DataTrigger Binding="{Binding HasAccount}" Value="False"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></StackPanel></ScrollViewer></TabItem>
                    <TabItem Header="Vai trò &amp; quyền hạn" AutomationProperties.AutomationId="EmployeePermissionsTab"><ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,14,4,4"><StackPanel><Border Style="{StaticResource CardStyle}" Padding="14"><StackPanel><TextBlock Text="Vai trò hiện tại" Style="{StaticResource DetailLabelStyle}"/><TextBlock Text="{Binding RoleText}" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Quyền hiệu lực được lấy từ danh mục vai trò hiện tại." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0"/></StackPanel></Border><ItemsControl ItemsSource="{Binding PermissionGroups}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,8"><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"/><ItemsControl ItemsSource="{Binding Permissions}" Margin="0,6,0,0"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Style="{StaticResource SecondaryTextStyle}" Margin="0,2,0,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel Orientation="Horizontal" Visibility="{Binding HasAccount, Converter={StaticResource BooleanToVisibilityConverter}}"><ComboBox ItemsSource="{Binding RoleOptions}" DisplayMemberPath="DisplayName" SelectedItem="{Binding SelectedRole}" Style="{StaticResource ModernComboBoxStyle}" Width="170" AutomationProperties.AutomationId="EmployeeRoleAction"/><Button Content="Cập nhật vai trò" AutomationProperties.AutomationId="EmployeeChangeRoleButton" Click="OnChangeRoleClick" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></StackPanel></ScrollViewer></TabItem>
