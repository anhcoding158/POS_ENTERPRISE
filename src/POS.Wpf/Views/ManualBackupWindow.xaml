<Window x:Class="POS.Wpf.Views.ManualBackupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sao lưu dữ liệu"
        Width="740" Height="700" MinWidth="660" MinHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Sao lưu dữ liệu" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Margin="0,8,0,0"
                       Text="Tạo backup SQLite đã verify, không ghi đè file có sẵn và chỉ báo thành công sau khi file đích đã được kiểm chứng."
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="13" TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" Margin="0,22,0,18" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Padding="18" Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="Thông tin minh bạch" FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBlock Margin="0,12,0,0" FontSize="13"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" LineHeight="21">
                            <Run Text="• Chọn thư mục đích để lưu backup." />
                            <LineBreak />
                            <Run Text="• File backup được tạo bằng cơ chế SQLite online backup và verify lại trước khi thành công." />
                            <LineBreak />
                            <Run Text="• Nếu không verify được, file tạm do lượt chạy này tạo sẽ được dọn." />
                            <LineBreak />
                            <Run Text="• Không dùng File.Copy trên live database." />
                        </TextBlock>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,20,0,8" Text="Thư mục lưu"
                           FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" />

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding DestinationDisplay, Mode=OneWay}"
                             IsReadOnly="True"
                             IsEnabled="{Binding CanPickDestination}"
                             Style="{StaticResource SearchTextBoxStyle}"
                             KeyboardNavigation.TabIndex="1" />
                    <Button Grid.Column="1" Margin="10,0,0,0" MinWidth="132"
                            Content="Chọn thư mục"
                            Command="{Binding PickDestinationCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            KeyboardNavigation.TabIndex="2" />
                </Grid>

                <CheckBox Margin="0,18,0,0"
                          Content="Tôi đã đọc và đồng ý tạo backup dữ liệu đã verify."
                          IsChecked="{Binding ConsentAccepted, Mode=TwoWay}"
                          IsEnabled="{Binding CanChangeConsent}"
                          Foreground="{StaticResource TextPrimaryBrush}"
                          FontSize="13"
                          KeyboardNavigation.TabIndex="3" />

                <ProgressBar Margin="0,20,0,0" Height="8"
                             IsIndeterminate="{Binding IsProgressIndeterminate}"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <Border Margin="0,18,0,0" Padding="14"
                        Background="{StaticResource SurfaceMutedBrush}"
                        CornerRadius="9">
                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" FontSize="13"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   Text="{Binding CompletedAtText, StringFormat=Hoàn tất: {0}}"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SuccessBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding BackupSizeText, StringFormat=Dung lượng: {0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding BackupSha256Text, StringFormat=SHA-256: {0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding BackupPath, StringFormat=Đường dẫn: {0}}"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="1" Margin="0,0,10,0" MinWidth="105"
                    Content="Tạo lại"
                    Command="{Binding ResetCommand}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    KeyboardNavigation.TabIndex="5" />
            <Button Grid.Column="2" Margin="0,0,10,0" MinWidth="105"
                    Content="Đóng"
                    Click="OnCloseClick"
                    IsCancel="True"
                    Visibility="{Binding ShowCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    KeyboardNavigation.TabIndex="6" />
            <Button Grid.Column="3" MinWidth="130"
                    Content="Sao lưu dữ liệu"
                    Command="{Binding BackupCommand}"
                    IsDefault="True"
                    Visibility="{Binding ShowBackupButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    KeyboardNavigation.TabIndex="4" />
        </Grid>
    </Grid>
</Window>
