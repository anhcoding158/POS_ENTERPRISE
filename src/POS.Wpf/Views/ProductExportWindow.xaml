<Window x:Class="POS.Wpf.Views.ProductExportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xuất dữ liệu" Width="560" Height="430" MinWidth="500" MinHeight="360"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize" ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="XUẤT DỮ LIỆU" Foreground="{StaticResource GoldBrush}" FontFamily="Georgia" FontWeight="SemiBold" FontSize="13"/>
            <TextBlock Text="Chọn dữ liệu cần xuất" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Georgia" FontWeight="Bold" FontSize="25" Margin="0,4,0,0"/>
            <TextBlock Text="Tệp được tạo theo phạm vi và quyền hiện tại. Không làm thay đổi dữ liệu trong cửa hàng." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Margin="0,24,0,18">
            <TextBlock Text="Loại dữ liệu" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Reports}" SelectedItem="{Binding SelectedReport}" DisplayMemberPath="DisplayName" Height="40" Margin="0,6,0,0" Padding="10,4"/>
            <TextBlock Text="{Binding SelectedDescription}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,0,18"/>
            <TextBlock Text="Định dạng" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="DisplayName" Height="40" Margin="0,6,0,0" Padding="10,4"/>
            <Border Background="{StaticResource InfoSoftBrush}" CornerRadius="8" Padding="12" Margin="0,20,0,0">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </Border>
        </StackPanel>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Command="{Binding CloseCommand}" Content="Đóng" Style="{StaticResource SecondaryButtonStyle}" MinWidth="90" Margin="0,0,10,0"/>
            <Button Command="{Binding ExportCommand}" Content="Xuất file" Style="{StaticResource PrimaryButtonStyle}" MinWidth="130"/>
        </StackPanel>
    </Grid>
</Window>
