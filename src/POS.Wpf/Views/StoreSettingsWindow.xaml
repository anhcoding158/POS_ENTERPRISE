<Window
    x:Class="POS.Wpf.Views.StoreSettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Cài đặt cửa hàng"
    Width="1040"
    Height="760"
    MinWidth="820"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    Loaded="OnWindowLoaded">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock
                    Text="Cài đặt cửa hàng"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    Margin="0,6,0,0"
                    Text="Cài đặt những gì cửa hàng cần cho việc bán hàng và in hóa đơn."
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontSize="13" />
                <TextBlock
                    Margin="0,10,0,0"
                    Text="{Binding ValidationSummary}"
                    TextWrapping="Wrap"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    AutomationProperties.AutomationId="StoreSetupValidationSummary" />
            </StackPanel>
            <Border
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Padding="12,7"
                Background="{StaticResource SurfaceMutedBrush}"
                CornerRadius="8">
                <TextBlock
                    Text="{Binding SaveStateText}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    FontWeight="SemiBold"
                    AutomationProperties.AutomationId="StoreSetupSaveState" />
            </Border>
        </Grid>

        <ScrollViewer
            Grid.Row="1"
            Margin="0,20,0,18"
            VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource CardStyle}"
                    Padding="22"
                    Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock
                                Text="Thông tin cửa hàng"
                                Style="{StaticResource SectionTitleTextStyle}" />
                            <TextBlock
                                Margin="0,4,0,18"
                                Text="Thông tin này sẽ xuất hiện trên hóa đơn."
                                Foreground="{StaticResource TextSecondaryBrush}" />
                            <TextBlock Text="Tên cửa hàng" Style="{StaticResource AuthLabelStyle}" />
                            <TextBox
                                Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.AutomationId="StoreSetupStoreName"
                                ToolTip="Tên cửa hàng là bắt buộc" />
                            <TextBlock
                                Text="{Binding StoreNameValidationMessage}"
                                Style="{StaticResource ValidationErrorTextStyle}" />

                            <TextBlock Text="Địa chỉ" Style="{StaticResource AuthLabelStyle}" Margin="0,14,0,7" />
                            <TextBox
                                Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.AutomationId="StoreSetupAddress"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                MinHeight="54" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="Số điện thoại" Style="{StaticResource AuthLabelStyle}" />
                                    <TextBox
                                        Text="{Binding Hotline, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.AutomationId="StoreSetupPhone" />
                                    <TextBlock
                                        Text="{Binding HotlineValidationMessage}"
                                        Style="{StaticResource ValidationErrorTextStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Mã số thuế" Style="{StaticResource AuthLabelStyle}" />
                                    <TextBox
                                        Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.AutomationId="StoreSetupTaxCode" />
                                    <TextBlock
                                        Text="{Binding TaxCodeValidationMessage}"
                                        Style="{StaticResource ValidationErrorTextStyle}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <Border
                            Grid.Column="1"
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="12"
                            Padding="16"
                            VerticalAlignment="Top">
                            <StackPanel>
                                <TextBlock Text="Logo cửa hàng" Style="{StaticResource AuthLabelStyle}" />
                                <Border
                                    Width="170"
                                    Height="130"
                                    Margin="0,2,0,14"
                                    Background="{StaticResource SurfaceBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Image
                                        Source="{Binding LogoPath}"
                                        Stretch="Uniform"
                                        Margin="12"
                                        AutomationProperties.AutomationId="StoreSetupLogoPreview" />
                                </Border>
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Content="Chọn logo"
                                        Command="{Binding ReplaceLogoCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="StoreSetupChooseLogo" />
                                    <Button
                                        Content="Xóa logo"
                                        Margin="8,0,0,0"
                                        Command="{Binding RemoveLogoCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        AutomationProperties.AutomationId="StoreSetupRemoveLogo" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Padding="22"
                    Margin="0,0,8,16">
                    <StackPanel>
                        <TextBlock Text="Hóa đơn và in ấn" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Margin="0,4,0,18"
                            Text="Chọn máy in và cách in phù hợp với quầy thu ngân."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />

                        <TextBlock Text="Khổ giấy" Style="{StaticResource AuthLabelStyle}" />
                        <ComboBox
                            SelectedValuePath="Tag"
                            SelectedValue="{Binding PaperSize, Mode=TwoWay}"
                            AutomationProperties.AutomationId="StoreSetupPaperSize">
                            <ComboBoxItem Tag="K80" Content="K80 — máy in hóa đơn 80 mm" />
                        </ComboBox>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Số bản in" Style="{StaticResource AuthLabelStyle}" />
                                <ComboBox
                                    ItemsSource="{Binding PrintCopyOptions}"
                                    SelectedItem="{Binding PrintCopyCount, Mode=TwoWay}"
                                    AutomationProperties.AutomationId="StoreSetupPrintCopies" />
                            </StackPanel>
                            <CheckBox
                                Grid.Column="1"
                                Content="Tự động in sau khi thanh toán"
                                IsChecked="{Binding AutoPrint}"
                                VerticalAlignment="Bottom"
                                Margin="8,0,0,9"
                                AutomationProperties.AutomationId="StoreSetupAutoPrint" />
                        </Grid>

                        <TextBlock Text="Máy in hóa đơn" Style="{StaticResource AuthLabelStyle}" Margin="0,16,0,7" />
                        <ComboBox
                            ItemsSource="{Binding Printers}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Name"
                            SelectedValue="{Binding DefaultPrinter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.AutomationId="StoreSetupPrinter" />
                        <TextBlock
                            Text="{Binding PrinterSelectionWarning}"
                            Style="{StaticResource ValidationErrorTextStyle}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{Binding PrinterDiscoveryMessage}"
                            Margin="0,7,0,0"
                            Foreground="{StaticResource TextSecondaryBrush}"
                            AutomationProperties.AutomationId="StoreSetupPrinterResult" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button
                                Content="Quét lại máy in"
                                Command="{Binding RefreshPrintersCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="StoreSetupRefreshPrinters" />
                            <Button
                                Content="Kiểm tra máy in"
                                Margin="8,0,0,0"
                                Command="{Binding TestPrinterCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                AutomationProperties.AutomationId="StoreSetupTestPrinter" />
                            <Button
                                Content="In thử"
                                Margin="8,0,0,0"
                                Command="{Binding PrintTestReceiptCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                AutomationProperties.AutomationId="StoreSetupPrintTest" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Padding="22"
                    Margin="8,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Thiết bị bán hàng" Style="{StaticResource SectionTitleTextStyle}" />
                        <TextBlock
                            Margin="0,4,0,18"
                            Text="Máy quét mã vạch USB thường dùng được ngay, không cần cài đặt."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <Border
                            Background="{StaticResource AccentSoftBrush}"
                            BorderBrush="{StaticResource AccentBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="14">
                            <StackPanel>
                                <TextBlock
                                    Text="{Binding ScannerStatusText}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource AccentBrush}" />
                                <TextBlock
                                    Text="{Binding ScannerInstructionText}"
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Button
                                    Content="Quét thử mã"
                                    Command="{Binding ScannerTest.StartCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,12,0,0"
                                    AutomationProperties.AutomationId="StoreSetupScannerTest" />
                                <TextBox
                                    x:Name="StoreSetupScannerCapture"
                                    Text="{Binding ScannerTest.CaptureText, UpdateSourceTrigger=PropertyChanged}"
                                    Visibility="{Binding ScannerTest.IsListening, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    AutomationProperties.AutomationId="StoreSetupScannerCapture"
                                    Margin="0,12,0,0"
                                    ToolTip="Quét mã vào ô này rồi nhấn Enter"
                                    PreviewKeyDown="OnScannerCaptureKeyDown" />
                                <TextBlock
                                    Text="{Binding ScannerTest.StatusMessage}"
                                    Margin="0,9,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    AutomationProperties.AutomationId="StoreSetupScannerStatus" />
                                <Button
                                    Content="Hủy kiểm tra"
                                    Command="{Binding ScannerTest.CancelCommand}"
                                    Visibility="{Binding ScannerTest.IsListening, Converter={StaticResource BooleanToVisibilityConverter}}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Margin="0,8,0,0"
                                    AutomationProperties.AutomationId="StoreSetupScannerCancel" />
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{StaticResource SurfaceMutedBrush}"
                            CornerRadius="10"
                            Padding="14"
                            Margin="0,16,0,0">
                            <StackPanel>
                                <TextBlock Text="{Binding RegionalSettingsText}" FontWeight="SemiBold" />
                                <TextBlock
                                    Text="{Binding TimeZoneDisplay}"
                                    Margin="0,4,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Expander
                    Grid.Row="2"
                    Grid.ColumnSpan="2"
                    Header="Thiết lập nâng cao"
                    IsExpanded="False"
                    Margin="0,0,0,8"
                    AutomationProperties.AutomationId="StoreSetupAdvanced">
                    <Border Style="{StaticResource CardStyle}" Padding="22" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="Thư mục dữ liệu" Style="{StaticResource AuthLabelStyle}" />
                                <TextBox
                                    Text="{Binding DatabaseDirectory, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="StoreSetupDatabaseDirectory" />
                                <TextBlock
                                    Text="Chỉ thay đổi khi quản trị viên hoặc bộ phận hỗ trợ yêu cầu."
                                    Margin="0,5,0,0"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="Thư mục sao lưu" Style="{StaticResource AuthLabelStyle}" />
                                <TextBox
                                    Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.AutomationId="StoreSetupBackupDirectory" />
                                <TextBlock Text="Giữ lại bản gần nhất" Style="{StaticResource AuthLabelStyle}" Margin="0,14,0,7" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="72"
                                        ItemsSource="{Binding BackupRetentionOptions}"
                                        SelectedItem="{Binding LatestRetention, Mode=TwoWay}"
                                        AutomationProperties.AutomationId="StoreSetupLatestRetention" />
                                    <TextBlock Text=" bản" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Text="Theo tuần / theo tháng" Style="{StaticResource AuthLabelStyle}" Margin="0,14,0,7" />
                                <StackPanel Orientation="Horizontal">
                                    <ComboBox
                                        Width="72"
                                        ItemsSource="{Binding WeeklyRetentionOptions}"
                                        SelectedItem="{Binding WeeklyRetention, Mode=TwoWay}"
                                        AutomationProperties.AutomationId="StoreSetupWeeklyRetention" />
                                    <TextBlock Text=" tuần" VerticalAlignment="Center" Margin="8,0,14,0" />
                                    <ComboBox
                                        Width="72"
                                        ItemsSource="{Binding MonthlyRetentionOptions}"
                                        SelectedItem="{Binding MonthlyRetention, Mode=TwoWay}"
                                        AutomationProperties.AutomationId="StoreSetupMonthlyRetention" />
                                    <TextBlock Text=" tháng" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Expander>
            </Grid>
        </ScrollViewer>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    Text="{Binding StatusMessage}"
                    Foreground="{StaticResource TextSecondaryBrush}"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="StoreSetupStatus" />
                <TextBlock
                    Text="{Binding RestartMessage}"
                    Visibility="{Binding RestartRequired, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Foreground="{StaticResource WarningBrush}"
                    Margin="0,4,0,0"
                    TextWrapping="Wrap"
                    AutomationProperties.AutomationId="StoreSetupRestartMessage" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                VerticalAlignment="Center">
                <Button
                    Content="Bỏ thay đổi"
                    Click="OnCancelClick"
                    Style="{StaticResource SecondaryButtonStyle}"
                    AutomationProperties.AutomationId="StoreSetupCancel" />
                <Button
                    Content="Lưu thay đổi"
                    Command="{Binding SaveCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Margin="10,0,0,0"
                    AutomationProperties.AutomationId="StoreSetupSave" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
