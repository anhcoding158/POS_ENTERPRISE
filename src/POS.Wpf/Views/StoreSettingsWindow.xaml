<Window x:Class="POS.Wpf.Views.StoreSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cài đặt cửa hàng" Width="980" Height="760" MinWidth="760" MinHeight="620"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="Cài đặt cửa hàng" Style="{StaticResource PageTitleTextStyle}"/>
            <TextBlock Margin="0,5,0,0" Text="Chỉ Quản trị viên được thay đổi cấu hình dùng cho vận hành và hóa đơn." Foreground="{StaticResource TextSecondaryBrush}"/>
            <TextBlock Margin="0,8,0,0" Text="{Binding ValidationSummary}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" AutomationProperties.AutomationId="StoreSetupValidationSummary"/>
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,16,0,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="1. Thông tin cửa hàng" Margin="0,0,0,12">
                    <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="Tên cửa hàng" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding StoreName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupStoreName" Margin="6"/>
                        <TextBlock Grid.Column="2" Text="Hotline" VerticalAlignment="Center"/><TextBox Grid.Column="3" Text="{Binding Hotline, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupHotline" Margin="6"/>
                        <TextBlock Grid.Row="1" Text="Địa chỉ" VerticalAlignment="Center"/><TextBox Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupAddress" Margin="6"/>
                        <TextBlock Grid.Row="2" Text="Mã số thuế" VerticalAlignment="Center"/><TextBox Grid.Row="2" Grid.Column="1" Text="{Binding TaxCode, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupTaxCode" Margin="6"/>
                        <StackPanel Grid.Row="2" Grid.Column="2" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="6"><Button Content="Đổi logo" Command="{Binding ReplaceLogoCommand}" AutomationProperties.AutomationId="StoreSetupReplaceLogo" Style="{StaticResource SecondaryButtonStyle}"/><Button Content="Gỡ logo" Margin="6,0,0,0" Command="{Binding RemoveLogoCommand}" AutomationProperties.AutomationId="StoreSetupRemoveLogo" Style="{StaticResource SecondaryButtonStyle}"/><Image Source="{Binding LogoPath}" Width="40" Height="40" Margin="12,0,0,0"/></StackPanel>
                    </Grid>
                </GroupBox>
                <GroupBox Header="2. Địa phương và hóa đơn" Margin="0,0,0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Tiền tệ"/><ComboBox Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding Currency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupCurrency" Margin="6"><ComboBoxItem Content="VietnameseDong"/></ComboBox><TextBlock Grid.Column="2" Text="Múi giờ"/><TextBox Grid.Column="3" Text="{Binding TimeZoneId, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupTimeZone" Margin="6"/>
                    <TextBlock Grid.Row="1" Text="Khổ giấy"/><ComboBox Grid.Row="1" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding PaperSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupPaperSize" Margin="6"><ComboBoxItem Content="K80"/></ComboBox><TextBlock Grid.Row="1" Grid.Column="2" Text="Số bản in"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding PrintCopyCount, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupPrintCopies" Margin="6"/>
                    <CheckBox Grid.Row="2" Grid.Column="1" Content="Tự động in sau khi thanh toán" IsChecked="{Binding AutoPrint}" AutomationProperties.AutomationId="StoreSetupAutoPrint" Margin="6"/><TextBlock Grid.Row="2" Grid.Column="2" Text="Trạng thái"/><TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding RestartRequired, StringFormat=Cần khởi động lại: {0}}" Margin="6"/>
                </Grid></GroupBox>
                <GroupBox Header="3. Thiết bị" Margin="0,0,0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <TextBlock Text="Máy in mặc định"/><TextBox Grid.Column="1" Text="{Binding DefaultPrinter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupDefaultPrinter" Margin="6"/><Button Grid.Column="2" Content="Tải danh sách" Command="{Binding RefreshPrintersCommand}" AutomationProperties.AutomationId="StoreSetupRefreshPrinters" Margin="6" Style="{StaticResource SecondaryButtonStyle}"/><Button Grid.Column="3" Content="Kiểm tra máy in" Command="{Binding TestPrinterCommand}" AutomationProperties.AutomationId="StoreSetupTestPrinter" Margin="6" Style="{StaticResource SecondaryButtonStyle}"/>
                    <TextBlock Grid.Row="1" Text="Máy quét"/><ComboBox Grid.Row="1" Grid.Column="1" SelectedValuePath="Content" SelectedValue="{Binding ScannerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupScannerMode" Margin="6"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="KeyboardWedge"/></ComboBox><TextBlock Grid.Row="1" Grid.Column="2" Text="Két tiền"/><ComboBox Grid.Row="1" Grid.Column="3" SelectedValuePath="Content" SelectedValue="{Binding CashDrawerMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupCashDrawer" Margin="6"><ComboBoxItem Content="Disabled"/><ComboBoxItem Content="PrinterPulse"/></ComboBox>
                </Grid></GroupBox>
                <GroupBox Header="4. VietQR" Margin="0,0,0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <CheckBox Content="Bật VietQR" IsChecked="{Binding VietQrEnabled}" AutomationProperties.AutomationId="StoreSetupVietQrEnabled" Margin="6"/><TextBlock Grid.Column="2" Text="BIN ngân hàng"/><TextBox Grid.Column="3" Text="{Binding BankBin, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupBankBin" Margin="6"/>
                    <TextBlock Grid.Row="1" Text="Số tài khoản"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BankAccountNumber, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupBankAccountNumber" Margin="6"/><TextBlock Grid.Row="1" Grid.Column="2" Text="Tên tài khoản"/><TextBox Grid.Row="1" Grid.Column="3" Text="{Binding BankAccountName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupBankAccountName" Margin="6"/>
                    <TextBlock Grid.Row="2" Text="Nội dung"/><TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding VietQrContent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupVietQrContent" Margin="6"/>
                    <StackPanel Grid.Row="3" Grid.ColumnSpan="4" Orientation="Horizontal" Margin="6"><Button Content="Kiểm tra QR" Command="{Binding TestQrCommand}" AutomationProperties.AutomationId="StoreSetupTestQr" Style="{StaticResource SecondaryButtonStyle}"/><Image Source="{Binding QrPreview}" Width="100" Height="100" Margin="12,0,0,0"/></StackPanel>
                </Grid></GroupBox>
                <GroupBox Header="5. Dữ liệu và backup" Margin="0,0,0,12"><Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><TextBlock Text="Thư mục database"/><TextBox Grid.Column="1" Text="{Binding DatabaseDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupDatabaseDirectory" Margin="6"/><TextBlock Grid.Row="1" Text="Thư mục backup"/><TextBox Grid.Row="1" Grid.Column="1" Text="{Binding BackupDirectory, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="StoreSetupBackupDirectory" Margin="6"/><TextBlock Grid.Row="2" Text="GFS retention"/><StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="6"><TextBox Width="70" Text="{Binding LatestRetention}"/><TextBlock Text=" gần nhất   " VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding WeeklyRetention}"/><TextBlock Text=" tuần   " VerticalAlignment="Center"/><TextBox Width="70" Text="{Binding MonthlyRetention}"/><TextBlock Text=" tháng" VerticalAlignment="Center"/></StackPanel></Grid></GroupBox>
                <GroupBox Header="6. Readiness" Margin="0,0,0,12"><TextBlock Margin="12" Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.AutomationId="StoreSetupReadiness"/></GroupBox>
            </StackPanel>
        </ScrollViewer>
        <DockPanel Grid.Row="2"><TextBlock Text="{Binding IsDirty, StringFormat=Chưa lưu thay đổi: {0}}" VerticalAlignment="Center"/><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Hủy/Hoàn tác" Click="OnCancelClick" AutomationProperties.AutomationId="StoreSetupCancel" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0"/><Button Content="Lưu cấu hình" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="StoreSetupSave" Style="{StaticResource PrimaryButtonStyle}" Margin="8,0,0,0"/></StackPanel></DockPanel>
    </Grid>
</Window>
