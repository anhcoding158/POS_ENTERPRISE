<Window x:Class="POS.Wpf.Views.SalesDiscountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Áp dụng giảm giá"
        Width="520"
        MinWidth="500"
        SizeToContent="Height"
        MaxHeight="590"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="ÁP DỤNG GIẢM GIÁ"
                       FontFamily="Georgia"
                       FontSize="19"
                       FontWeight="Bold"/>
            <TextBlock Text="Chọn hình thức và nhập lý do giảm giá"
                       Margin="0,3,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="112"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Loại giảm" VerticalAlignment="Center"/>
            <ComboBox x:Name="TypeBox"
                      Grid.Column="1"
                      SelectedIndex="0"
                      SelectionChanged="OnTypeChanged">
                <ComboBoxItem Content="Theo số tiền"/>
                <ComboBoxItem Content="Theo phần trăm"/>
            </ComboBox>

            <TextBlock Grid.Row="1"
                       Text="Giá trị"
                       Margin="0,10,0,0"
                       VerticalAlignment="Center"/>
            <Grid Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="ValueBox"
                         TextChanged="OnValueTextChanged"
                         PreviewTextInput="OnValuePreviewTextInput"
                         DataObject.Pasting="OnValuePasting"
                         MaxLength="24"
                         VerticalContentAlignment="Center"/>
                <TextBlock x:Name="ValueSuffix"
                           Grid.Column="1"
                           Text="đ"
                           Margin="8,0,2,0"
                           VerticalAlignment="Center"/>
            </Grid>
            <TextBlock x:Name="ValueErrorText"
                       Grid.Row="2"
                       Grid.Column="1"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Visibility="Collapsed"/>

            <TextBlock Grid.Row="3"
                       Text="Lý do"
                       Margin="0,10,0,0"
                       VerticalAlignment="Center"/>
            <TextBox x:Name="ReasonBox"
                     Grid.Row="3"
                     Grid.Column="1"
                     Margin="0,10,0,0"
                     MaxLength="200"
                     TextChanged="OnInputChanged"
                     TextWrapping="Wrap"
                     MaxLines="2"
                     VerticalScrollBarVisibility="Auto"/>
            <TextBlock x:Name="ReasonHintText"
                       Grid.Row="4"
                       Grid.Column="1"
                       Text="Bắt buộc, tối đa 200 ký tự."
                       Margin="0,4,0,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,14,0,0"
                Padding="12,10"
                Background="{DynamicResource {x:Static SystemColors.ControlLightBrushKey}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Tạm tính trước giảm"/>
                <TextBlock x:Name="SubtotalText" Grid.Column="1" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="Giảm giá" Margin="0,5,0,0"/>
                <TextBlock x:Name="DiscountAmountText"
                           Grid.Row="1"
                           Grid.Column="1"
                           Margin="0,5,0,0"
                           FontWeight="SemiBold"/>
                <Separator Grid.Row="2" Grid.ColumnSpan="2" Margin="0,7,0,6"/>
                <TextBlock Grid.Row="3" Text="Tổng sau giảm" FontWeight="Bold"/>
                <TextBlock x:Name="FinalTotalText"
                           Grid.Row="3"
                           Grid.Column="1"
                           FontFamily="Georgia"
                           FontSize="18"
                           FontWeight="Bold"/>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="ErrorText"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"
                       Visibility="Collapsed"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Hủy" Width="84" IsCancel="True"/>
                <Button x:Name="ApplyButton"
                        Content="Áp dụng giảm giá"
                        Width="148"
                        Margin="8,0,0,0"
                        IsDefault="True"
                        Click="OnApply"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
