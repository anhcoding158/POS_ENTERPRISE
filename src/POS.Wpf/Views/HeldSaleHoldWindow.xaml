<Window x:Class="POS.Wpf.Views.HeldSaleHoldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giữ đơn" Width="500" Height="410" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="GIỮ ĐƠN" Style="{StaticResource PageTitleTextStyle}"/>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Nhãn nhận biết"/>
            <TextBox x:Name="LabelTextBox" Margin="0,6,0,0" Padding="9,6"
                     MaxLength="150" Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Ví dụ: Khách áo xanh, Bàn 05"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Ghi chú tùy chọn"/>
            <TextBox Margin="0,6,0,0" Height="64" Padding="9,6" AcceptsReturn="True"
                     TextWrapping="Wrap" MaxLength="2000"
                     Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <TextBlock Grid.Row="3" Margin="0,14,0,0" Text="{Binding Summary, Mode=OneWay}"
                   Foreground="{StaticResource TextSecondaryBrush}"/>
        <Border Grid.Row="4" Margin="0,14,0,0" Padding="10"
                Background="{StaticResource SurfaceRaisedBrush}">
            <TextBlock TextWrapping="Wrap"
                       Text="Giữ đơn chưa tạo hóa đơn, chưa trừ tồn kho và chưa được coi là đã thanh toán."/>
        </Border>
        <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,10,0" Content="Hủy" IsCancel="True"/>
            <Button Width="120" Content="Giữ đơn" IsDefault="True" Click="OnHold"/>
        </StackPanel>
    </Grid>
</Window>
