<Window x:Class="POS.Wpf.Views.HeldSaleHoldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Giữ đơn" Width="500" Height="500" MaxHeight="700" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="GIỮ ĐƠN" Style="{StaticResource PageTitleTextStyle}"/>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="Nhãn nhận biết"/>
            <Grid Margin="0,6,0,0">
                <TextBox x:Name="LabelTextBox" Padding="9,6"
                         MaxLength="150"
                         Text="{Binding Label, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Margin="10,0" VerticalAlignment="Center"
                           IsHitTestVisible="False"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="Ví dụ: Khách áo xanh, Bàn 05">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=LabelTextBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="Ghi chú tùy chọn"/>
            <TextBox Margin="0,6,0,0" Height="64" Padding="9,6" AcceptsReturn="True"
                     TextWrapping="Wrap" MaxLength="2000"
                     Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="{Binding ItemSummary, Mode=OneWay}"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
            <Grid Margin="0,8,0,0">
                <Grid.Style>
                    <Style TargetType="{x:Type Grid}">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Tạm tính trước giảm"/>
                <TextBlock Grid.Column="1" Text="{Binding SubtotalText, Mode=OneWay}"
                           FontWeight="SemiBold"/>
                <TextBlock Grid.Row="1" Text="{Binding DiscountLabel, Mode=OneWay}"
                           Margin="0,4,0,0"/>
                <TextBlock Grid.Row="1" Grid.Column="1"
                           Text="{Binding DiscountText, Mode=OneWay}"
                           Margin="12,4,0,0" FontWeight="SemiBold"/>
                <TextBlock Grid.Row="2" Text="Tổng sau giảm"
                           Margin="0,5,0,0" FontWeight="Bold"/>
                <TextBlock Grid.Row="2" Grid.Column="1"
                           Text="{Binding TotalText, Mode=OneWay}"
                           Margin="12,5,0,0" FontWeight="Bold"/>
            </Grid>
            <TextBlock Margin="0,6,0,0"
                       Text="{Binding TotalText, Mode=OneWay, StringFormat=Tổng: {0}}"
                       FontWeight="SemiBold">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasDiscount}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>
        <Border Grid.Row="4" Margin="0,14,0,0" Padding="10"
                Background="{StaticResource SurfaceRaisedBrush}">
            <TextBlock TextWrapping="Wrap"
                       Text="Giữ đơn chưa tạo hóa đơn, chưa trừ tồn kho và chưa được coi là đã thanh toán."/>
        </Border>
        <StackPanel Grid.Row="5" Margin="0,18,0,0" Orientation="Horizontal"
                    HorizontalAlignment="Right">
            <Button Width="100" Margin="0,0,10,0" Content="Hủy" IsCancel="True"/>
            <Button Width="120" Content="Giữ đơn" IsDefault="True" Click="OnHold"/>
        </StackPanel>
    </Grid>
</Window>
