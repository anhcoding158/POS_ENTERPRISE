<Window
    x:Class="POS.Wpf.Views.InventoryHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="vi-VN"
    Title="Lịch sử tồn kho"
    Width="1280"
    Height="820"
    MinWidth="1000"
    MinHeight="620"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="HistoryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="HistoryInputStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,0,38,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistorySearchButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Width" Value="68" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="HistoryActionButtonStyle" TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HistoryClearSearchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ClearSearchBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ClearSearchBorder" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                <Setter TargetName="ClearSearchBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ClearSearchBorder" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="HistoryComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryDateStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HistoryCustomDatePanelStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedDateRangeOption.Key}" Value="custom">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryDataGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="GridLinesVisibility" Value="All" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="VerticalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="54" />
            <Setter Property="ColumnHeaderHeight" Value="42" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style x:Key="HistoryCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="HistoryEmptyStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryErrorStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryDetailStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedMovement}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="26,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource SidebarSurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="13">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldHoverBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="13,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Lịch sử tồn kho" Foreground="{StaticResource GoldHoverBrush}" FontFamily="Georgia" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock Text="Theo dõi các lần tăng, giảm số lượng sản phẩm." Foreground="{StaticResource SidebarMutedBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="11" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20,18,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="HistoryFilterCard" Grid.Column="0" Style="{StaticResource CardStyle}" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="17,15" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="Bộ lọc" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Georgia" FontSize="17" FontWeight="SemiBold" />
                            <TextBlock Text="Chọn điều kiện để xem lịch sử." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="17,17">
                            <TextBlock Text="Tìm sản phẩm" Style="{StaticResource HistoryLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="68" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="HistorySearchInput" Text="{Binding ProductSearchTerm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HistoryInputStyle}" ToolTip="Tên, mã sản phẩm hoặc mã vạch.">
                                        <TextBox.InputBindings>
                                            <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                                        </TextBox.InputBindings>
                                    </TextBox>
                                    <Button x:Name="HistoryClearSearchButton" Content="×" Command="{Binding ClearSearchCommand}" Style="{StaticResource HistoryClearSearchButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Center" Visibility="{Binding HasSearchTerm, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Xóa tiêu chí tìm sản phẩm" AutomationProperties.Name="Xóa tìm kiếm" />
                                </Grid>
                                <Button x:Name="HistorySearchButton" Grid.Column="2" Content="Tìm" Command="{Binding SearchCommand}" Style="{StaticResource HistorySearchButtonStyle}" ToolTip="Tìm ngay trong toàn bộ lịch sử." AutomationProperties.Name="Tìm lịch sử tồn kho" />
                            </Grid>
                            <TextBlock Text="Tên, mã sản phẩm hoặc mã vạch" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" />

                            <TextBlock Text="Thời gian" Style="{StaticResource HistoryLabelStyle}" Margin="0,17,0,6" />
                            <ComboBox ItemsSource="{Binding DateRangeOptions}" SelectedItem="{Binding SelectedDateRangeOption, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboStyle}" />
                            <TextBlock Text="{Binding DateRangeText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="2,8,0,0" />
                            <Border Style="{StaticResource HistoryCustomDatePanelStyle}" Margin="0,10,0,0">
                                <StackPanel>
                                    <TextBlock Text="Từ ngày" Style="{StaticResource HistoryLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" SelectedDateFormat="Short" Language="vi-VN" Style="{StaticResource HistoryDateStyle}" />
                                    <TextBlock Text="Đến ngày" Style="{StaticResource HistoryLabelStyle}" Margin="0,11,0,6" />
                                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" SelectedDateFormat="Short" Language="vi-VN" Style="{StaticResource HistoryDateStyle}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="{Binding DateRangeError}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="{Binding HasDateRangeError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Text="Loại thay đổi" Style="{StaticResource HistoryLabelStyle}" Margin="0,16,0,6" />
                            <ComboBox ItemsSource="{Binding MovementFilters}" SelectedItem="{Binding SelectedMovementFilter, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboStyle}" />
                            <TextBlock Text="Nguồn giao dịch" Style="{StaticResource HistoryLabelStyle}" Margin="0,15,0,6" />
                            <ComboBox ItemsSource="{Binding ReferenceFilters}" SelectedItem="{Binding SelectedReferenceFilter, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboStyle}" />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="17,10,17,17">
                        <TextBlock Text="{Binding FilterSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,0,0,9" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="8" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource HistoryActionButtonStyle}" Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Về 30 ngày gần nhất và xem tất cả sản phẩm." />
                            <Button Grid.Column="2" Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource HistoryActionButtonStyle}" ToolTip="Đọc lại dữ liệu theo đúng điều kiện đang xem." />
                        </Grid>
                        <Button Content="Xuất file" Command="{Binding ExportCommand}" Style="{StaticResource HistoryActionButtonStyle}" HorizontalAlignment="Left" Margin="0,9,0,0" ToolTip="Xuất toàn bộ lịch sử theo điều kiện đang xem." />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3" MinHeight="92">
                    <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="0,0,6,0">
                        <StackPanel>
                            <TextBlock Text="SỐ LƯỢT THAY ĐỔI" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalMovementsText}" Style="{StaticResource CardValueTextStyle}" FontSize="23" Margin="0,4,0,0" />
                            <TextBlock Text="Theo điều kiện đang xem" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="3,0,3,0">
                        <StackPanel>
                            <TextBlock Text="SỐ LẦN TĂNG" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalIncreasesText}" FontFamily="Georgia" FontSize="23" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Trên toàn bộ kết quả" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="15,12" Margin="6,0,0,0">
                        <StackPanel>
                            <TextBlock Text="SỐ LẦN GIẢM" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalDecreasesText}" FontFamily="Georgia" FontSize="23" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,4,0,0" />
                            <TextBlock Text="Trên toàn bộ kết quả" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,13,0,12" ClipToBounds="True">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement, Mode=TwoWay}" Style="{StaticResource HistoryDataGridStyle}" CellStyle="{StaticResource HistoryCellStyle}" ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="THỜI GIAN" Width="1.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding OccurredDateText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding OccurredTimeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="2.1*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" />
                                                <TextBlock Text="{Binding ProductCode}" Foreground="{StaticResource GoldBrush}" FontSize="11" FontWeight="SemiBold" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductCode}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="LOẠI THAY ĐỔI" Width="1.3*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" Padding="8,5" CornerRadius="7">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource GoldSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncrease}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDecrease}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding MovementTypeText}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.15*">
                                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="TỒN TRƯỚC" HorizontalAlignment="Right" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityBeforeText}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="{StaticResource TextPrimaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.15*">
                                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="THAY ĐỔI" HorizontalAlignment="Right" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityDeltaText}" TextAlignment="Right" HorizontalAlignment="Stretch" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.15*">
                                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="TỒN SAU" HorizontalAlignment="Right" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityAfterText}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="{StaticResource TextPrimaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="NGUỒN GIAO DỊCH" Width="1.55*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ReferenceText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding ReferenceText}" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource HistoryEmptyStyle}" Background="{StaticResource SurfaceBrush}" Panel.ZIndex="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldBrush}" FontSize="30" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="Bạn có thể đổi từ khóa, khoảng thời gian hoặc loại thay đổi." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HistoryErrorStyle}" Background="{StaticResource SurfaceBrush}" Panel.ZIndex="3">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                                <TextBlock Text="Không thể tải lịch sử tồn kho" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                <Button Content="Thử lại" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="94" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Style="{StaticResource HistoryDetailStyle}" Padding="15" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMovementTitle}" Style="{StaticResource SectionTitleTextStyle}" FontSize="15" />
                            <TextBlock Text="{Binding SelectedMovementReason}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,6,18,0" />
                            <TextBlock Text="{Binding SelectedMovementAuditText}" Style="{StaticResource CaptionTextStyle}" Margin="0,6,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                            <Border Padding="12,9" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" MaxWidth="240">
                                <TextBlock Text="{Binding SelectedMovementReference}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedMovementReference}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" />
                            </Border>
                            <Button Content="Đóng chi tiết" Command="{Binding ClearSelectionCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="38" Margin="9,0,0,0" Padding="10,0" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" MinHeight="48">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Trước" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" />
                        <Border Height="40" Padding="14,0" Margin="8,0" Background="{StaticResource AccentBrush}" CornerRadius="8">
                            <TextBlock Text="{Binding PageText}" Foreground="White" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="Sau" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}" Opacity="0.8" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
            <Border Width="320" Padding="24" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Đang cập nhật lịch sử tồn kho..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
