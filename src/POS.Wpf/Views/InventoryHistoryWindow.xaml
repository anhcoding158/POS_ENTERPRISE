<Window
    x:Class="POS.Wpf.Views.InventoryHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="vi-VN"
    Title="Lịch sử tồn kho"
    Width="1240"
    Height="790"
    MinWidth="1080"
    MinHeight="680"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="HistoryFormLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="HistoryTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="41" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="41" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="41" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HistoryGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
        </Style>
        <Style x:Key="HistoryCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="HistoryEmptyStateStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryErrorStateStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryScopeStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProductScope}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryDetailStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedMovement}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HistoryNoDetailStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedMovement}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="90" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="{StaticResource GoldBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="46" Height="46" Background="{StaticResource SidebarSurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="13">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldHoverBrush}" FontSize="21" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LỊCH SỬ TỒN KHO" Foreground="{StaticResource GoldHoverBrush}" FontFamily="Georgia" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Theo dõi toàn bộ biến động, chứng từ và số tồn trước – sau." Foreground="{StaticResource SidebarMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" ToolTip="Đọc lại dữ liệu theo đúng điều kiện đang xem." />
                    <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" Margin="0,5,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Border Padding="18,15" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,0,1">
                        <StackPanel>
                            <TextBlock Text="BỘ LỌC NGHIỆP VỤ" Foreground="{StaticResource GoldHoverBrush}" FontFamily="Georgia" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="Thu hẹp dữ liệu theo sản phẩm và thời gian." Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="18,17">
                            <TextBlock Text="Tìm sản phẩm" Style="{StaticResource HistoryFormLabelStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="72" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    Text="{Binding ProductSearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                    Style="{StaticResource HistoryTextBoxStyle}"
                                    ToolTip="Tìm theo tên, mã sản phẩm hoặc mã vạch.">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                                    </TextBox.InputBindings>
                                </TextBox>
                                <Button Grid.Column="2" Content="Tìm" Command="{Binding ApplyFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" Height="41" Padding="8,0" ToolTip="Tìm ngay trong toàn bộ lịch sử." />
                            </Grid>
                            <TextBlock Text="Kết quả tự cập nhật khi bạn nhập." Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="2,6,0,0" />

                            <Border Style="{StaticResource HistoryScopeStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="10,8" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="Đang giới hạn sản phẩm đã chọn" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <Button Content="Bỏ giới hạn sản phẩm" Command="{Binding ClearProductScopeCommand}" Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" MinWidth="142" Height="30" Padding="8,0" Margin="0,8,0,0" ToolTip="Xem lịch sử của tất cả sản phẩm phù hợp." />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Loại thay đổi" Style="{StaticResource HistoryFormLabelStyle}" Margin="0,16,0,6" />
                            <ComboBox ItemsSource="{Binding MovementFilters}" SelectedItem="{Binding SelectedMovementFilter, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboBoxStyle}" />

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Từ ngày" Style="{StaticResource HistoryFormLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" SelectedDateFormat="Short" Language="vi-VN" Style="{StaticResource HistoryDatePickerStyle}" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Đến ngày" Style="{StaticResource HistoryFormLabelStyle}" />
                                    <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" SelectedDateFormat="Short" Language="vi-VN" Style="{StaticResource HistoryDatePickerStyle}" />
                                </StackPanel>
                            </Grid>
                            <TextBlock Text="{Binding DateRangeError}" Foreground="{StaticResource DangerBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,6,0,0" Visibility="{Binding HasDateRangeError, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <TextBlock Text="Nguồn giao dịch" Style="{StaticResource HistoryFormLabelStyle}" Margin="0,14,0,6" />
                            <ComboBox ItemsSource="{Binding ReferenceFilters}" SelectedItem="{Binding SelectedReferenceFilter, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboBoxStyle}" ToolTip="Lọc theo nguồn ghi nhận của biến động." />
                        </StackPanel>
                    </ScrollViewer>
                    <StackPanel Grid.Row="2" Margin="18,10,18,18">
                        <Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}" />
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="2,9,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <UniformGrid Grid.Row="0" Columns="3" MinHeight="104">
                    <Border Style="{StaticResource CardStyle}" Padding="15,13" Margin="0,0,7,0">
                        <StackPanel>
                            <TextBlock Text="TỔNG LƯỢT THAY ĐỔI" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TotalMovementsText}" Style="{StaticResource CardValueTextStyle}" FontSize="22" Margin="0,5,0,0" />
                            <TextBlock Text="Theo bộ lọc hiện tại" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="15,13" Margin="3,0,4,0">
                        <StackPanel>
                            <TextBlock Text="TĂNG TRÊN TRANG" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding IncreasesOnPageText}" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource SuccessBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="Số lượt tăng" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardStyle}" Padding="15,13" Margin="7,0,0,0">
                        <StackPanel>
                            <TextBlock Text="GIẢM TRÊN TRANG" Style="{StaticResource CaptionTextStyle}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding DecreasesOnPageText}" FontFamily="Georgia" FontSize="22" FontWeight="Bold" Foreground="{StaticResource DangerBrush}" Margin="0,5,0,0" />
                            <TextBlock Text="Số lượt giảm" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" Margin="0,14,0,12" ClipToBounds="True">
                    <Grid>
                        <DataGrid
                            ItemsSource="{Binding Movements}"
                            SelectedItem="{Binding SelectedMovement, Mode=TwoWay}"
                            Style="{StaticResource HistoryGridStyle}"
                            CellStyle="{StaticResource HistoryCellStyle}"
                            ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}"
                            EnableRowVirtualization="True"
                            EnableColumnVirtualization="True"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="THỜI GIAN" Width="1.05*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding OccurredDateText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding OccurredTimeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="2*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" />
                                                <TextBlock Text="{Binding ProductCode}" Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" ToolTip="{Binding ProductCode}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="NGHIỆP VỤ" Width="1.15*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border HorizontalAlignment="Left" Padding="8,4" CornerRadius="7">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{StaticResource GoldSoftBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsIncrease}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsDecrease}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}" /></DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding MovementTypeText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.05*">
                                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="TỒN TRƯỚC" TextAlignment="Right" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityBeforeText}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="{StaticResource TextPrimaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.05*">
                                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="THAY ĐỔI" TextAlignment="Right" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityDeltaText}" TextAlignment="Right" HorizontalAlignment="Stretch" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.05*">
                                    <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="TỒN SAU" TextAlignment="Right" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate>
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityAfterText}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="{StaticResource TextPrimaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CHỨNG TỪ" Width="1.55*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Padding="8,5" Margin="0,2" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="7">
                                                <TextBlock Text="{Binding ReferenceText}" ToolTip="{Binding ReferenceText}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource HistoryEmptyStateStyle}" Background="{StaticResource SurfaceBrush}" Panel.ZIndex="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <Border Width="58" Height="58" Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="18">
                                    <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldBrush}" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,13,0,0" />
                                <TextBlock Text="Thử thay đổi sản phẩm, ngày hoặc loại nghiệp vụ." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource HistoryErrorStateStyle}" Background="{StaticResource SurfaceBrush}" Panel.ZIndex="3">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                                <TextBlock Text="Không thể tải lịch sử tồn kho" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
                                <Button Content="Thử lại" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="92" HorizontalAlignment="Center" Margin="0,14,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Row="2" MinHeight="104" Style="{StaticResource HistoryNoDetailStyle}" Padding="16">
                    <TextBlock Text="Chọn một thay đổi để xem chi tiết" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                </Border>
                <Border Grid.Row="2" MinHeight="104" Style="{StaticResource HistoryDetailStyle}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="1.25*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedMovementTitle}" Style="{StaticResource SectionTitleTextStyle}" FontSize="15" />
                            <TextBlock Text="{Binding SelectedMovementReason}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,7,20,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Padding="13" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
                            <StackPanel>
                                <TextBlock Text="{Binding SelectedMovementReference}" ToolTip="{Binding SelectedMovementReference}" ToolTipService.InitialShowDelay="250" ToolTipService.ShowDuration="60000" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <TextBlock Text="{Binding SelectedMovementAuditText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" MinHeight="52" Margin="2,9,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="Trước" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="78" />
                        <Border Height="42" Padding="15,0" Margin="9,0" Background="{StaticResource AccentBrush}" CornerRadius="8">
                            <TextBlock Text="{Binding PageText}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Border>
                        <Button Content="Sau" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="78" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}" Opacity="0.78" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
            <Border Width="310" Padding="24" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="Đang tải lịch sử tồn kho..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
