<Window
    x:Class="POS.Wpf.Views.InventoryHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="vi-VN"
    Title="Lịch sử tồn kho"
    Width="1240"
    Height="790"
    MinWidth="1000"
    MinHeight="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>
        <Style x:Key="HistoryLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="HistoryTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource SearchTextBoxStyle}">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="HistoryDateStyle" TargetType="DatePicker">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="HistoryGridStyle" TargetType="DataGrid" BasedOn="{StaticResource ModernDataGridStyle}">
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="ColumnHeaderHeight" Value="40" />
        </Style>
        <Style x:Key="HistoryCellStyle" TargetType="DataGridCell">
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="HistoryHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Padding" Value="11,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        </Style>
        <Style x:Key="EmptyStateStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowEmptyState}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ErrorStateStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ScopeStyle" TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProductScope}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DetailStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedMovement}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="NoDetailStyle" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelectedMovement}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="44" Height="44" Background="{StaticResource SidebarSurfaceBrush}" BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" CornerRadius="13">
                        <TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldHoverBrush}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="LỊCH SỬ TỒN KHO" Foreground="{StaticResource GoldHoverBrush}" FontFamily="Georgia" FontSize="21" FontWeight="SemiBold" />
                        <TextBlock Text="Theo dõi các lần tăng, giảm số lượng sản phẩm." Foreground="{StaticResource SidebarMutedBrush}" FontSize="11" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <Button Content="Làm mới" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="92" ToolTip="Đọc lại dữ liệu theo đúng điều kiện đang xem." />
                    <TextBlock Text="{Binding LastUpdatedText}" Foreground="{StaticResource SidebarMutedBrush}" FontSize="10" HorizontalAlignment="Right" Margin="0,5,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="18,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Tìm sản phẩm trong lịch sử" Style="{StaticResource HistoryLabelStyle}" />
                        <Grid>
                            <TextBox x:Name="ProductSearchBox" Text="{Binding ProductSearchTerm, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource HistoryTextBoxStyle}" ToolTip="Tìm theo tên, mã sản phẩm hoặc mã vạch. Kết quả tự cập nhật sau khi bạn nhập.">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding ApplyFiltersCommand}" />
                                </TextBox.InputBindings>
                            </TextBox>
                            <Button Content="×" Command="{Binding ClearSearchCommand}" Visibility="{Binding HasSearchTerm, Converter={StaticResource BooleanToVisibilityConverter}}" HorizontalAlignment="Right" Width="38" Height="38" Margin="0,3,3,3" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMutedBrush}" FontSize="20" ToolTip="Xóa từ khóa" />
                        </Grid>
                        <TextBlock Text="Kết quả tự cập nhật khi bạn nhập · nhấn Enter để cập nhật ngay." Style="{StaticResource CaptionTextStyle}" Margin="2,6,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="18,0,0,0">
                        <Border Style="{StaticResource ScopeStyle}" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,9,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Đang giới hạn sản phẩm đã chọn" Foreground="{StaticResource AccentBrush}" FontSize="11" VerticalAlignment="Center" />
                                <Button Content="Bỏ giới hạn" Command="{Binding ClearProductScopeCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="88" Height="28" Padding="7,0" Margin="9,0,0,0" ToolTip="Xem lại lịch sử của tất cả sản phẩm phù hợp." />
                            </StackPanel>
                        </Border>
                        <Button Content="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="106" Visibility="{Binding HasActiveFilters, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Xóa từ khóa, phạm vi sản phẩm, loại và khoảng ngày đã chọn." />
                    </StackPanel>
                </Grid>
            </Border>

            <Expander Grid.Row="1" Margin="0,10,0,12" IsExpanded="False">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Lọc thêm" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" />
                        <TextBlock Text="  ·  " Foreground="{StaticResource TextMutedBrush}" />
                        <TextBlock Text="{Binding FilterSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                    </StackPanel>
                </Expander.Header>
                <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.6*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="1.6*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Loại thay đổi" Style="{StaticResource HistoryLabelStyle}" />
                            <ComboBox ItemsSource="{Binding MovementFilters}" SelectedItem="{Binding SelectedMovementFilter, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Nguồn giao dịch" Style="{StaticResource HistoryLabelStyle}" />
                            <ComboBox ItemsSource="{Binding ReferenceFilters}" SelectedItem="{Binding SelectedReferenceFilter, Mode=TwoWay}" DisplayMemberPath="DisplayName" Style="{StaticResource HistoryComboStyle}" ToolTip="Lọc theo nguồn ghi nhận của biến động." />
                        </StackPanel>
                        <StackPanel Grid.Column="4">
                            <TextBlock Text="Từ ngày" Style="{StaticResource HistoryLabelStyle}" />
                            <DatePicker SelectedDate="{Binding FromDate, Mode=TwoWay}" SelectedDateFormat="Short" Language="vi-VN" Style="{StaticResource HistoryDateStyle}" />
                        </StackPanel>
                        <StackPanel Grid.Column="6">
                            <TextBlock Text="Đến ngày" Style="{StaticResource HistoryLabelStyle}" />
                            <DatePicker SelectedDate="{Binding ToDate, Mode=TwoWay}" SelectedDateFormat="Short" Language="vi-VN" Style="{StaticResource HistoryDateStyle}" />
                        </StackPanel>
                        <TextBlock Grid.Column="4" Grid.ColumnSpan="3" Text="{Binding DateRangeError}" Foreground="{StaticResource DangerBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,47,0,0" Visibility="{Binding HasDateRangeError, Converter={StaticResource BooleanToVisibilityConverter}}" />
                    </Grid>
                </Border>
            </Expander>

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding FilterSummaryText}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" Margin="18,0,0,0"><TextBlock Text="LƯỢT THAY ĐỔI" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" /><TextBlock Text="{Binding TotalMovementsText}" Style="{StaticResource CardValueTextStyle}" FontSize="19" HorizontalAlignment="Right" /></StackPanel>
                    <StackPanel Grid.Column="2" Margin="22,0,0,0"><TextBlock Text="TĂNG / GIẢM TRÊN TRANG" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" /><TextBlock Text="{Binding PageDirectionSummary}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" /></StackPanel>
                    <StackPanel Grid.Column="3" Margin="22,0,2,0"><TextBlock Text="THAY ĐỔI TRÊN TRANG" Style="{StaticResource CaptionTextStyle}" HorizontalAlignment="Right" /><TextBlock Text="{Binding NetChangeOnPageText}" Foreground="{StaticResource GoldBrush}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Right" /></StackPanel>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="0" ClipToBounds="True">
                    <Grid>
                        <DataGrid ItemsSource="{Binding Movements}" SelectedItem="{Binding SelectedMovement, Mode=TwoWay}" Style="{StaticResource HistoryGridStyle}" CellStyle="{StaticResource HistoryCellStyle}" ColumnHeaderStyle="{StaticResource HistoryHeaderStyle}" EnableRowVirtualization="True" EnableColumnVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="THỜI GIAN" Width="1.15*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding OccurredDateText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding OccurredTimeText}" Style="{StaticResource CaptionTextStyle}" Margin="0,2,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="SẢN PHẨM" Width="2.15*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding ProductName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProductName}" /><TextBlock Text="{Binding ProductCode}" Foreground="{StaticResource GoldBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,2,0,0" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="LOẠI THAY ĐỔI" Width="1.25*">
                                    <DataGridTemplateColumn.CellTemplate><DataTemplate><Border Padding="8,4" CornerRadius="7" HorizontalAlignment="Left" Background="{StaticResource GoldSoftBrush}"><Border.Style><Style TargetType="Border"><Setter Property="Background" Value="{StaticResource GoldSoftBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsIncrease}" Value="True"><Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsDecrease}" Value="True"><Setter Property="Background" Value="{StaticResource DangerSoftBrush}" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding MovementTypeText}" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoldBrush}" /></Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.05*"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="TỒN TRƯỚC" TextAlignment="Right" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityBeforeText}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="{StaticResource TextPrimaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.05*"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="THAY ĐỔI" TextAlignment="Right" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityDeltaText}" TextAlignment="Right" HorizontalAlignment="Stretch" FontWeight="Bold" Foreground="{StaticResource GoldBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.05*"><DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="TỒN SAU" TextAlignment="Right" HorizontalAlignment="Stretch" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding QuantityAfterText}" TextAlignment="Right" HorizontalAlignment="Stretch" Foreground="{StaticResource TextPrimaryBrush}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="NGUỒN" Width="1.4*"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ReferenceText}" ToolTip="{Binding ReferenceText}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Border Style="{StaticResource EmptyStateStyle}" Background="{StaticResource SurfaceBrush}" Panel.ZIndex="2">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="54" Height="54" Background="{StaticResource GoldSoftBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="17"><TextBlock Text="&#xE9D2;" FontFamily="Segoe MDL2 Assets" Foreground="{StaticResource GoldBrush}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="{Binding EmptyStateText}" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,13,0,0" /><TextBlock Text="Bạn có thể xóa từ khóa, đổi bộ lọc hoặc chọn khoảng ngày khác." Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" Margin="0,5,0,0" /></StackPanel>
                        </Border>
                        <Border Style="{StaticResource ErrorStateStyle}" Background="{StaticResource SurfaceBrush}" Panel.ZIndex="3"><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><TextBlock Text="Không thể tải lịch sử tồn kho" Style="{StaticResource SectionTitleTextStyle}" HorizontalAlignment="Center" /><TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" /><Button Content="Thử lại" Command="{Binding RefreshCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="92" HorizontalAlignment="Center" Margin="0,14,0,0" /></StackPanel></Border>
                    </Grid>
                </Border>
            </Grid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Border Style="{StaticResource NoDetailStyle}" Padding="14"><TextBlock Text="Chọn một thay đổi để xem chi tiết" Foreground="{StaticResource TextMutedBrush}" FontSize="12" /></Border>
                <Border Style="{StaticResource DetailStyle}" Padding="14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding SelectedMovementTitle}" Style="{StaticResource SectionTitleTextStyle}" FontSize="14" /><TextBlock Text="{Binding SelectedMovementReason}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,6,20,0" /></StackPanel><Border Grid.Column="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="12"><StackPanel><TextBlock Text="{Binding SelectedMovementReference}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedMovementReference}" /><TextBlock Text="{Binding SelectedMovementAuditText}" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Margin="0,5,0,0" /></StackPanel></Border></Grid></Border>
            </Grid>

            <Grid Grid.Row="4" MinHeight="48" Margin="2,8,2,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                <StackPanel Grid.Column="1" Orientation="Horizontal"><Button Content="Trước" Command="{Binding PreviousPageCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" /><Border Height="40" Padding="14,0" Margin="8,0" Background="{StaticResource AccentBrush}" CornerRadius="8"><TextBlock Text="{Binding PageText}" Foreground="White" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" /></Border><Button Content="Sau" Command="{Binding NextPageCommand}" Style="{StaticResource SecondaryButtonStyle}" MinWidth="76" /></StackPanel>
            </Grid>
        </Grid>

        <Border Grid.RowSpan="2" Background="{StaticResource SurfaceBrush}" Opacity="0.78" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Panel.ZIndex="10">
            <Border Width="310" Padding="24" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource GoldBorderBrush}" BorderThickness="1" CornerRadius="14" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel><ProgressBar Height="5" IsIndeterminate="True" Foreground="{StaticResource AccentBrush}" /><TextBlock Text="Đang cập nhật lịch sử tồn kho..." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" HorizontalAlignment="Center" Margin="0,14,0,0" /></StackPanel></Border>
        </Border>
    </Grid>
</Window>
