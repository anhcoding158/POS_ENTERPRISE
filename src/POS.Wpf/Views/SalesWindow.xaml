<Window
    x:Class="POS.Wpf.Views.SalesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="vi-VN"
    Title="POS Enterprise - Quầy bán hàng"
    Width="1600"
    Height="920"
    MinWidth="1180"
    MinHeight="720"
    WindowStartupLocation="CenterOwner"
    WindowState="Maximized"
    ResizeMode="CanResize"
    ShowInTaskbar="False"
    Background="{StaticResource AppBackgroundBrush}"
    FontFamily="Segoe UI"
    FontSize="12"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Window.Resources>

        <!-- Search -->

        <Style
            x:Key="SalesSearchTextBoxStyle"
            TargetType="{x:Type TextBox}"
            BasedOn="{StaticResource SearchTextBoxStyle}">

            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="43,0,13,0" />
            <Setter Property="FontSize" Value="13" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />
        </Style>

        <!-- Category -->

        <Style
            x:Key="SalesCategoryChipStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Height" Value="38" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="0,0,8,0" />

            <Setter
                Property="Background"
                Value="{StaticResource SurfaceBrush}" />

            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource BorderStrongBrush}" />

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            x:Name="ChipBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="18">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ChipBorder"
                                    Property="Background"
                                    Value="{StaticResource GoldSoftBrush}" />

                                <Setter
                                    TargetName="ChipBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource GoldBorderBrush}" />

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource GoldBrush}" />
                            </Trigger>

                            <DataTrigger
                                Binding="{Binding IsSelected}"
                                Value="True">

                                <Setter
                                    TargetName="ChipBorder"
                                    Property="Background"
                                    Value="{StaticResource AccentBrush}" />

                                <Setter
                                    TargetName="ChipBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource AccentBrush}" />

                                <Setter
                                    Property="Foreground"
                                    Value="White" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Product card -->

        <Style
            x:Key="SalesProductCardStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Width" Value="200" />
            <Setter Property="Height" Value="194" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />

            <Setter
                Property="Background"
                Value="{StaticResource SurfaceBrush}" />

            <Setter
                Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource BorderBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Stretch" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            x:Name="ProductBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="13"
                            Padding="13">

                            <Border.Effect>

                                <DropShadowEffect
                                    Color="#4B3327"
                                    BlurRadius="12"
                                    ShadowDepth="2"
                                    Direction="270"
                                    Opacity="0.065" />
                            </Border.Effect>

                            <ContentPresenter />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="ProductBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource GoldBrush}" />

                                <Setter
                                    TargetName="ProductBorder"
                                    Property="Background"
                                    Value="#FFFFFCF6" />
                            </Trigger>

                            <Trigger
                                Property="IsPressed"
                                Value="True">

                                <Setter
                                    TargetName="ProductBorder"
                                    Property="Background"
                                    Value="{StaticResource GoldSoftBrush}" />
                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="ProductBorder"
                                    Property="Opacity"
                                    Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Cart quantity -->

        <Style
            x:Key="CartQuantityButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />

            <Setter
                Property="Background"
                Value="{StaticResource SurfaceMutedBrush}" />

            <Setter
                Property="Foreground"
                Value="{StaticResource TextPrimaryBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource BorderStrongBrush}" />

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            x:Name="QuantityBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="QuantityBorder"
                                    Property="Background"
                                    Value="{StaticResource AccentSoftBrush}" />

                                <Setter
                                    TargetName="QuantityBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource AccentBorderBrush}" />

                                <Setter
                                    Property="Foreground"
                                    Value="{StaticResource AccentBrush}" />
                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="QuantityBorder"
                                    Property="Opacity"
                                    Value="0.38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Quick cash -->

        <Style
            x:Key="QuickCashButtonStyle"
            TargetType="{x:Type Button}"
            BasedOn="{StaticResource SecondaryButtonStyle}">

            <Setter Property="Height" Value="34" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="FontSize" Value="10.5" />
        </Style>

        <!-- Payment method -->

        <Style
            x:Key="PaymentMethodOptionButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Height" Value="54" />
            <Setter Property="Padding" Value="12,0" />

            <Setter
                Property="Background"
                Value="{StaticResource SurfaceBrush}" />

            <Setter
                Property="Foreground"
                Value="{StaticResource TextSecondaryBrush}" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource BorderStrongBrush}" />

            <Setter Property="BorderThickness" Value="1" />

            <Setter
                Property="HorizontalContentAlignment"
                Value="Stretch" />

            <Setter
                Property="VerticalContentAlignment"
                Value="Center" />

            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            x:Name="PaymentMethodBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10"
                            Padding="{TemplateBinding Padding}">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="PaymentMethodBorder"
                                    Property="Background"
                                    Value="{StaticResource GoldSoftBrush}" />

                                <Setter
                                    TargetName="PaymentMethodBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource GoldBrush}" />
                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="PaymentMethodBorder"
                                    Property="Opacity"
                                    Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkout -->

        <Style
            x:Key="LuxuryCheckoutButtonStyle"
            TargetType="{x:Type Button}">

            <Setter Property="Height" Value="58" />

            <Setter
                Property="Background"
                Value="{StaticResource AccentGradientBrush}" />

            <Setter Property="Foreground" Value="White" />

            <Setter
                Property="BorderBrush"
                Value="{StaticResource AccentBrush}" />

            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate
                        TargetType="{x:Type Button}">

                        <Border
                            x:Name="CheckoutBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12"
                            Padding="16,0">

                            <Border.Effect>

                                <DropShadowEffect
                                    Color="#661015"
                                    BlurRadius="16"
                                    ShadowDepth="3"
                                    Direction="270"
                                    Opacity="0.22" />
                            </Border.Effect>

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger
                                Property="IsMouseOver"
                                Value="True">

                                <Setter
                                    TargetName="CheckoutBorder"
                                    Property="Background"
                                    Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>

                            <Trigger
                                Property="IsEnabled"
                                Value="False">

                                <Setter
                                    TargetName="CheckoutBorder"
                                    Property="Opacity"
                                    Value="0.43" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">

        <Grid.RowDefinitions>
            <RowDefinition Height="80" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->

        <Border
            Grid.Row="0"
            Background="{StaticResource SidebarBrush}"
            BorderBrush="#745630"
            BorderThickness="0,0,0,1">

            <Grid Margin="22,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Grid
                        Width="52"
                        Height="52">

                        <Ellipse
                            Stroke="{StaticResource GoldBrush}"
                            StrokeThickness="1.2" />

                        <Border
                            Width="35"
                            Height="35"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            BorderBrush="{StaticResource GoldHoverBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,0.5">

                            <Border.RenderTransform>
                                <RotateTransform Angle="45" />
                            </Border.RenderTransform>
                        </Border>

                        <TextBlock
                            Text="&#xE8A1;"
                            FontFamily="Segoe MDL2 Assets"
                            Foreground="{StaticResource GoldHoverBrush}"
                            FontSize="21"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center" />
                    </Grid>

                    <StackPanel
                        Margin="14,0,0,0"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="QUẦY BÁN HÀNG"
                            Foreground="{StaticResource GoldHoverBrush}"
                            FontFamily="Georgia"
                            FontSize="23"
                            FontWeight="SemiBold" />

                        <StackPanel
                            Orientation="Horizontal"
                            Margin="0,4,0,0">

                            <TextBlock
                                Text="POS ENTERPRISE"
                                Foreground="{StaticResource SidebarMutedBrush}"
                                FontSize="10"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="  ◆  "
                                Foreground="{StaticResource GoldBrush}"
                                FontSize="9.5" />

                            <TextBlock
                                Text="CASHIER TERMINAL"
                                Foreground="{StaticResource SidebarMutedBrush}"
                                FontSize="10"
                                FontWeight="SemiBold" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <Border
                        Padding="12,8"
                        Margin="0,0,10,0"
                        Background="{StaticResource SidebarSurfaceBrush}"
                        BorderBrush="#684D30"
                        BorderThickness="1"
                        CornerRadius="10">

                        <StackPanel>

                            <TextBlock
                                Text="{Binding CurrentCashierName}"
                                Foreground="{StaticResource SidebarTextBrush}"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                HorizontalAlignment="Right" />

                            <TextBlock
                                Text="{Binding CurrentRoleText}"
                                Foreground="{StaticResource GoldBrush}"
                                FontSize="10"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>

                    <Border
                        Padding="11,7"
                        Background="#221E1B"
                        BorderBrush="#4D433C"
                        BorderThickness="1"
                        CornerRadius="10">

                        <StackPanel>

                            <TextBlock
                                Text="F2 Quét mã · Ctrl+F Tìm sản phẩm · F4 Đủ tiền · F6 Tiền khách đưa · F8 Thanh toán"
                                Foreground="{StaticResource SidebarMutedBrush}"
                                FontSize="10" />

                            <TextBlock
                                Text="Esc Đóng quầy · Delete Xóa dòng"
                                Foreground="#9F958B"
                                FontSize="9.5"
                                Margin="0,2,0,0"
                                HorizontalAlignment="Right" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspace -->

        <Grid
            Grid.Row="1"
            Margin="12">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="520" />
            </Grid.ColumnDefinitions>

            <!-- Product catalog -->

            <Border
                Grid.Column="0"
                Style="{StaticResource CardStyle}"
                Padding="0"
                ClipToBounds="True">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Padding="18,13"
                        Background="{StaticResource SurfaceBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                        <Grid
                            x:Name="SalesCatalogHeaderGrid"
                            HorizontalAlignment="Stretch">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="230" />
                            </Grid.ColumnDefinitions>

                            <StackPanel
                                x:Name="SalesTitleBlock"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center">

                                <TextBlock
                                    Text="THỰC ĐƠN BÁN HÀNG"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    FontFamily="Georgia"
                                    FontSize="18" />

                                <TextBlock
                                    Text="{Binding ProductResultText}"
                                    Style="{StaticResource CaptionTextStyle}"
                                    FontSize="10.5"
                                    Margin="0,3,0,0" />
                            </StackPanel>

                            <Grid
                                x:Name="SalesSearchGroup"
                                Grid.Column="2"
                                MinWidth="280"
                                HorizontalAlignment="Stretch">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="44" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="TÌM SẢN PHẨM"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Bottom" />

                                <Grid Grid.Row="2">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="84" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>

                                        <TextBox
                                            x:Name="ProductSearchBox"
                                            KeyboardNavigation.TabIndex="1"
                                            Text="{Binding SearchTerm,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            Style="{StaticResource SalesSearchTextBoxStyle}" />

                                        <TextBlock
                                            Text="&#xE721;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Foreground="{StaticResource GoldBrush}"
                                            FontSize="14"
                                            Margin="15,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False" />

                                        <TextBlock
                                            Text="Tên, mã hoặc danh mục sản phẩm"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="10.5"
                                            Margin="42,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">

                                            <TextBlock.Style>

                                                <Style
                                                    TargetType="{x:Type TextBlock}">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Collapsed" />

                                                    <Style.Triggers>

                                                        <MultiDataTrigger>

                                                            <MultiDataTrigger.Conditions>

                                                                <Condition
                                                                    Binding="{Binding Text.Length,
                                                                        ElementName=ProductSearchBox}"
                                                                    Value="0" />

                                                                <Condition
                                                                    Binding="{Binding IsKeyboardFocusWithin,
                                                                        ElementName=ProductSearchBox}"
                                                                    Value="False" />
                                                            </MultiDataTrigger.Conditions>

                                                            <Setter
                                                                Property="Visibility"
                                                                Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>

                                    <Button
                                        x:Name="ProductSearchButton"
                                        Grid.Column="2"
                                        KeyboardNavigation.TabIndex="2"
                                        Command="{Binding SearchCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="44"
                                        Padding="12,0"
                                        Content="Tìm" />
                                </Grid>
                            </Grid>

                            <Grid
                                x:Name="SalesScanGroup"
                                Grid.Column="4"
                                MinWidth="230"
                                MaxWidth="300"
                                HorizontalAlignment="Stretch">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="5" />
                                    <RowDefinition Height="44" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="QUÉT MÃ"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    VerticalAlignment="Bottom" />

                                <Grid
                                    x:Name="SalesScanInput"
                                    Grid.Row="2"
                                    ToolTip="Không có máy quét? Nhập Barcode/ProductCode rồi nhấn Enter.">

                                    <TextBox
                                        x:Name="ProductScanBox"
                                        KeyboardNavigation.TabIndex="3"
                                        Text="{Binding ScanCode,
                                            UpdateSourceTrigger=PropertyChanged}"
                                        Style="{StaticResource SalesSearchTextBoxStyle}"
                                        Padding="43,0,13,0" />

                                    <Path
                                        x:Name="SalesScannerIcon"
                                        Width="18"
                                        Height="18"
                                        Margin="15,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Stretch="Uniform"
                                        Fill="{StaticResource GoldBrush}"
                                        Focusable="False"
                                        IsHitTestVisible="False"
                                        Data="M3,2 H17 A2,2 0 0 1 19,4 V11 H17 V4 H3 V8 H1 V4 A2,2 0 0 1 3,2 M4,5 H6 V12 H4 Z M7,5 H8 V12 H7 Z M9,5 H11 V12 H9 Z M12,5 H13 V12 H12 Z M14,5 H16 V12 H14 Z M6,14 H15 L13,22 H8 L9,18 H6 A2,2 0 0 1 4,16 A2,2 0 0 1 6,14 Z" />

                                    <TextBlock
                                        Text="Barcode hoặc mã sản phẩm"
                                        Foreground="{StaticResource TextMutedBrush}"
                                        FontSize="10.5"
                                        Margin="42,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding Text.Length, ElementName=ProductScanBox}" Value="0" />
                                                            <Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=ProductScanBox}" Value="False" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border
                        Grid.Row="1"
                        Padding="18,10"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,0,1">

                        <ScrollViewer
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Disabled">

                            <ItemsControl
                                ItemsSource="{Binding CategoryFilters}">

                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Button
                                            Content="{Binding Name}"
                                            Command="{Binding SelectCommand}"
                                            Style="{StaticResource SalesCategoryChipStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <Grid Grid.Row="2">

                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="18,15,8,12">

                            <ItemsControl
                                ItemsSource="{Binding ProductCards}"
                                IsEnabled="{Binding CanEditOrder}">

                                <ItemsControl.ItemsPanel>

                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemTemplate>

                                    <DataTemplate>

                                        <Button
                                            Command="{Binding AddToCartCommand}"
                                            IsEnabled="{Binding CanSell}"
                                            ToolTip="{Binding AvailabilityText}"
                                            ToolTipService.InitialShowDelay="220"
                                            Style="{StaticResource SalesProductCardStyle}">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid>

                                                    <Border
                                                        HorizontalAlignment="Left"
                                                        Padding="7,3"
                                                        Background="{StaticResource GoldSoftBrush}"
                                                        BorderBrush="{StaticResource GoldBorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="7">

                                                        <TextBlock
                                                            Text="{Binding CategoryName}"
                                                            Foreground="{StaticResource GoldBrush}"
                                                            FontSize="9.5"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis"
                                                            MaxWidth="105" />
                                                    </Border>

                                                    <Border
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Padding="6,3"
                                                        CornerRadius="7">

                                                        <Border.Style>

                                                            <Style
                                                                TargetType="{x:Type Border}">

                                                                <Setter
                                                                    Property="Background"
                                                                    Value="{StaticResource SuccessSoftBrush}" />

                                                                <Style.Triggers>

                                                                    <DataTrigger
                                                                        Binding="{Binding IsLowStock}"
                                                                        Value="True">

                                                                        <Setter
                                                                            Property="Background"
                                                                            Value="{StaticResource WarningSoftBrush}" />
                                                                    </DataTrigger>

                                                                    <DataTrigger
                                                                        Binding="{Binding CanSell}"
                                                                        Value="False">

                                                                        <Setter
                                                                            Property="Background"
                                                                            Value="{StaticResource DangerSoftBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <TextBlock
                                                            Text="{Binding AvailabilityText}"
                                                            FontSize="9.2"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center"
                                                            TextTrimming="CharacterEllipsis"
                                                            MaxWidth="74">

                                                            <TextBlock.Style>

                                                                <Style
                                                                    TargetType="{x:Type TextBlock}">

                                                                    <Setter
                                                                        Property="Foreground"
                                                                        Value="{StaticResource SuccessBrush}" />

                                                                    <Style.Triggers>

                                                                        <DataTrigger
                                                                            Binding="{Binding IsLowStock}"
                                                                            Value="True">

                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{StaticResource WarningBrush}" />
                                                                        </DataTrigger>

                                                                        <DataTrigger
                                                                            Binding="{Binding CanSell}"
                                                                            Value="False">

                                                                            <Setter
                                                                                Property="Foreground"
                                                                                Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </Grid>

                                                <Grid
                                                    Grid.Row="1"
                                                    Margin="0,9,0,6">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="58" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <Grid
                                                        Width="58"
                                                        Height="58">

                                                        <Rectangle
                                                            Width="58"
                                                            Height="58"
                                                            RadiusX="14"
                                                            RadiusY="14">

                                                            <Rectangle.Fill>

                                                                <ImageBrush
                                                                    ImageSource="{Binding ProductImage}"
                                                                    Stretch="UniformToFill" />
                                                            </Rectangle.Fill>

                                                            <Rectangle.Style>

                                                                <Style
                                                                    TargetType="{x:Type Rectangle}">

                                                                    <Setter
                                                                        Property="Visibility"
                                                                        Value="Collapsed" />

                                                                    <Style.Triggers>

                                                                        <DataTrigger
                                                                            Binding="{Binding HasProductImage}"
                                                                            Value="True">

                                                                            <Setter
                                                                                Property="Visibility"
                                                                                Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Rectangle.Style>
                                                        </Rectangle>

                                                        <Border
                                                            BorderBrush="{StaticResource AccentBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="14" />

                                                        <Border
                                                            Background="{StaticResource AccentSoftBrush}"
                                                            CornerRadius="14">

                                                            <Border.Style>

                                                                <Style
                                                                    TargetType="{x:Type Border}">

                                                                    <Setter
                                                                        Property="Visibility"
                                                                        Value="Visible" />

                                                                    <Style.Triggers>

                                                                        <DataTrigger
                                                                            Binding="{Binding HasProductImage}"
                                                                            Value="True">

                                                                            <Setter
                                                                                Property="Visibility"
                                                                                Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>

                                                            <TextBlock
                                                                Text="{Binding ProductInitial}"
                                                                FontFamily="Georgia"
                                                                Foreground="{StaticResource AccentBrush}"
                                                                FontSize="19"
                                                                FontWeight="Bold"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>
                                                    </Grid>

                                                    <StackPanel
                                                        Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">

                                                        <TextBlock
                                                            Text="{Binding Name}"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            FontSize="13"
                                                            FontWeight="SemiBold"
                                                            TextWrapping="Wrap"
                                                            TextTrimming="CharacterEllipsis"
                                                            MaxHeight="38" />

                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Margin="0,3,0,0">

                                                            <TextBlock
                                                                Text="{Binding Code}"
                                                                Foreground="{StaticResource GoldBrush}"
                                                                FontSize="9.5"
                                                                FontWeight="SemiBold" />

                                                            <TextBlock
                                                                Text="  •  "
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                FontSize="9.5" />

                                                            <TextBlock
                                                                Text="{Binding UnitName}"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                FontSize="9.5" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Grid>

                                                <Grid Grid.Row="2">

                                                    <StackPanel
                                                        VerticalAlignment="Bottom">

                                                        <TextBlock
                                                            Text="GIÁ BÁN"
                                                            Foreground="{StaticResource TextMutedBrush}"
                                                            FontSize="9.2"
                                                            FontWeight="SemiBold" />

                                                        <TextBlock
                                                            Text="{Binding SalePriceText}"
                                                            Foreground="{StaticResource AccentBrush}"
                                                            FontFamily="Georgia"
                                                            FontSize="16.5"
                                                            FontWeight="Bold"
                                                            Margin="0,1,0,0" />
                                                    </StackPanel>

                                                    <StackPanel
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Bottom"
                                                        Margin="0,0,0,1">

                                                        <TextBlock
                                                            Text="&#xE710;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Foreground="{StaticResource GoldBrush}"
                                                            FontSize="12"
                                                            Margin="0,0,3,0"
                                                            VerticalAlignment="Center" />

                                                        <TextBlock
                                                            Text="{Binding AddButtonText}"
                                                            Foreground="{StaticResource TextSecondaryBrush}"
                                                            FontSize="9.5"
                                                            FontWeight="SemiBold"
                                                            VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Empty catalog -->

                        <Border Background="{StaticResource SurfaceBrush}">

                            <Border.Style>

                                <Style TargetType="{x:Type Border}">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <MultiDataTrigger>

                                            <MultiDataTrigger.Conditions>

                                                <Condition
                                                    Binding="{Binding ProductCards.Count}"
                                                    Value="0" />

                                                <Condition
                                                    Binding="{Binding IsLoadingProducts}"
                                                    Value="False" />
                                            </MultiDataTrigger.Conditions>

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Border
                                    Width="62"
                                    Height="62"
                                    Background="{StaticResource GoldSoftBrush}"
                                    BorderBrush="{StaticResource GoldBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="18">

                                    <TextBlock
                                        Text="&#xE8A1;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="25"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <TextBlock
                                    Text="Không có món phù hợp"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0" />

                                <TextBlock
                                    Text="Thử đổi danh mục, từ khóa hoặc kiểm tra trạng thái sản phẩm."
                                    Style="{StaticResource SecondaryTextStyle}"
                                    FontSize="11"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center"
                                    Margin="0,5,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Loading catalog -->

                        <Border
                            Background="#E8FFFEFB"
                            Visibility="{Binding IsLoadingProducts,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                            <StackPanel
                                Width="270"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <ProgressBar
                                    Height="5"
                                    IsIndeterminate="True"
                                    Foreground="{StaticResource AccentBrush}" />

                                <TextBlock
                                    Text="Đang chuẩn bị thực đơn..."
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="11.5"
                                    HorizontalAlignment="Center"
                                    Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        Grid.Row="3"
                        Padding="18,8"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">

                        <Grid>

                            <TextBlock
                                Text="Giá hiển thị là tạm tính. Hệ thống xác nhận lại giá và tồn kho khi thanh toán."
                                Style="{StaticResource CaptionTextStyle}"
                                FontSize="10"
                                VerticalAlignment="Center" />

                            <StackPanel
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    Fill="{StaticResource SuccessBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,6,0" />

                                <TextBlock
                                    Text="Checkout transaction sẵn sàng"
                                    Foreground="{StaticResource SuccessBrush}"
                                    FontSize="10"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!-- Order panel -->

            <Border
                Grid.Column="2"
                Style="{StaticResource CardStyle}"
                Padding="0"
                ClipToBounds="True">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Order header -->

                    <Border
                        Padding="16,12"
                        Background="{StaticResource SidebarBrush}"
                        BorderBrush="#745630"
                        BorderThickness="0,0,0,1">

                        <Grid>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">

                                <Border
                                    Width="38"
                                    Height="38"
                                    Background="{StaticResource SidebarSurfaceBrush}"
                                    BorderBrush="{StaticResource GoldBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">

                                    <TextBlock
                                        Text="&#xE8A1;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="{StaticResource GoldHoverBrush}"
                                        FontSize="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Border>

                                <StackPanel
                                    Margin="11,0,0,0"
                                    VerticalAlignment="Center">

                                    <TextBlock
                                        Text="ĐƠN HÀNG HIỆN TẠI"
                                        Foreground="{StaticResource GoldHoverBrush}"
                                        FontFamily="Georgia"
                                        FontSize="17"
                                        FontWeight="SemiBold" />

                                    <StackPanel
                                        Orientation="Horizontal"
                                        Margin="0,2,0,0">

                                        <TextBlock
                                            Text="{Binding CartItemCountText}"
                                            Foreground="{StaticResource SidebarMutedBrush}"
                                            FontSize="10" />

                                        <TextBlock
                                            Text="  •  "
                                            Foreground="{StaticResource GoldBrush}"
                                            FontSize="9.5" />

                                        <TextBlock
                                            Text="{Binding CartLineCountText}"
                                            Foreground="{StaticResource SidebarMutedBrush}"
                                            FontSize="10" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Command="{Binding OpenHeldSalesCommand}"
                                        Content="{Binding ActiveHeldSaleCountText, StringFormat=Đơn đang giữ ({0})}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="36" Padding="10,0" Margin="0,0,6,0"/>
                                <Button Command="{Binding HoldSaleCommand}"
                                        Content="Giữ đơn"
                                        ToolTip="Giữ giỏ hiện tại để phục vụ khách tiếp theo"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="36" Padding="10,0" Margin="0,0,6,0"/>
                                <Button Command="{Binding ClearCartCommand}"
                                        Content="Làm trống"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Height="36" Padding="10,0"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Cart list: only this section scrolls -->

                    <Grid Grid.Row="1">

                        <ScrollViewer
                            VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled"
                            Padding="12,10">

                            <ListBox
                                x:Name="CartListBox"
                                ItemsSource="{Binding CartLines}"
                                SelectedItem="{Binding SelectedCartLine,
                                    Mode=TwoWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                IsEnabled="{Binding CanEditOrder}">

                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="{x:Type ListBoxItem}">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0" />
                                    </Style>
                                </ListBox.ItemContainerStyle>

                                <ListBox.ItemTemplate>

                                    <DataTemplate>

                                        <Border
                                            Margin="0,0,0,8"
                                            Padding="11"
                                            Background="{StaticResource SurfaceMutedBrush}"
                                            BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>

                                                <Grid>

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel>

                                                        <TextBlock
                                                            Text="{Binding ProductName}"
                                                            Foreground="{StaticResource TextPrimaryBrush}"
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            TextTrimming="CharacterEllipsis" />

                                                        <StackPanel
                                                            Orientation="Horizontal"
                                                            Margin="0,3,0,0">

                                                            <TextBlock
                                                                Text="{Binding ProductCode}"
                                                                Foreground="{StaticResource GoldBrush}"
                                                                FontSize="9.5"
                                                                FontWeight="SemiBold" />

                                                            <TextBlock
                                                                Text="  •  "
                                                                Foreground="{StaticResource TextMutedBrush}"
                                                                FontSize="9.5" />

                                                            <TextBlock
                                                                Text="{Binding UnitPriceText}"
                                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                                FontSize="9.5" />
                                                        </StackPanel>
                                                    </StackPanel>

                                                    <Button
                                                        Grid.Column="1"
                                                        Command="{Binding RemoveCommand}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Width="30"
                                                        Height="30"
                                                        MinWidth="30"
                                                        Padding="0"
                                                        Background="{StaticResource DangerSoftBrush}"
                                                        BorderBrush="#EDC3C6"
                                                        ToolTip="Xóa khỏi đơn">

                                                        <TextBlock
                                                            Text="&#xE74D;"
                                                            FontFamily="Segoe MDL2 Assets"
                                                            Foreground="{StaticResource DangerBrush}"
                                                            FontSize="11" />
                                                    </Button>
                                                </Grid>

                                                <Grid
                                                    Grid.Row="1"
                                                    Margin="0,8,0,0">

                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal">

                                                        <Button
                                                            Content="−"
                                                            Command="{Binding DecreaseCommand}"
                                                            Style="{StaticResource CartQuantityButtonStyle}" />

                                                        <Border
                                                            MinWidth="40"
                                                            Height="30"
                                                            Margin="5,0"
                                                            Background="{StaticResource SurfaceBrush}"
                                                            BorderBrush="{StaticResource BorderStrongBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="7">

                                                            <TextBlock
                                                                Text="{Binding QuantityText}"
                                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                                FontSize="11.5"
                                                                FontWeight="SemiBold"
                                                                HorizontalAlignment="Center"
                                                                VerticalAlignment="Center" />
                                                        </Border>

                                                        <Button
                                                            Content="+"
                                                            Command="{Binding IncreaseCommand}"
                                                            Style="{StaticResource CartQuantityButtonStyle}" />
                                                    </StackPanel>

                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding QuantityLimitText}"
                                                        Foreground="{StaticResource TextMutedBrush}"
                                                        FontSize="9.5"
                                                        Margin="9,0"
                                                        VerticalAlignment="Center" />

                                                    <TextBlock
                                                        Grid.Column="2"
                                                        Text="{Binding LineTotalText}"
                                                        Foreground="{StaticResource AccentBrush}"
                                                        FontFamily="Georgia"
                                                        FontSize="14.5"
                                                        FontWeight="Bold"
                                                        VerticalAlignment="Center" />
                                                </Grid>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </ScrollViewer>

                        <!-- Empty cart -->

                        <Border Background="{StaticResource SurfaceBrush}">

                            <Border.Style>

                                <Style TargetType="{x:Type Border}">

                                    <Setter
                                        Property="Visibility"
                                        Value="Collapsed" />

                                    <Style.Triggers>

                                        <DataTrigger
                                            Binding="{Binding CartLines.Count}"
                                            Value="0">

                                            <Setter
                                                Property="Visibility"
                                                Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <StackPanel
                                Width="300"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">

                                <Grid
                                    Width="66"
                                    Height="66"
                                    HorizontalAlignment="Center">

                                    <Ellipse
                                        Stroke="{StaticResource GoldBorderBrush}"
                                        StrokeThickness="1.2" />

                                    <TextBlock
                                        Text="&#xE8A1;"
                                        FontFamily="Segoe MDL2 Assets"
                                        Foreground="{StaticResource GoldBrush}"
                                        FontSize="27"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <TextBlock
                                    Text="Đơn hàng đang trống"
                                    Style="{StaticResource SectionTitleTextStyle}"
                                    FontSize="16"
                                    HorizontalAlignment="Center"
                                    Margin="0,12,0,0" />

                                <TextBlock
                                    Text="Chọn món bên trái hoặc quét barcode để bắt đầu bán hàng."
                                    Style="{StaticResource SecondaryTextStyle}"
                                    FontSize="11"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Locked VietQR order -->

                        <Border
                            Panel.ZIndex="50"
                            Background="#D9FFFEFB"
                            Visibility="{Binding IsOrderLocked,
                                Converter={StaticResource BooleanToVisibilityConverter}}">

                            <Border
                                Width="340"
                                Margin="14"
                                Padding="15"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{StaticResource SurfaceBrush}"
                                BorderBrush="{StaticResource GoldBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="13">

                                <StackPanel>

                                    <Border
                                        Width="44"
                                        Height="44"
                                        HorizontalAlignment="Center"
                                        Background="{StaticResource GoldSoftBrush}"
                                        BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="13">

                                        <TextBlock
                                            Text="&#xE72E;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Foreground="{StaticResource GoldBrush}"
                                            FontSize="19"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock
                                        Text="ĐƠN VIETQR ĐÃ KHÓA"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        FontFamily="Georgia"
                                        FontSize="14.5"
                                        FontWeight="SemiBold"
                                        TextAlignment="Center"
                                        Margin="0,10,0,0" />

                                    <TextBlock
                                        Text="Đã xác nhận nhận tiền. Không sửa món, số lượng hoặc tạo QR khác trước khi đơn được lưu xong."
                                        Foreground="{StaticResource TextSecondaryBrush}"
                                        FontSize="10"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap"
                                        LineHeight="16"
                                        Margin="4,6,4,0" />
                                </StackPanel>
                            </Border>
                        </Border>
                    </Grid>

                    <!-- Fixed payment area -->

                    <Border
                        Grid.Row="2"
                        Background="{StaticResource SurfaceMutedBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,1,0,0">

                        <Grid Margin="14,12,14,14">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Last completed order -->

                            <Border
                                Grid.Row="0"
                                Margin="0,0,0,9"
                                Padding="10"
                                Background="{StaticResource SuccessSoftBrush}"
                                BorderBrush="#B4DCC4"
                                BorderThickness="1"
                                CornerRadius="10"
                                Visibility="{Binding HasLastOrder,
                                    Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="34"
                                        Height="34"
                                        Background="#F7FFFA"
                                        BorderBrush="#A6D4B8"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="&#xE73E;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Foreground="{StaticResource SuccessBrush}"
                                            FontSize="16"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <StackPanel
                                        Grid.Column="1"
                                        Margin="9,0"
                                        VerticalAlignment="Center">

                                        <TextBlock
                                            Text="{Binding LastOrderCode}"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding LastOrderCode}" />

                                        <TextBlock
                                            Text="{Binding LastOrderSummary}"
                                            Foreground="{StaticResource TextSecondaryBrush}"
                                            FontSize="10"
                                            TextTrimming="CharacterEllipsis"
                                            Margin="0,2,0,0" />
                                    </StackPanel>

                                    <TextBlock
                                        Grid.Column="2"
                                        Text="ĐÃ XONG"
                                        Foreground="{StaticResource SuccessBrush}"
                                        FontSize="9.5"
                                        FontWeight="Bold"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <!-- Payment methods -->

                            <Grid Grid.Row="1">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    Command="{Binding SelectCashPaymentCommand}">

                                    <Button.Style>

                                        <Style
                                            TargetType="{x:Type Button}"
                                            BasedOn="{StaticResource PaymentMethodOptionButtonStyle}">

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding IsCashPaymentSelected}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Background"
                                                        Value="{StaticResource AccentSoftBrush}" />

                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="{StaticResource AccentBrush}" />

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource AccentBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="31"
                                            Height="31"
                                            Background="{StaticResource AccentSoftBrush}"
                                            BorderBrush="{StaticResource AccentBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                            <TextBlock
                                                Text="₫"
                                                Foreground="{StaticResource AccentBrush}"
                                                FontFamily="Georgia"
                                                FontSize="15"
                                                FontWeight="Bold"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="TIỀN MẶT"
                                                Foreground="{Binding
                                                    RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                    Path=Foreground}"
                                                FontSize="11"
                                                FontWeight="Bold" />

                                            <TextBlock
                                                Text="Thu và trả tiền"
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="9"
                                                Margin="0,1,0,0" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="&#xE73E;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Foreground="{StaticResource AccentBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsCashPaymentSelected,
                                                Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>

                                <Button
                                    Grid.Column="2"
                                    Command="{Binding SelectVietQrPaymentCommand}"
                                    ToolTip="{Binding PaymentMethodHintText}">

                                    <Button.Style>

                                        <Style
                                            TargetType="{x:Type Button}"
                                            BasedOn="{StaticResource PaymentMethodOptionButtonStyle}">

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding IsVietQrPaymentSelected}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Background"
                                                        Value="{StaticResource GoldSoftBrush}" />

                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="{StaticResource GoldBrush}" />

                                                    <Setter
                                                        Property="Foreground"
                                                        Value="{StaticResource GoldBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="31"
                                            Height="31"
                                            Background="{StaticResource GoldSoftBrush}"
                                            BorderBrush="{StaticResource GoldBorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="9">

                                            <TextBlock
                                                Text="&#xE8A1;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Foreground="{StaticResource GoldBrush}"
                                                FontSize="15"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            VerticalAlignment="Center">

                                            <TextBlock
                                                Text="VIETQR"
                                                Foreground="{Binding
                                                    RelativeSource={RelativeSource AncestorType={x:Type Button}},
                                                    Path=Foreground}"
                                                FontSize="11"
                                                FontWeight="Bold" />

                                            <TextBlock
                                                FontSize="9"
                                                Margin="0,1,0,0">

                                                <TextBlock.Style>

                                                    <Style
                                                        TargetType="{x:Type TextBlock}">

                                                        <Setter
                                                            Property="Text"
                                                            Value="Quét mã ngân hàng" />

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource TextMutedBrush}" />

                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding IsVietQrEnabled}"
                                                                Value="False">

                                                                <Setter
                                                                    Property="Text"
                                                                    Value="Chưa cấu hình" />

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource DangerBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            Text="&#xE73E;"
                                            FontFamily="Segoe MDL2 Assets"
                                            Foreground="{StaticResource GoldBrush}"
                                            FontSize="12"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsVietQrPaymentSelected,
                                                Converter={StaticResource BooleanToVisibilityConverter}}" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Row="2"
                                Text="{Binding PaymentMethodHintText}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                FontSize="10"
                                TextWrapping="Wrap"
                                Margin="1,6,1,0" />

                            <!-- Notes -->

                            <Grid
                                Grid.Row="3"
                                Margin="0,8,0,0">

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Text="Ghi chú đơn hàng"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Margin="1,0,0,4" />

                                <TextBlock
                                    Grid.Column="1"
                                    Text="{Binding OrderNotesLengthText}"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="9.5"
                                    Margin="0,0,1,4" />

                                <TextBox
                                    Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="{Binding OrderNotes,
                                        Mode=TwoWay,
                                        UpdateSourceTrigger=PropertyChanged}"
                                    IsEnabled="{Binding CanEditOrder}"
                                    Style="{StaticResource SearchTextBoxStyle}"
                                    Height="36"
                                    Padding="10,0"
                                    MaxLength="{Binding OrderNotesMaxLength}"
                                    FontSize="11.5"
                                    VerticalContentAlignment="Center"
                                    ToolTip="Ghi chú sẽ được lưu cùng đơn hàng." />
                            </Grid>

                            <!-- Total and payment detail -->

                            <Grid
                                Grid.Row="4"
                                Margin="0,9,0,0">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42*" />
                                    <ColumnDefinition Width="10" />
                                    <ColumnDefinition Width="58*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Grid.Column="0"
                                    Padding="13,11"
                                    Background="{StaticResource SidebarBrush}"
                                    BorderBrush="#745630"
                                    BorderThickness="1"
                                    CornerRadius="11">

                                    <Grid>

                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <StackPanel>

                                            <TextBlock
                                                Text="TỔNG THANH TOÁN"
                                                Foreground="{StaticResource SidebarMutedBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold" />

                                            <TextBlock
                                                Text="{Binding SelectedPaymentMethodText}"
                                                Foreground="#AAA097"
                                                FontSize="9.5"
                                                Margin="0,2,0,0" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Row="1"
                                            Text="{Binding EstimatedTotalText}"
                                            Foreground="{StaticResource GoldHoverBrush}"
                                            FontFamily="Georgia"
                                            FontSize="25"
                                            FontWeight="Bold"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Bottom"
                                            Margin="0,10,0,0" />
                                    </Grid>
                                </Border>

                                <!-- Cash -->

                                <Grid Grid.Column="2">

                                    <Grid.Style>

                                        <Style TargetType="{x:Type Grid}">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding IsCashPaymentSelected}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Orientation="Horizontal">

                                            <TextBlock
                                                Text="Tiền khách đưa"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                FontSize="10"
                                                FontWeight="SemiBold" />

                                            <TextBlock
                                                Text="  •  "
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="9.5" />

                                            <TextBlock
                                                Text="{Binding CashPreviewText}"
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                FontSize="9.5"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            Orientation="Horizontal">

                                            <TextBlock
                                                Text="Trả lại: "
                                                Foreground="{StaticResource TextMutedBrush}"
                                                FontSize="9.5" />

                                            <TextBlock
                                                Text="{Binding ChangePreviewText}"
                                                FontFamily="Georgia"
                                                FontSize="12"
                                                FontWeight="Bold">

                                                <TextBlock.Style>

                                                    <Style
                                                        TargetType="{x:Type TextBlock}">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource DangerBrush}" />

                                                        <Style.Triggers>

                                                            <DataTrigger
                                                                Binding="{Binding HasEnoughCash}"
                                                                Value="True">

                                                                <Setter
                                                                    Property="Foreground"
                                                                    Value="{StaticResource SuccessBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>

                                    <Grid
                                        Grid.Row="1"
                                        Margin="0,4,0,0">

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="CashReceivedTextBox"
                                            Text="{Binding CashReceivedText,
                                                Mode=TwoWay,
                                                UpdateSourceTrigger=PropertyChanged}"
                                            IsEnabled="{Binding IsCashInputEnabled}"
                                            PreviewTextInput="OnCashPreviewTextInput"
                                            TextChanged="OnCashTextChanged"
                                            InputMethod.IsInputMethodEnabled="False"
                                            Style="{StaticResource SearchTextBoxStyle}"
                                            Height="40"
                                            Padding="11,0"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            VerticalContentAlignment="Center"
                                            HorizontalContentAlignment="Left"
                                            MaxLength="24"
                                            ToolTip="Chỉ nhập chữ số. F6 để chuyển nhanh tới ô này." />

                                        <Button
                                            Grid.Column="2"
                                            Command="{Binding ExactCashCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="40"
                                            Padding="9,0"
                                            FontSize="10.5"
                                            Content="F4 • Tiền đủ" />
                                    </Grid>

                                    <UniformGrid
                                        Grid.Row="2"
                                        Columns="4"
                                        Margin="0,6,0,0">

                                        <Button
                                            Content="{Binding QuickCash1Text}"
                                            Command="{Binding QuickCash1Command}"
                                            Style="{StaticResource QuickCashButtonStyle}"
                                            Margin="0,0,3,0" />

                                        <Button
                                            Content="{Binding QuickCash2Text}"
                                            Command="{Binding QuickCash2Command}"
                                            Style="{StaticResource QuickCashButtonStyle}"
                                            Margin="2,0,2,0" />

                                        <Button
                                            Content="{Binding QuickCash3Text}"
                                            Command="{Binding QuickCash3Command}"
                                            Style="{StaticResource QuickCashButtonStyle}"
                                            Margin="2,0,2,0" />

                                        <Button
                                            Content="{Binding QuickCash4Text}"
                                            Command="{Binding QuickCash4Command}"
                                            Style="{StaticResource QuickCashButtonStyle}"
                                            Margin="3,0,0,0" />
                                    </UniformGrid>
                                </Grid>

                                <!-- VietQR -->

                                <Border
                                    Grid.Column="2"
                                    Padding="12"
                                    Background="{StaticResource GoldSoftBrush}"
                                    BorderBrush="{StaticResource GoldBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10">

                                    <Border.Style>

                                        <Style TargetType="{x:Type Border}">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                            <Style.Triggers>

                                                <DataTrigger
                                                    Binding="{Binding IsVietQrPaymentSelected}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="38" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border
                                            Width="34"
                                            Height="34"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="{StaticResource GoldBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            VerticalAlignment="Top">

                                            <TextBlock
                                                Text="&#xE8A1;"
                                                FontFamily="Segoe MDL2 Assets"
                                                Foreground="{StaticResource GoldBrush}"
                                                FontSize="16"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel
                                            Grid.Column="1"
                                            Margin="8,0,0,0">

                                            <TextBlock
                                                Text="THANH TOÁN VIETQR"
                                                Foreground="{StaticResource GoldBrush}"
                                                FontSize="10"
                                                FontWeight="Bold" />

                                            <TextBlock
                                                Text="F8 mở mã QR. Thu ngân chỉ xác nhận sau khi kiểm tra tiền thực tế đã vào tài khoản."
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                FontSize="10"
                                                TextWrapping="Wrap"
                                                LineHeight="15"
                                                Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Cash hint -->

                            <TextBlock
                                Grid.Row="5"
                                Text="{Binding CashHintText}"
                                FontSize="9.8"
                                TextWrapping="Wrap"
                                Margin="1,5,1,0">

                                <TextBlock.Style>

                                    <Style
                                        TargetType="{x:Type TextBlock}"
                                        BasedOn="{StaticResource CaptionTextStyle}">

                                        <Setter
                                            Property="Visibility"
                                            Value="Collapsed" />

                                        <Style.Triggers>

                                            <DataTrigger
                                                Binding="{Binding IsCashPaymentSelected}"
                                                Value="True">

                                                <Setter
                                                    Property="Visibility"
                                                    Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <!-- Pending and status -->

                            <StackPanel
                                Grid.Row="6"
                                Margin="0,7,0,0">

                                <Border
                                    Padding="11,9"
                                    Background="{StaticResource DangerSoftBrush}"
                                    BorderBrush="#E5B9BD"
                                    BorderThickness="1"
                                    CornerRadius="9"
                                    Visibility="{Binding HasPendingVietQrAuthorization,
                                        Converter={StaticResource BooleanToVisibilityConverter}}">

                                    <Grid>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel>

                                            <TextBlock
                                                Text="ĐÃ NHẬN TIỀN • ĐƠN CHƯA LƯU"
                                                Foreground="{StaticResource DangerBrush}"
                                                FontSize="10"
                                                FontWeight="Bold" />

                                            <TextBlock
                                                Text="{Binding PendingVietQrReferenceText}"
                                                Foreground="{StaticResource TextPrimaryBrush}"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Margin="0,3,0,0"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding PendingVietQrReferenceText}" />

                                            <TextBlock
                                                Text="Không tạo QR mới và không yêu cầu khách chuyển thêm."
                                                Foreground="{StaticResource TextSecondaryBrush}"
                                                FontSize="9.5"
                                                TextWrapping="Wrap"
                                                Margin="0,3,0,0" />
                                        </StackPanel>

                                        <Border
                                            Grid.Column="1"
                                            Padding="9,6"
                                            Margin="9,0,0,0"
                                            Background="{StaticResource SurfaceBrush}"
                                            BorderBrush="#E5B9BD"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            VerticalAlignment="Top">

                                            <TextBlock
                                                Text="{Binding PendingVietQrAmountText}"
                                                Foreground="{StaticResource DangerBrush}"
                                                FontFamily="Georgia"
                                                FontSize="13"
                                                FontWeight="Bold" />
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border
                                    Margin="0,6,0,0"
                                    Padding="10,8"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ToolTip="{Binding StatusMessage}">

                                    <Border.Style>

                                        <Style TargetType="{x:Type Border}">

                                            <Setter
                                                Property="Visibility"
                                                Value="Collapsed" />

                                            <Setter
                                                Property="Background"
                                                Value="{StaticResource GoldSoftBrush}" />

                                            <Setter
                                                Property="BorderBrush"
                                                Value="{StaticResource GoldBorderBrush}" />

                                            <Style.Triggers>

                                                <MultiDataTrigger>

                                                    <MultiDataTrigger.Conditions>

                                                        <Condition
                                                            Binding="{Binding HasStatusMessage}"
                                                            Value="True" />

                                                        <Condition
                                                            Binding="{Binding IsStatusSuccess}"
                                                            Value="False" />
                                                    </MultiDataTrigger.Conditions>

                                                    <Setter
                                                        Property="Visibility"
                                                        Value="Visible" />
                                                </MultiDataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding IsStatusError}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Background"
                                                        Value="{StaticResource DangerSoftBrush}" />

                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="#EAC0C3" />
                                                </DataTrigger>

                                                <DataTrigger
                                                    Binding="{Binding IsStatusSuccess}"
                                                    Value="True">

                                                    <Setter
                                                        Property="Background"
                                                        Value="{StaticResource SuccessSoftBrush}" />

                                                    <Setter
                                                        Property="BorderBrush"
                                                        Value="#BBDCC8" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <TextBlock
                                        Text="{Binding StatusMessage}"
                                        FontSize="10.2"
                                        TextWrapping="Wrap"
                                        MaxHeight="36"
                                        TextTrimming="CharacterEllipsis">

                                        <TextBlock.Style>

                                            <Style TargetType="{x:Type TextBlock}">

                                                <Setter
                                                    Property="Foreground"
                                                    Value="{StaticResource GoldBrush}" />

                                                <Style.Triggers>

                                                    <DataTrigger
                                                        Binding="{Binding IsStatusError}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>

                                                    <DataTrigger
                                                        Binding="{Binding IsStatusSuccess}"
                                                        Value="True">

                                                        <Setter
                                                            Property="Foreground"
                                                            Value="{StaticResource SuccessBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <!-- Checkout -->

                            <Button
                                Grid.Row="7"
                                Command="{Binding CheckoutCommand}"
                                Style="{StaticResource LuxuryCheckoutButtonStyle}"
                                Margin="0,9,0,0">

                                <Grid>

                                    <StackPanel
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Center">

                                        <TextBlock
                                            FontFamily="Segoe MDL2 Assets"
                                            FontSize="18"
                                            Margin="0,0,9,0"
                                            VerticalAlignment="Center">

                                            <TextBlock.Style>

                                                <Style
                                                    TargetType="{x:Type TextBlock}">

                                                    <Setter
                                                        Property="Text"
                                                        Value="&#xE8A1;" />

                                                    <Style.Triggers>

                                                        <DataTrigger
                                                            Binding="{Binding HasPendingVietQrAuthorization}"
                                                            Value="True">

                                                            <Setter
                                                                Property="Text"
                                                                Value="&#xE895;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <StackPanel>

                                            <TextBlock
                                                Text="{Binding CheckoutButtonTitle}"
                                                FontSize="13.5"
                                                FontWeight="SemiBold"
                                                HorizontalAlignment="Center" />

                                            <TextBlock
                                                Text="{Binding CheckoutButtonSubtitle}"
                                                FontSize="9.8"
                                                Foreground="#F5D9D9"
                                                Margin="0,2,0,0"
                                                HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>

                                    <ProgressBar
                                        Width="70"
                                        Height="4"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        IsIndeterminate="True"
                                        Foreground="White"
                                        Background="#40FFFFFF"
                                        Visibility="{Binding IsCheckingOut,
                                            Converter={StaticResource BooleanToVisibilityConverter}}" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Durable checkout recovery -->

        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="998"
            Background="{StaticResource AppBackgroundBrush}"
            Visibility="{Binding HasCheckoutRecovery,
                Mode=OneWay,
                Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border
                Width="720"
                MaxHeight="560"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource GoldBorderBrush}"
                BorderThickness="1"
                CornerRadius="16">

                <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <TextBlock
                            Text="KHÔI PHỤC GIAO DỊCH"
                            Foreground="{StaticResource GoldBrush}"
                            FontFamily="Georgia"
                            FontSize="19"
                            FontWeight="SemiBold" />

                        <TextBlock
                            Text="Hệ thống tìm thấy giao dịch cần xử lý từ phiên trước. Không tạo đơn mới cho đến khi bạn chọn hành động."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="11"
                            TextWrapping="Wrap"
                            Margin="0,6,0,0" />
                    </StackPanel>

                    <ComboBox
                        Grid.Row="1"
                        Margin="0,14,0,10"
                        ItemsSource="{Binding CheckoutRecoveries, Mode=OneWay}"
                        SelectedItem="{Binding SelectedRecovery, Mode=TwoWay}"
                        DisplayMemberPath="OrderDisplay"
                        MinHeight="36" />

                    <ScrollViewer
                        Grid.Row="2"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">

                        <StackPanel>

                            <TextBlock
                                Text="{Binding SelectedRecovery.StateTitle, Mode=OneWay}"
                                Foreground="{StaticResource TextPrimaryBrush}"
                                FontFamily="Georgia"
                                FontSize="17"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="{Binding SelectedRecovery.StateDescription, Mode=OneWay}"
                                Foreground="{StaticResource TextSecondaryBrush}"
                                TextWrapping="Wrap"
                                Margin="0,5,0,12" />

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock Text="Thời gian" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock
                                        Text="{Binding SelectedRecovery.CreatedAtText, Mode=OneWay}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Phương thức" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock
                                        Text="{Binding SelectedRecovery.PaymentMethodText, Mode=OneWay}"
                                        Foreground="{StaticResource TextPrimaryBrush}"
                                        Margin="0,3,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Tổng tiền" Style="{StaticResource CaptionTextStyle}" />
                                    <TextBlock
                                        Text="{Binding SelectedRecovery.TotalText, Mode=OneWay}"
                                        Foreground="{StaticResource AccentBrush}"
                                        FontWeight="Bold"
                                        Margin="0,3,0,0" />
                                </StackPanel>
                            </Grid>

                            <Border
                                Margin="0,14,0,0"
                                Padding="12"
                                Background="{StaticResource SurfaceMutedBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">

                                <TextBlock
                                    Text="{Binding SelectedRecovery.LineSummary, Mode=OneWay}"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Grid Grid.Row="3" Margin="0,18,0,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            Grid.Column="0"
                            Content="BỎ GIAO DỊCH"
                            Command="{Binding AbandonRecoveryCommand}"
                            MinHeight="40" />

                        <Button
                            Grid.Column="2"
                            Content="MỞ HÓA ĐƠN"
                            Command="{Binding OpenRecoveryReceiptCommand}"
                            MinHeight="40" />

                        <StackPanel Grid.Column="4">

                            <Button
                                Content="THỬ LẠI"
                                Command="{Binding RetryRecoveryCommand}"
                                MinHeight="40" />

                            <Button
                                Content="ĐÃ XEM"
                                Command="{Binding AcknowledgeRecoveryCommand}"
                                MinHeight="40"
                                Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <!-- Checkout transaction lock -->

        <Border
            Grid.RowSpan="2"
            Panel.ZIndex="999"
            Background="#C7F7F2EA"
            Visibility="{Binding IsCheckingOut,
                Converter={StaticResource BooleanToVisibilityConverter}}">

            <Border
                Width="390"
                Padding="28"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource GoldBorderBrush}"
                BorderThickness="1"
                CornerRadius="18">

                <Border.Effect>

                    <DropShadowEffect
                        Color="#332015"
                        BlurRadius="28"
                        ShadowDepth="4"
                        Direction="270"
                        Opacity="0.24" />
                </Border.Effect>

                <StackPanel>

                    <Grid
                        Width="72"
                        Height="72"
                        HorizontalAlignment="Center">

                        <Ellipse
                            Stroke="{StaticResource GoldBorderBrush}"
                            StrokeThickness="1.5" />

                        <Border
                            Width="47"
                            Height="47"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{StaticResource GoldSoftBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            CornerRadius="14">

                            <TextBlock
                                Text="&#xE8A1;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource GoldBrush}"
                                FontSize="24"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Border>
                    </Grid>

                    <TextBlock
                        Text="ĐANG XỬ LÝ THANH TOÁN"
                        Foreground="{StaticResource TextPrimaryBrush}"
                        FontFamily="Georgia"
                        FontSize="18"
                        FontWeight="SemiBold"
                        TextAlignment="Center"
                        Margin="0,18,0,0" />

                    <TextBlock
                        Text="Hệ thống đang xác thực phương thức thanh toán, giá, tồn kho và lưu đơn trong một transaction an toàn."
                        Foreground="{StaticResource TextSecondaryBrush}"
                        FontSize="11"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        LineHeight="18"
                        Margin="12,9,12,0" />

                    <ProgressBar
                        Height="6"
                        Margin="18,20,18,0"
                        IsIndeterminate="True"
                        Foreground="{StaticResource AccentBrush}"
                        Background="{StaticResource AccentSoftBrush}" />

                    <TextBlock
                        Text="Không đóng ứng dụng hoặc thao tác thêm trong lúc này."
                        Foreground="{StaticResource TextMutedBrush}"
                        FontSize="10.5"
                        TextAlignment="Center"
                        Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
