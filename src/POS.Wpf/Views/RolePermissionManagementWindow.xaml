<Window x:Class="POS.Wpf.Views.RolePermissionManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vai trò và quyền hạn" Width="1080" Height="700" MinWidth="860" MinHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
        Background="{StaticResource AppBackgroundBrush}" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        AutomationProperties.AutomationId="RolePermissionManagementWindow">
    <Grid Margin="26,22,26,24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Vai trò và quyền hạn" Style="{StaticResource PageTitleTextStyle}" FontSize="27"/>
                <TextBlock Text="Xem các vai trò hệ thống và quyền hiệu lực trong POS Enterprise." Style="{StaticResource SecondaryTextStyle}" Margin="0,5,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="{Binding IsStatusVisible, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            </StackPanel>
            <Button Content="↻  Làm mới" HorizontalAlignment="Right" VerticalAlignment="Center" MinWidth="112" Style="{StaticResource SecondaryButtonStyle}" Command="{Binding RefreshCommand}" AutomationProperties.AutomationId="RolePermissionRefreshButton"/>
        </Grid>
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14" Margin="0,20,0,16">
            <TextBlock Text="Các vai trò hệ thống được giữ ổn định để bảo vệ quyền truy cập. Gán vai trò thực hiện tại màn hình Nhân viên và tài khoản." Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"/>
        </Border>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="Vai trò" Style="{StaticResource SectionTitleTextStyle}" Margin="16,16,16,10"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole, Mode=TwoWay}" BorderThickness="0" Background="Transparent" AutomationProperties.AutomationId="RolePermissionRoleList">
                        <ListBox.ItemTemplate><DataTemplate>
                            <Border Padding="14,12" Margin="6,2" CornerRadius="8">
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="14"/>
                                    <TextBlock Text="{Binding BuiltInText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,3,0,0"/>
                                    <TextBlock Text="{Binding AccountUsageText}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel DataContext="{Binding SelectedRole}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="{Binding DisplayName}" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BuiltInText}" Style="{StaticResource SecondaryTextStyle}" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border HorizontalAlignment="Right" Padding="10,5" CornerRadius="10" Background="{StaticResource InfoSoftBrush}"><TextBlock Text="{Binding AccountUsageText}" Style="{StaticResource SecondaryTextStyle}"/></Border>
                        </Grid>
                        <TextBlock Text="{Binding ProtectionText}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,12,0,16"/>
                        <TextBlock Text="Quyền hiệu lực" Style="{StaticResource SectionTitleTextStyle}"/>
                        <ItemsControl ItemsSource="{Binding Permissions}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate><DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,9">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="✓" Foreground="{StaticResource SuccessBrush}" FontWeight="Bold"/>
                                        <StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Description}" Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" FontSize="11"/></StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding BusinessArea}" Style="{StaticResource SecondaryTextStyle}" FontSize="11" Margin="10,0,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Không có quyền nguy hiểm mặc định." Style="{StaticResource SecondaryTextStyle}" Margin="0,16,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
