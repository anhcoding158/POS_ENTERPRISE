<Window x:Class="POS.Wpf.Views.HeldSalesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Đơn đang giữ" Width="940" Height="610"
        MinWidth="760" MinHeight="480" MaxWidth="1200" MaxHeight="720"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="ĐƠN ĐANG GIỮ" Style="{StaticResource PageTitleTextStyle}"/>
        <TextBox Grid.Row="1" Margin="0,14,0,10" Padding="9,6" MaxWidth="360"
                 HorizontalAlignment="Left" Width="360"
                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Tìm theo mã, nhãn hoặc ghi chú"/>
        <DataGrid Grid.Row="2" ItemsSource="{Binding FilteredItems, Mode=OneWay}"
                  SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" HorizontalScrollBarVisibility="Disabled">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Mã" Binding="{Binding DisplayCode, Mode=OneWay}"/>
                <DataGridTextColumn Header="Nhãn" Binding="{Binding Label, Mode=OneWay}" Width="*"/>
                <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAtText, Mode=OneWay}"/>
                <DataGridTextColumn Header="Thu ngân" Binding="{Binding CreatedBy, Mode=OneWay}"/>
                <DataGridTextColumn Header="Dòng" Binding="{Binding LineCount, Mode=OneWay}"/>
                <DataGridTextColumn Header="SL" Binding="{Binding TotalQuantity, Mode=OneWay}"/>
                <DataGridTextColumn Header="Tổng giữ" Binding="{Binding TotalText, Mode=OneWay}"/>
                <DataGridTextColumn Header="Ghi chú" Binding="{Binding NotesPreview, Mode=OneWay}" Width="1.2*"/>
            </DataGrid.Columns>
        </DataGrid>
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Width="130" Content="Hủy đơn giữ" Click="OnCancelHeld"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Width="90" Margin="0,0,10,0" Content="Đóng" IsCancel="True"/>
                <Button Width="110" Content="Mở lại" IsDefault="True" Click="OnResume"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
