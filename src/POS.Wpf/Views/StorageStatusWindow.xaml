<Window x:Class="POS.Wpf.Views.StorageStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Trạng thái dung lượng"
        Width="560" Height="520" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Trạng thái dung lượng" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding StatusText}" FontSize="17" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap" />
            <TextBlock Text="{Binding GuidanceText}" Margin="0,8,0,0"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ProgressBar Grid.Row="1" Height="4" Margin="0,18,0,0"
                     IsIndeterminate="True" Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Grid Grid.Row="2" Margin="0,22,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Dung lượng database chính" Margin="0,8" />
            <TextBlock Grid.Column="1" Text="{Binding MainDatabaseSizeText}" FontWeight="SemiBold" Margin="18,8,0,8" />
            <TextBlock Grid.Row="1" Text="Tổng dung lượng SQLite đang sử dụng" Margin="0,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SqliteFootprintText}" FontWeight="SemiBold" Margin="18,8,0,8" />
            <TextBlock Grid.Row="2" Text="Dung lượng ổ đĩa còn trống" Margin="0,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding AvailableFreeText}" FontWeight="SemiBold" Margin="18,8,0,8" />
            <TextBlock Grid.Row="3" Text="Kiểm tra gần nhất" Margin="0,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding LastCheckedText}" FontWeight="SemiBold" Margin="18,8,0,8" />
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Làm mới" Command="{Binding RefreshCommand}" MinWidth="110" Margin="0,0,10,0" />
            <Button Content="Đóng" IsCancel="True" MinWidth="90" Click="OnCloseClick" />
        </StackPanel>
    </Grid>
</Window>
