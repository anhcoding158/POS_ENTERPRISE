<Window x:Class="POS.Wpf.Views.PaymentIntentManualResolutionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Xử lý thủ công VietQR" Width="560" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource AppBackgroundBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="XỬ LÝ THỦ CÔNG VIETQR" FontSize="20" FontWeight="Bold"/>
            <TextBlock Margin="0,8,0,16" TextWrapping="Wrap"
                       Text="Chỉ Quản trị viên được thực hiện. Thao tác tạo bản ghi audit bất biến; không tự tạo hóa đơn, tồn kho hoặc giao dịch ngân hàng."/>
        </StackPanel>
        <ComboBox x:Name="ResolutionTypeInput" Grid.Row="1" SelectedIndex="0" Margin="0,0,0,12"
                  SelectionChanged="OnResolutionTypeChanged">
            <ComboBoxItem Tag="2" Content="Không phát sinh tiền thật / giao dịch thử nghiệm"/>
            <ComboBoxItem Tag="3" Content="Đã hoàn tiền bên ngoài POS"/>
            <ComboBoxItem Tag="1" Content="Liên kết hóa đơn đã tồn tại"/>
        </ComboBox>
        <TextBox x:Name="ReasonInput" Grid.Row="2" MinHeight="70" TextWrapping="Wrap"
                 AcceptsReturn="True" Margin="0,0,0,12"
                 AutomationProperties.Name="Lý do xử lý"/>
        <StackPanel Grid.Row="3">
            <TextBox x:Name="ExternalReferenceInput" Margin="0,0,0,12"
                     AutomationProperties.Name="Mã hoặc ghi chú hoàn tiền ngoài POS"/>
            <TextBox x:Name="LinkedOrderIdInput" Margin="0,0,0,12"
                     AutomationProperties.Name="ID hóa đơn chính xác"/>
        </StackPanel>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="HỦY" IsCancel="True" Margin="0,0,8,0" Padding="18,8"/>
            <Button Content="XÁC NHẬN" Click="OnConfirmClick" Padding="18,8"/>
        </StackPanel>
    </Grid>
</Window>
