<Window
    x:Class="POS.Wpf.Views.VietQrCustomerDisplayWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Language="vi-VN"
    Title="POS Enterprise - Màn hình khách hàng VietQR"
    Width="1280"
    Height="760"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    ShowActivated="False"
    Topmost="True"
    Focusable="False"
    Background="{StaticResource SidebarBrush}"
    FontFamily="Segoe UI"
    FontSize="12"
    TextOptions.TextFormattingMode="Display"
    TextOptions.TextRenderingMode="ClearType"
    UseLayoutRounding="True"
    SnapsToDevicePixels="True">

    <Grid IsHitTestVisible="False">

        <Grid.Background>

            <LinearGradientBrush
                StartPoint="0,0"
                EndPoint="1,1">

                <GradientStop
                    Color="#181513"
                    Offset="0" />

                <GradientStop
                    Color="#2D211B"
                    Offset="0.56" />

                <GradientStop
                    Color="#4A1015"
                    Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!--
            Viewbox giúp giao diện tự co giãn theo:
            - màn phụ phổ thông 1920 x 1080;
            - màn khách kích thước nhỏ;
            - Windows Scale 100% hoặc 125%.
        -->

        <Viewbox
            Stretch="Uniform"
            StretchDirection="Both"
            Margin="38">

            <Grid
                Width="1280"
                Height="760">

                <Grid.RowDefinitions>
                    <RowDefinition Height="92" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="58" />
                </Grid.RowDefinitions>

                <!-- Header -->

                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                        <Grid
                            Width="66"
                            Height="66">

                            <Ellipse
                                Stroke="{StaticResource GoldBrush}"
                                StrokeThickness="1.5" />

                            <Border
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="{StaticResource GoldHoverBrush}"
                                BorderThickness="1.2"
                                CornerRadius="7"
                                RenderTransformOrigin="0.5,0.5">

                                <Border.RenderTransform>
                                    <RotateTransform Angle="45" />
                                </Border.RenderTransform>
                            </Border>

                            <TextBlock
                                Text="QR"
                                Foreground="{StaticResource GoldHoverBrush}"
                                FontFamily="Georgia"
                                FontSize="17"
                                FontWeight="Bold"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel
                            Margin="17,0,0,0"
                            VerticalAlignment="Center">

                            <TextBlock
                                Text="POS ENTERPRISE"
                                Foreground="{StaticResource GoldHoverBrush}"
                                FontFamily="Georgia"
                                FontSize="28"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="THANH TOÁN NHANH • AN TOÀN • TIỆN LỢI"
                                Foreground="{StaticResource SidebarMutedBrush}"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Margin="0,5,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border
                        Grid.Column="1"
                        Padding="18,11"
                        Background="#3B1719"
                        BorderBrush="#8B3A3E"
                        BorderThickness="1"
                        CornerRadius="12"
                        VerticalAlignment="Center">

                        <StackPanel Orientation="Horizontal">

                            <Ellipse
                                Width="9"
                                Height="9"
                                Fill="#F0B34F"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center" />

                            <TextBlock
                                Text="ĐANG CHỜ THANH TOÁN"
                                Foreground="#FFE2A8"
                                FontSize="12"
                                FontWeight="Bold"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Main -->

                <Grid Grid.Row="1">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="520" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- QR card -->

                    <Border
                        Grid.Column="0"
                        Padding="25"
                        Background="White"
                        BorderBrush="#E7D7C0"
                        BorderThickness="1"
                        CornerRadius="26">

                        <Border.Effect>

                            <DropShadowEffect
                                Color="#100A07"
                                BlurRadius="30"
                                ShadowDepth="5"
                                Direction="270"
                                Opacity="0.30" />
                        </Border.Effect>

                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel>

                                <TextBlock
                                    Text="QUÉT MÃ VIETQR"
                                    Foreground="{StaticResource TextPrimaryBrush}"
                                    FontFamily="Georgia"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    HorizontalAlignment="Center" />

                                <TextBlock
                                    Text="Mở ứng dụng ngân hàng và quét mã bên dưới"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="11.5"
                                    HorizontalAlignment="Center"
                                    Margin="0,6,0,0" />
                            </StackPanel>

                            <Border
                                Grid.Row="1"
                                Width="420"
                                Height="420"
                                Margin="0,19"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="White"
                                BorderBrush="#D8CDBE"
                                BorderThickness="1"
                                CornerRadius="19"
                                Padding="17">

                                <Border.Effect>

                                    <DropShadowEffect
                                        Color="#4B3327"
                                        BlurRadius="17"
                                        ShadowDepth="2"
                                        Direction="270"
                                        Opacity="0.11" />
                                </Border.Effect>

                                <Image
                                    x:Name="QrImage"
                                    Stretch="Uniform"
                                    RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            </Border>

                            <StackPanel Grid.Row="2">

                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Center">

                                    <Ellipse
                                        Width="8"
                                        Height="8"
                                        Fill="{StaticResource SuccessBrush}"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center" />

                                    <TextBlock
                                        Text="Mã đã chứa đúng số tiền và nội dung chuyển khoản"
                                        Foreground="{StaticResource SuccessBrush}"
                                        FontSize="10.5"
                                        FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Payment information -->

                    <Grid Grid.Column="2">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel>

                            <TextBlock
                                Text="THANH TOÁN VIETQR"
                                Foreground="{StaticResource GoldHoverBrush}"
                                FontFamily="Georgia"
                                FontSize="39"
                                FontWeight="SemiBold" />

                            <TextBlock
                                Text="Vui lòng quét mã và kiểm tra chính xác người nhận trước khi chuyển khoản."
                                Foreground="#D6CAC0"
                                FontSize="15"
                                TextWrapping="Wrap"
                                LineHeight="23"
                                Margin="0,10,24,0" />
                        </StackPanel>

                        <!-- Amount -->

                        <Border
                            Grid.Row="1"
                            Margin="0,24,0,0"
                            Padding="24,20"
                            Background="#3A1719"
                            BorderBrush="#8C343A"
                            BorderThickness="1"
                            CornerRadius="18">

                            <StackPanel>

                                <TextBlock
                                    Text="SỐ TIỀN CẦN THANH TOÁN"
                                    Foreground="#D5B9B7"
                                    FontSize="12"
                                    FontWeight="SemiBold" />

                                <TextBlock
                                    x:Name="AmountText"
                                    Text="0 ₫"
                                    Foreground="#FFE2A8"
                                    FontFamily="Georgia"
                                    FontSize="48"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Recipient information -->

                        <Grid
                            Grid.Row="2"
                            Margin="0,14,0,0">

                            <Border
                                x:Name="CustomerRecipientDetailsPanel"
                                Visibility="Collapsed"
                                Padding="20,15"
                                Background="#FFF8E8"
                                BorderBrush="#E3C681"
                                BorderThickness="1"
                                CornerRadius="17">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="22" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel>

                                        <TextBlock
                                            Text="NGÂN HÀNG"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="14"
                                            FontWeight="Bold" />

                                        <TextBlock
                                            x:Name="CustomerBankNameText"
                                            Text="—"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            FontSize="21"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Margin="0,5,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">

                                        <TextBlock
                                            Text="CHỦ TÀI KHOẢN"
                                            Foreground="{StaticResource TextMutedBrush}"
                                            FontSize="14"
                                            FontWeight="Bold" />

                                        <TextBlock
                                            x:Name="CustomerAccountNameText"
                                            Text="—"
                                            Foreground="{StaticResource TextPrimaryBrush}"
                                            FontSize="21"
                                            FontWeight="SemiBold"
                                            TextWrapping="Wrap"
                                            Margin="0,5,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border
                                x:Name="CustomerRecipientMessagePanel"
                                Visibility="Collapsed"
                                Padding="18,14"
                                Background="#FFF8E8"
                                BorderBrush="#E3C681"
                                BorderThickness="1"
                                CornerRadius="17">

                                <TextBlock
                                    x:Name="CustomerRecipientMessageText"
                                    Text="Thông tin người nhận chưa khả dụng."
                                    Foreground="#8A672D"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>

                        <!-- Transfer content -->

                        <Border
                            Grid.Row="3"
                            Margin="0,14,0,0"
                            Padding="22,15"
                            Background="#FFFEFB"
                            BorderBrush="#E4D6C3"
                            BorderThickness="1"
                            CornerRadius="17">

                            <StackPanel>

                                <TextBlock
                                    Text="NỘI DUNG CHUYỂN KHOẢN"
                                    Foreground="{StaticResource TextMutedBrush}"
                                    FontSize="11"
                                    FontWeight="Bold" />

                                <TextBlock
                                    x:Name="TransferContentText"
                                    Text="—"
                                    Foreground="{StaticResource AccentBrush}"
                                    FontFamily="Consolas"
                                    FontSize="22"
                                    FontWeight="Bold"
                                    TextWrapping="Wrap"
                                    Margin="0,8,0,0" />

                                <TextBlock
                                    x:Name="PaymentCodeText"
                                    Text="Mã thanh toán: —"
                                    Foreground="{StaticResource TextSecondaryBrush}"
                                    FontSize="11.5"
                                    Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Guidance -->

                        <Border
                            Grid.Row="4"
                            Margin="0,14,0,0"
                            Padding="20"
                            Background="#2A2420"
                            BorderBrush="#6B5743"
                            BorderThickness="1"
                            CornerRadius="17"
                            VerticalAlignment="Stretch">

                            <Grid>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock
                                    Text="TRƯỚC KHI CHUYỂN KHOẢN"
                                    Foreground="{StaticResource GoldHoverBrush}"
                                    FontSize="12"
                                    FontWeight="Bold" />

                                <Grid
                                    Grid.Row="1"
                                    Margin="0,14,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="34"
                                        Height="34"
                                        Background="#3D3129"
                                        BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="17"
                                        VerticalAlignment="Top">

                                        <TextBlock
                                            Text="1"
                                            Foreground="{StaticResource GoldHoverBrush}"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="Kiểm tra đúng tên người nhận trên ứng dụng ngân hàng."
                                        Foreground="#EEE4DA"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </Grid>

                                <Grid
                                    Grid.Row="2"
                                    Margin="0,13,0,0">

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border
                                        Width="34"
                                        Height="34"
                                        Background="#3D3129"
                                        BorderBrush="{StaticResource GoldBrush}"
                                        BorderThickness="1"
                                        CornerRadius="17"
                                        VerticalAlignment="Top">

                                        <TextBlock
                                            Text="2"
                                            Foreground="{StaticResource GoldHoverBrush}"
                                            FontWeight="Bold"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                    </Border>

                                    <TextBlock
                                        Grid.Column="1"
                                        Text="Không tự sửa số tiền hoặc nội dung chuyển khoản đã được điền."
                                        Foreground="#EEE4DA"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Footer -->

                <Grid Grid.Row="2">

                    <TextBlock
                        Text="Thu ngân sẽ xác nhận sau khi cửa hàng nhận đủ tiền."
                        Foreground="{StaticResource SidebarMutedBrush}"
                        FontSize="11.5"
                        VerticalAlignment="Center" />

                    <StackPanel
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                        <TextBlock
                            Text="Bảo mật bởi"
                            Foreground="#9E9187"
                            FontSize="10.5"
                            Margin="0,0,6,0" />

                        <TextBlock
                            Text="VIETQR"
                            Foreground="{StaticResource GoldHoverBrush}"
                            FontFamily="Georgia"
                            FontSize="13"
                            FontWeight="Bold" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Viewbox>

        <!-- Trạng thái sau khi thu ngân xác nhận tiền đã vào -->

        <Border
            x:Name="SuccessOverlay"
            Panel.ZIndex="100"
            Visibility="Collapsed"
            Background="#F2181513">

            <Viewbox
                Stretch="Uniform"
                Margin="80">

                <Border
                    Width="880"
                    Padding="65"
                    Background="#FFFEFB"
                    BorderBrush="#D8BF85"
                    BorderThickness="2"
                    CornerRadius="34">

                    <Border.Effect>

                        <DropShadowEffect
                            Color="#000000"
                            BlurRadius="45"
                            ShadowDepth="6"
                            Direction="270"
                            Opacity="0.38" />
                    </Border.Effect>

                    <StackPanel>

                        <Grid
                            Width="120"
                            Height="120"
                            HorizontalAlignment="Center">

                            <Ellipse
                                Fill="{StaticResource SuccessSoftBrush}"
                                Stroke="{StaticResource SuccessBrush}"
                                StrokeThickness="2" />

                            <TextBlock
                                Text="&#xE73E;"
                                FontFamily="Segoe MDL2 Assets"
                                Foreground="{StaticResource SuccessBrush}"
                                FontSize="53"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock
                            Text="ĐÃ NHẬN THANH TOÁN"
                            Foreground="{StaticResource TextPrimaryBrush}"
                            FontFamily="Georgia"
                            FontSize="44"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            Margin="0,31,0,0" />

                        <TextBlock
                            x:Name="SuccessAmountText"
                            Text="0 ₫"
                            Foreground="{StaticResource AccentBrush}"
                            FontFamily="Georgia"
                            FontSize="51"
                            FontWeight="Bold"
                            TextAlignment="Center"
                            Margin="0,16,0,0" />

                        <TextBlock
                            Text="Cảm ơn quý khách"
                            Foreground="{StaticResource GoldBrush}"
                            FontFamily="Georgia"
                            FontSize="28"
                            FontWeight="SemiBold"
                            TextAlignment="Center"
                            Margin="0,25,0,0" />

                        <TextBlock
                            Text="Thu ngân đang hoàn tất và lưu đơn hàng."
                            Foreground="{StaticResource TextSecondaryBrush}"
                            FontSize="16"
                            TextAlignment="Center"
                            Margin="0,10,0,0" />
                    </StackPanel>
                </Border>
            </Viewbox>
        </Border>
    </Grid>
</Window>