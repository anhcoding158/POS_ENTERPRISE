                    </Border>

                    <ControlTemplate.Triggers>

                        <Trigger
                            Property="IsMouseOver"
                            Value="True">

                            <Setter
                                TargetName="NavigationBorder"
                                Property="Background"
                                Value="{StaticResource SidebarSelectedHoverBrush}" />
                        </Trigger>

                        <Trigger
                            Property="IsKeyboardFocused"
                            Value="True">

                            <Setter
                                TargetName="NavigationBorder"
                                Property="BorderBrush"
